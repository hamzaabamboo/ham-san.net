    },
    "text": {
      "type": "text"
    },
    "authorUserName": {
      "type": "string",
      "required": true
    },
    "authorName": {
      "type": "string"
    },
    "hashtags": {
      "type": "json"
    },
    "mentions": {
      "type": "json"
    },
    "media": {
      "type": "json"
    }
  }
}
