---
import { toKebabCase } from 'utils/kebab-case';
import { Box, Container, Flex, Grid, Stack, Wrap } from 'styled-system/jsx';
import { TagBadge } from '~/components/tags/TagBadge';
import { Heading } from '~/components/ui/heading';
import { Link } from '~/components/ui/link';
import { Text } from '~/components/ui/text';
import { graphQLSdk } from '~/graphql';
import { withLastGood } from '~/utils/cms-cache';
import { Enum_Tag_Type } from '~/graphql/generated/client';
import { useTranslations, validateLocale } from '~/i18n/utils';
import MainLayout from '~/layouts/MainLayout.astro';
import PageMasthead from '~/components/common/PageMasthead.astro';
import { sortTags, tagSlug } from '~/utils/tags';

export const prerender = false;

const { locale } = Astro.params;

if (!validateLocale(locale)) {
  return Astro.redirect('/404');
}

const t = useTranslations(locale);

let tags: any[] = [];
let tagsUnavailable = false;

try {
  // Tags are taxonomy, not translated prose: the ja entities carry no `projects` or
  // `experiences` relations, so localising this query gave /ja four chips all reading (0)
  // against 33 with real counts on en and th — while /ja/tags/<slug> and /ja/projects
  // showed the real data, contradicting it. The inventory and its counts come from one
  // locale; only the group headings are translated.
  const data = await withLastGood('about:en', () => graphQLSdk.fetchAboutMe({ locale: 'en' }));
  tags = sortTags(
    (data.tags ?? []).filter(
      (tag: any): tag is NonNullable<(typeof data.tags)[number]> =>
        !!tag?.slug && !!tag?.title && tag.type !== Enum_Tag_Type.NonDev
    )
  );
} catch {
  tagsUnavailable = true;
}

if (tagsUnavailable) {
  Astro.response.status = 503;
  Astro.response.headers.set('CDN-Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('CDN-Cache-Control', 'public, max-age=86400, must-revalidate');
}

// Only the one group large enough to need the full width. Programming languages is five
// chips — spanning 1120px alone, it broke the pairing rhythm one row before it started.
const PRIMARY_TYPES = [Enum_Tag_Type.Frontend];

const primaryTags = tags.filter((tag) => PRIMARY_TYPES.includes(tag.type as Enum_Tag_Type));
const secondaryTags = tags.filter((tag) => !PRIMARY_TYPES.includes(tag.type as Enum_Tag_Type));

const groupByType = (list: typeof tags) =>
  list.reduce<Record<string, typeof tags>>((acc, tag) => {
    const type = String(tag.type ?? 'Others');
    if (!acc[type]) acc[type] = [];
    acc[type].push(tag);
    return acc;
  }, {});

const primaryGroups = groupByType(primaryTags);
const secondaryGroups = groupByType(secondaryTags);

const pageTitle = `${t('common.tags')} | ${t('common.name')}`;
---

<MainLayout title={pageTitle} description={t('common.tags-description')}>
  <Container maxW="breakpoint-xl" py="8">
    <Stack gap="12">
      <PageMasthead
        heading={t('common.tags')}
        lede={t('common.tags-description')}
      />

      {
        tags.length === 0 ? (
          <Box
            border="1px solid"
            borderColor="var(--atelier-line)"
            bg="var(--atelier-surface-low)"
            borderRadius="0"
            p={{ base: '8', md: '12' }}
          >
            <Stack gap="4" alignItems="center" textAlign="center" py="12">
              <Text
                fontFamily="var(--font-code)"
                fontSize="10px"
                textTransform="uppercase"
                letterSpacing="0.12em"
                color="var(--atelier-outline)"
              >
                {tagsUnavailable ? t('note.status-unavailable') : t('common.tags-status-empty')}
              </Text>
              <Heading as="h2" fontSize={{ base: '3xl', md: '4xl' }}>
                {tagsUnavailable ? t('common.tags-empty-title') : t('common.tags-empty-none-title')}
              </Heading>
              <Text color="var(--atelier-fg-muted)" maxW="md" lineHeight="1.7">
                {tagsUnavailable
                  ? t('common.tags-empty-description')
                  : t('common.tags-empty-none-description')}
              </Text>
            </Stack>
          </Box>
        ) : (
          <>
            {Object.entries(primaryGroups).map(([type, groupTags]) => (
              <Stack gap="6">
                <Flex alignItems="center" gap="4">
                  <Text
                    fontFamily="var(--font-code)"
                    fontSize="10px"
                    textTransform="uppercase"
                    letterSpacing="0.12em"
                    color="var(--atelier-outline)"
                    flexShrink="0"
                  >
                    {t(`common.${toKebabCase(type)}` as 'common.frontend')}
                  </Text>
                  <div style="flex:1;height:1px;background:var(--atelier-line)" />
                </Flex>
                <Wrap gap="3">
                  {groupTags.map((tag) => (
                    <Link
                      href={`/${locale}/tags/${tagSlug(tag)}`}
                      display="block"
                      _hover={{ transform: 'translate(-2px, -2px)' }}
                      transition="transform 0.2s ease"
                    >
                      <TagBadge tag={tag} showCount size="md" />
                    </Link>
                  ))}
                </Wrap>
              </Stack>
            ))}

            {/* The small categories used to claim a full-width band each: DATABASE with two
                chips owned 1120px and ~55px of void, seven times down the page. Paired up,
                the bands fill and the page gets a shape. */}
            <Grid
              gridTemplateColumns={{ base: 'minmax(0, 1fr)', md: 'repeat(2, minmax(0, 1fr))' }}
              gap="10"
            >
              {Object.entries(secondaryGroups).map(([type, groupTags]) => (
                <Stack gap="6" css={{ '&:last-child:nth-child(odd)': { gridColumn: '1 / -1' } }}>
                  <Flex alignItems="center" gap="4">
                    <Text
                      fontFamily="var(--font-code)"
                      fontSize="10px"
                      textTransform="uppercase"
                      letterSpacing="0.12em"
                      color="var(--atelier-outline)"
                      flexShrink="0"
                    >
                      {t(`common.${toKebabCase(type)}` as 'common.frontend')}
                    </Text>
                    <div style="flex:1;height:1px;background:var(--atelier-line)" />
                  </Flex>
                  <Wrap gap="3">
                    {groupTags.map((tag) => (
                      <Link
                        href={`/${locale}/tags/${tagSlug(tag)}`}
                        display="block"
                        _hover={{ transform: 'translate(-2px, -2px)' }}
                        transition="transform 0.2s ease"
                      >
                        <TagBadge tag={tag} showCount size="md" />
                      </Link>
                    ))}
                  </Wrap>
                </Stack>
              ))}
            </Grid>
          </>
        )
      }
    </Stack>
  </Container>
</MainLayout>
