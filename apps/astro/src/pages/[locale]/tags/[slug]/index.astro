---
import { FaArrowLeft } from 'react-icons/fa';
import { Box, Container, Grid, GridItem, HStack, Stack, Wrap } from 'styled-system/jsx';
import { formatMonthSpan, formatMonthYear, parseDate } from 'utils/date';
import { toKebabCase } from 'utils/kebab-case';
import { Markdown } from '~/components/lib/Markdown';
import { ProjectCard } from '~/components/projects/ProjectCard';
import { TagBadge } from '~/components/tags/TagBadge';
import { Heading } from '~/components/ui/heading';
import { Link } from '~/components/ui/link';
import { Text } from '~/components/ui/text';
import { graphQLSdk } from '~/graphql';
import { withLastGood } from '~/utils/cms-cache';
import type {
  ExperienceFragment,
  GetTagBySlugQuery,
  ProjectPreviewFragment,
  TagFragment
} from '~/graphql/generated/client';
import { useTranslations, validateLocale } from '~/i18n/utils';
import { knownLinkLabelsFrom } from '~/utils/link-label';
import MainLayout from '~/layouts/MainLayout.astro';
import Eyebrow from '~/components/common/Eyebrow.astro';
import SectionHeading from '~/components/common/SectionHeading.astro';
import { sortTags, tagSlug } from '~/utils/tags';

export const prerender = false;

const { locale, slug } = Astro.params;
type TagData = NonNullable<GetTagBySlugQuery['tags'][number]>;

if (!validateLocale(locale)) {
  return Astro.redirect('/404');
}

let tagData: TagData | undefined;
let tagUnavailable = false;
try {
  tagData = await withLastGood(
    `tag:${slug}`,
    async () => {
      const data = await graphQLSdk.getTagBySlug({ slug });
      let tag = data?.tags?.[0] ?? undefined;
      if (!tag) {
        const aboutData = await withLastGood('about:en', () =>
          graphQLSdk.fetchAboutMe({ locale: 'en' })
        );
        const match = (aboutData.tags ?? []).find(
          (candidate) => !!candidate?.title && !!candidate.slug && tagSlug(candidate) === slug
        );
        if (match?.slug && match.slug !== slug) {
          const bySlug = await graphQLSdk.getTagBySlug({ slug: match.slug });
          tag = bySlug?.tags?.[0] ?? undefined;
        }
      }
      return tag;
    },
    (tag) => !!tag
  );
} catch {
  tagUnavailable = true;
}

if (!tagUnavailable && !tagData) {
  return Astro.redirect(`/${locale}/404`);
}

if (tagData && tagSlug(tagData) !== slug) {
  return Astro.redirect(`/${locale}/tags/${tagSlug(tagData)}`, 301);
}

if (tagUnavailable) {
  Astro.response.status = 503;
}

const title = tagData?.title;
const type = tagData?.type;
const experienceItems = (tagData?.experiences ?? []).filter(
  (e): e is ExperienceFragment & { id: string } => !!e
);
const projectItems = (tagData?.projects ?? []).filter(
  (p): p is ProjectPreviewFragment & { id: string } => !!p
);
const t = useTranslations(locale);
const typeKey = type ? toKebabCase(type) : undefined;
const typeLabel =
  typeKey === 'others'
    ? t('project.tag-type-others')
    : typeKey === 'programming-language'
      ? t('project.tag-type-programming-language')
      : typeKey
        ? t(`common.${typeKey as 'frontend'}`)
        : undefined;
const contentLangOf = (recordLocale?: string | null) =>
  recordLocale && recordLocale !== locale ? recordLocale : undefined;
const nonNullTags = (tags: Array<TagFragment | null>) => tags.filter((t): t is TagFragment => !!t);
const isCurrentTag = (tag: TagFragment) =>
  tagSlug(tag) === slug || (!!tag.slug && tag.slug === tagData?.slug);
const pageTitle = `${title ?? t('common.tags')} | ${t('common.name')}`;

if (tagUnavailable) {
  Astro.response.headers.set('CDN-Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('CDN-Cache-Control', 'public, max-age=86400, must-revalidate');
}
---

<MainLayout title={pageTitle}>
  <Container maxW="breakpoint-xl" py="8" w="full">
    <Stack gap="8">
      <Link
        href={`/${locale}/tags`}
        display="inline-flex"
        alignItems="center"
        alignSelf="start"
        minH="44px"
      >
        <Wrap
          fontSize="xs"
          fontFamily="var(--font-code)"
          alignItems="center"
          color="var(--atelier-fg-muted)"
          _hover={{ color: 'var(--atelier-accent)' }}
        >
          <FaArrowLeft />
          <Text>{t('project.back-to-tags')}</Text>
        </Wrap>
      </Link>
      {
        tagUnavailable && (
          <Stack
            gap="4"
            alignItems="center"
            textAlign="center"
            py="12"
            border="1px solid"
            borderColor="var(--atelier-line)"
            bg="var(--atelier-surface-low)"
            p={{ base: '8', md: '12' }}
          >
            <Text
              fontFamily="var(--font-code)"
              fontSize="10px"
              textTransform="uppercase"
              letterSpacing="0.12em"
              color="var(--atelier-outline)"
            >
              {t('note.status-unavailable')}
            </Text>
            <Heading as="h1" fontSize={{ base: '3xl', md: '4xl' }}>
              {t('project.tag-detail-empty-title')}
            </Heading>
            <Text color="var(--atelier-fg-muted)" maxW="md" lineHeight="1.7">
              {t('project.tag-detail-empty-description')}
            </Text>
            <Wrap gap="6" justifyContent="center">
              <Link
                href={Astro.url.pathname}
                display="inline-flex"
                alignItems="center"
                minH="44px"
                className="amber-link"
              >
                {t('project.reload')}
              </Link>
              <Link
                href={`/${locale}/projects`}
                display="inline-flex"
                alignItems="center"
                minH="44px"
                className="amber-link"
              >
                {t('common.projects')}
              </Link>
            </Wrap>
          </Stack>
        )
      }
      {
        !tagUnavailable && (
          <>
            <Stack gap="4" className="page-header-rule" py="2">
              <Eyebrow label={t('common.tags')} />
              <Stack gap="1">
                <Heading as="h1" fontSize={{ base: '5xl', md: '7xl' }}>
                  {title}
                </Heading>
                <Wrap fontSize="sm" color="var(--atelier-outline)" fontFamily="var(--font-code)">
                  {typeLabel && <Text>{typeLabel}</Text>}
                </Wrap>
              </Stack>
            </Stack>

            {experienceItems.length > 0 && <SectionHeading label={t('common.experiences')} />}
            {experienceItems.map((experience) => {
              const {
                title,
                content,
                position,
                tags,
                start,
                end,
                locale: recordLocale
              } = experience;
              const recordLang = contentLangOf(recordLocale);
              const startDate = start ? parseDate(start as string) : null;
              const endDate = end ? parseDate(end as string) : null;
              const duration = startDate
                ? formatMonthSpan(startDate, endDate ?? new Date(), locale)
                : '';
              return (
                <Stack
                  border="1px solid"
                  borderColor="var(--atelier-line)"
                  bg="var(--atelier-surface-low)"
                  p="6"
                  maxW="calc(70ch + token(spacing.12))"
                >
                  <Heading as="h3" fontSize={{ base: '2xl', md: '3xl' }} lang={recordLang}>
                    {title}
                  </Heading>
                  <Wrap
                    fontSize="sm"
                    color="var(--atelier-outline)"
                    fontFamily="var(--font-code)"
                    columnGap="3"
                    rowGap="1"
                  >
                    {position && (
                      <Text color="var(--atelier-fg-muted)" lang={recordLang}>
                        {position}
                      </Text>
                    )}
                    {position && startDate && (
                      <Text aria-hidden="true" display={{ base: 'none', md: 'inline' }}>
                        |
                      </Text>
                    )}
                    {startDate && (
                      <Text>
                        {formatMonthYear(startDate, locale)} –{' '}
                        {endDate ? formatMonthYear(endDate, locale) : t('common.present')}
                        {duration && (
                          <Text as="span" whiteSpace="nowrap">
                            {t('project.duration-span').replace('{duration}', duration)}
                          </Text>
                        )}
                      </Text>
                    )}
                  </Wrap>
                  {tags && (
                    <HStack alignItems="start" gap="2">
                      <Text
                        fontFamily="var(--font-code)"
                        fontSize="xs"
                        color="var(--atelier-outline)"
                        display="flex"
                        alignItems="center"
                        minH="44px"
                      >
                        {t('common.tags')}
                      </Text>
                      <Wrap columnGap="2" rowGap="0">
                        {sortTags(nonNullTags(tags)).map(
                          (tag) =>
                            tag &&
                            (isCurrentTag(tag) ? (
                              <Box
                                display="inline-flex"
                                alignItems="center"
                                justifyContent="center"
                                minW="44px"
                                minH="44px"
                                aria-current="page"
                              >
                                <TagBadge tag={tag} size="sm" current />
                              </Box>
                            ) : (
                              <Link
                                href={`/${locale}/tags/${tagSlug(tag)}`}
                                display="inline-flex"
                                alignItems="center"
                                justifyContent="center"
                                minW="44px"
                                minH="44px"
                                className="group"
                              >
                                <TagBadge tag={tag} size="sm" interactive />
                              </Link>
                            ))
                        )}
                      </Wrap>
                    </HStack>
                  )}
                  {/* The card body ran the full 1070px container — about 130 characters a
                      line, against ~70 on every other prose surface on the site. */}
                  {content && (
                    <Box maxW="70ch">
                      <div lang={recordLang}>
                        <Markdown
                          content={content}
                          headingLevelOffset={3}
                          newTabLabel={t('note.opens-new-tab')}
                          linkLabels={knownLinkLabelsFrom(t)}
                          codeLabel={t('common.code-block')}
                          locale={locale}
                        />
                      </div>
                    </Box>
                  )}
                </Stack>
              );
            })}
            {projectItems.length > 0 && (
              <>
                <SectionHeading label={t('common.projects')} />
                <Grid
                  gridTemplateColumns="repeat(auto-fill, minmax(min(100%, 300px), 1fr))"
                  alignItems={{ base: 'start', md: 'stretch' }}
                  gap="8"
                >
                  {projectItems.map((project) => (
                    <GridItem>
                      <ProjectCard data={project} locale={locale} />
                    </GridItem>
                  ))}
                </Grid>
              </>
            )}
            {experienceItems.length === 0 && projectItems.length === 0 && (
              <Stack
                gap="4"
                alignItems="start"
                border="1px solid"
                borderColor="var(--atelier-line)"
                bg="var(--atelier-surface-low)"
                p={{ base: '6', md: '8' }}
              >
                <Text color="var(--atelier-fg-muted)" lineHeight="1.7">
                  {t('project.tag-empty')}
                </Text>
                <Link
                  href={`/${locale}/tags`}
                  display="inline-flex"
                  alignItems="center"
                  minH="44px"
                  className="amber-link"
                >
                  {t('project.back-to-tags')}
                </Link>
              </Stack>
            )}
          </>
        )
      }
    </Stack>
  </Container>
</MainLayout>
