---
import { Box, Flex, Grid, Stack } from 'styled-system/jsx';
import { container, stack } from 'styled-system/patterns';
import { Heading } from '~/components/ui/heading';
import { useTranslations, validateLocale } from '~/i18n/utils';
import MainLayout from '~/layouts/MainLayout.astro';
import HomeBody from '~/components/home/HomeBody.astro';
import Eyebrow from '~/components/common/Eyebrow.astro';
import '~/styles/home.css';

export const prerender = false;

const { locale } = Astro.params;

if (!validateLocale(locale)) {
  return Astro.redirect('/404');
}

const t = useTranslations(locale);
const pageTitle = `${t('common.home')} | ${t('common.name')}`;
Astro.response.headers.set('CDN-Cache-Control', 'public, max-age=60, must-revalidate');
---

<MainLayout title={pageTitle} description={t('home.hero-subtitle').replace(/<[^>]*>/g, '')}>
  <div class:list={['page-shell', 'home-experience', container({ maxW: 'breakpoint-xl' })]}>
    <div class="home-world" aria-hidden="true"><canvas data-home-hero></canvas></div>
    <div class:list={['home-content', stack({ py: { base: '8', md: '10' }, gap: '0' })]}>
      <Grid
        gridTemplateColumns={{
          base: 'minmax(0, 1fr)',
          lg: 'minmax(0, 1fr)'
        }}
        gap="12"
        py={{ base: '8', lg: '24' }}
        borderBottom="1px solid var(--atelier-line)"
        className="home-hero-grid"
      >
        <Stack gap="8" className="home-hero-copy">
          <Eyebrow label={t('home.operational-status')} />
          <Heading
            as="h1"
            className="home-hero-heading"
            fontSize={{ base: '5xl', md: '5xl', lg: '5xl' }}
            lineHeight={locale === 'th' ? '1.15' : locale === 'ja' ? '1.05' : '0.95'}
            style={locale === 'ja' ? { wordBreak: 'auto-phrase' } : undefined}
          >
            {t('home.hero-heading-prefix')}
            {
              /* The two halves render on separate lines but concatenate in textContent,
                so copy-paste and any title derived from the h1 ran the words together.
                Japanese needs no separator: its prefix already ends in a full stop. */
            }
            {locale === 'ja' ? '' : ' '}
            <Box as="span" display="block" fontStyle="italic" color="var(--atelier-accent)">
              {t('home.hero-heading-emphasis')}
            </Box>
          </Heading>
          <p class="hero-subtitle" set:html={t('home.hero-subtitle')} />
          <Flex gap="4" wrap="wrap" pt="2">
            <a
              href={`/${locale}/projects`}
              class="home-hero-cta home-hero-cta-primary blocky-shadow blocky-shadow-hover"
            >
              {t('home.view-my-work')}
            </a>
            <a href={`/${locale}/hobbies`} class="home-hero-cta cta-secondary">
              {t('home.explore-hobbies')}
            </a>
          </Flex>
        </Stack>
      </Grid>

      <HomeBody locale={locale} />
    </div>
  </div>
</MainLayout>

<script>
  const mountHomeHero = () => {
    if (document.querySelector('[data-home-hero]')) {
      void import('~/components/home/hero-scene').then(({ mountHomeHero }) => mountHomeHero());
    }
  };

  const mountHomePhotos = () => {
    document.querySelectorAll<HTMLImageElement>('[data-kameko-image]').forEach((image) => {
      if (image.dataset.homePhotoBound) return;
      image.dataset.homePhotoBound = 'true';
      const hide = () => image.closest<HTMLElement>('li, figure')?.setAttribute('hidden', '');
      image.addEventListener('error', hide, { once: true });
      if (image.complete && image.naturalWidth === 0) hide();
      image.addEventListener('contextmenu', (event) => event.preventDefault());
      image.addEventListener('dragstart', (event) => event.preventDefault());
    });
  };

  mountHomeHero();
  mountHomePhotos();
  document.addEventListener('astro:page-load', mountHomeHero);
  document.addEventListener('astro:page-load', mountHomePhotos);
</script>
