---
import { Box, Container, Flex, Grid, Stack } from 'styled-system/jsx';
import { resolveMedia } from 'utils/media';
import { Heading } from '~/components/ui/heading';
import { Text } from '~/components/ui/text';
import { graphQLSdk } from '~/graphql';
import type { ProjectPreviewFragment } from '~/graphql/generated/client';
import { useTranslations, validateLocale } from '~/i18n/utils';
import MainLayout from '~/layouts/MainLayout.astro';
import SectionHeading from '~/components/common/SectionHeading.astro';
import { withLastGood } from '~/utils/cms-cache';
import { pickLocale } from '~/utils/fallbackLocale';
import { cleanProjectCopy } from '~/utils/project-copy';
import { kamekoEntries } from '~/utils/kameko';
import '~/styles/home.css';

export const prerender = false;

const { locale } = Astro.params;

if (!validateLocale(locale)) {
  return Astro.redirect('/404');
}

const t = useTranslations(locale);
const pageTitle = `${t('common.home')} | ${t('common.name')}`;

const cmsLocale = locale === 'ja' ? 'ja' : 'en';

let projects: ProjectPreviewFragment[] = [];
let homeUnavailable = false;

try {
  const data = await withLastGood(`home:${cmsLocale}`, () =>
    graphQLSdk.fetchHomePage({ locale: cmsLocale })
  );
  const rawProjects = data?.projects ?? [];
  projects = rawProjects
    .map((p) => pickLocale(p, locale))
    .filter((p): p is ProjectPreviewFragment => !!p)
    .map((p) => cleanProjectCopy(p));
} catch {
  projects = [];
  homeUnavailable = true;
}

const heroProjects = [
  ...projects.filter((project) => project.banner ?? project.media?.[0]),
  ...projects.filter((project) => !(project.banner ?? project.media?.[0]))
].slice(0, 3);
const [heroPhoto, ...otherPhotos] = kamekoEntries;
const recentPhotos = otherPhotos
  .filter(
    (entry, index, list) =>
      entry.subjects[0]?.name !== heroPhoto?.subjects[0]?.name &&
      list.findIndex((other) => other.subjects[0]?.name === entry.subjects[0]?.name) === index
  )
  .slice(0, 4);
const yearPartFormatter = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  timeZone: 'Asia/Tokyo',
  calendar: 'gregory'
});
const yearLabel = (year?: string) =>
  year
    ? (yearPartFormatter
        .formatToParts(new Date(`${year}-01-01T00:00:00+09:00`))
        .find((part) => part.type === 'year')?.value ?? year)
    : undefined;

Astro.response.headers.set(
  'CDN-Cache-Control',
  homeUnavailable ? 'public, max-age=60, must-revalidate' : 'public, max-age=3600, must-revalidate'
);
---

<MainLayout title={pageTitle} description={t('home.hero-subtitle').replace(/<[^>]*>/g, '')}>
  <Container maxW="breakpoint-xl" className="page-shell">
    <Stack py={{ base: '8', md: '10' }} gap="0">
      <Grid
        gridTemplateColumns={{ base: 'minmax(0, 1fr)', lg: 'minmax(0, 1.6fr) 400px' }}
        alignItems="center"
        gap="12"
        py={{ base: '14', lg: '24' }}
      >
        <Stack gap="8">
          <Heading
            as="h1"
            fontSize={{ base: '5xl', md: '5xl', lg: '5xl' }}
            lineHeight={locale === 'th' ? '1.15' : locale === 'ja' ? '1.05' : '0.95'}
            style={locale === 'ja' ? { wordBreak: 'auto-phrase' } : undefined}
          >
            {t('home.hero-heading-prefix')}
            {
              /* The two halves render on separate lines but concatenate in textContent,
                so copy-paste and any title derived from the h1 ran the words together.
                Japanese needs no separator: its prefix already ends in a full stop. */
            }
            {locale === 'ja' ? '' : ' '}
            <Box as="span" display="block">
              {t('home.hero-heading-emphasis')}
            </Box>
          </Heading>
          <p class="hero-subtitle" set:html={t('home.hero-subtitle')} />
          <Flex gap="4" wrap="wrap" pt="2">
            <a
              href={`/${locale}/projects`}
              class="home-hero-cta home-hero-cta-primary blocky-shadow blocky-shadow-hover"
            >
              {t('home.view-my-work')}
            </a>
            <a href={`/${locale}/hobbies`} class="home-hero-cta cta-secondary">
              {t('home.explore-hobbies')}
            </a>
          </Flex>
        </Stack>
        {
          heroPhoto && (
            <figure class="home-hero-photo">
              <a
                href={heroPhoto.url}
                target="_blank"
                rel="noopener noreferrer"
                class="home-hero-photo-frame"
                style={`aspect-ratio: ${heroPhoto.media[0].width} / ${heroPhoto.media[0].height}`}
              >
                <img
                  src={`${heroPhoto.media[0].url}?format=jpg&name=medium`}
                  alt={heroPhoto.subjects.map((subject) => subject.name).join(', ')}
                  width={heroPhoto.media[0].width ?? undefined}
                  height={heroPhoto.media[0].height ?? undefined}
                  decoding="async"
                  fetchpriority="high"
                  draggable="false"
                  referrerpolicy="no-referrer"
                  data-kameko-image
                />
              </a>
              <figcaption>
                <span class="home-hero-photo-name">
                  {heroPhoto.subjects.map((subject) => subject.name).join('、')}
                </span>
                <span class="home-hero-photo-meta">{heroPhoto.event}</span>
              </figcaption>
            </figure>
          )
        }
      </Grid>

      <Box py={{ base: '8', lg: '16' }}>
        <Box mb="12">
          <SectionHeading label={t('home.bench-heading')} />
        </Box>
        <Grid
          gridTemplateColumns={{ base: 'minmax(0, 1fr)', md: 'repeat(12, minmax(0, 1fr))' }}
          gap="6"
        >
          <Box
            gridColumn={{ base: 'span 1', md: 'span 7' }}
            position="relative"
            border="1px solid"
            borderColor="var(--atelier-line)"
            bg="var(--atelier-surface-low)"
            p="8"
            className="blocky-shadow-sm"
          >
            <Stack gap="6">
              <Heading as="h3" fontSize={{ base: 'lg', md: 'xl' }}>
                {t('home.bench-manifesto-heading')}{locale === 'ja' ? '' : ' '}
                {t('home.bench-manifesto-emphasis')}
              </Heading>
              <Text color="var(--atelier-fg-muted)" lineHeight="relaxed">
                {t('home.bench-manifesto-body')}
              </Text>
              <Flex gap="2" wrap="wrap">
                <Box
                  px="3"
                  py="1"
                  bg="var(--atelier-surface-highest)"
                  border="1px solid"
                  borderColor="var(--atelier-line)"
                  fontSize="xs">{t('home.bench-principle-clear')}</Box
                >
                <Box
                  px="3"
                  py="1"
                  bg="var(--atelier-surface-highest)"
                  border="1px solid"
                  borderColor="var(--atelier-line)"
                  fontSize="xs">{t('home.bench-principle-useful')}</Box
                >
                <Box
                  px="3"
                  py="1"
                  bg="var(--atelier-surface-highest)"
                  border="1px solid"
                  borderColor="var(--atelier-line)"
                  fontSize="xs">{t('home.bench-principle-maintainable')}</Box
                >
              </Flex>
            </Stack>
          </Box>

          <Box
            gridColumn={{ base: 'span 1', md: 'span 5' }}
            position="relative"
            border="1px solid"
            borderColor="var(--atelier-line)"
            bg="var(--atelier-surface-low)"
            p="8"
            className="blocky-shadow-sm"
          >
            <Grid gridTemplateColumns="minmax(0, 1fr) minmax(0, 1fr)" gap="4">
              <Stack borderLeft="2px solid" borderLeftColor="var(--atelier-line)" pl="4" gap="1">
                <Text fontFamily="var(--font-code)" fontSize="10px" color="var(--atelier-outline)"
                  >{t('home.bench-tools-frontend')}</Text
                >
                <Text fontFamily="var(--font-body)" fontWeight="bold" fontSize="lg"
                  >React / Next.js</Text
                >
              </Stack>
              <Stack borderLeft="2px solid" borderLeftColor="var(--atelier-line)" pl="4" gap="1">
                <Text fontFamily="var(--font-code)" fontSize="10px" color="var(--atelier-outline)"
                  >{t('home.bench-tools-styling')}</Text
                >
                <Text fontFamily="var(--font-body)" fontWeight="bold" fontSize="lg"
                  >Tailwind CSS</Text
                >
              </Stack>
              <Stack borderLeft="2px solid" borderLeftColor="var(--atelier-line)" pl="4" gap="1">
                <Text fontFamily="var(--font-code)" fontSize="10px" color="var(--atelier-outline)"
                  >{t('home.bench-tools-design')}</Text
                >
                <Text fontFamily="var(--font-body)" fontWeight="bold" fontSize="lg"
                  >Figma / WebGL</Text
                >
              </Stack>
              <Stack borderLeft="2px solid" borderLeftColor="var(--atelier-line)" pl="4" gap="1">
                <Text fontFamily="var(--font-code)" fontSize="10px" color="var(--atelier-outline)"
                  >{t('home.bench-tools-scripting')}</Text
                >
                <Text fontFamily="var(--font-body)" fontWeight="bold" fontSize="lg"
                  >Node.js / Python</Text
                >
              </Stack>
            </Grid>
          </Box>
        </Grid>
      </Box>

      <Box py={{ base: '16', lg: '20' }}>
        {
          /* Inline rule, matching "Life" below and the section headers on /projects, /tags,
            /about and /events. A full-width underline was a second section-header idiom on
            the same page. */
        }
        <Box mb="12">
          <SectionHeading label={t('home.featured-projects')} />
        </Box>
        {
          heroProjects.length > 0 ? (
            <Grid
              gridTemplateColumns={{
                base: 'minmax(0, 1fr)',
                md: 'repeat(2, minmax(0, 1fr))',
                lg: 'repeat(3, minmax(0, 1fr))'
              }}
              gap="0"
              borderTop="1px solid"
              borderLeft="1px solid"
              borderColor="var(--atelier-line)"
              mb="20"
            >
              {heroProjects.map((project) => {
                const imgSrc =
                  resolveMedia(
                    project.banner ?? project.media?.[0],
                    400,
                    import.meta.env.PUBLIC_API_URL
                  )?.src ?? null;
                return (
                  <a
                    href={`/${locale}/projects/${project.slug}`}
                    class="project-card"
                    style="display:flex;flex-direction:column;height:100%;border-right:1px solid var(--atelier-line);border-bottom:1px solid var(--atelier-line);overflow:hidden;background:var(--atelier-bg);cursor:pointer;text-decoration:none;color:inherit"
                  >
                    <Box
                      position="relative"
                      aspectRatio="16 / 10"
                      overflow="hidden"
                      className="group"
                    >
                      {imgSrc ? (
                        <>
                          <img
                            src={imgSrc}
                            alt=""
                            style="width:100%;height:100%;object-fit:cover;filter:var(--atelier-image-rest);transition:filter 500ms, transform 500ms"
                            class="project-card-img"
                            width="600"
                            height="600"
                            loading="lazy"
                          />
                          <Box
                            position="absolute"
                            inset="0"
                            bg="linear-gradient(180deg, rgba(19,19,19,0.32), rgba(19,19,19,0.72)), linear-gradient(135deg, rgba(255,176,0,0.10), transparent 60%)"
                            className="project-card-overlay"
                            style={{ transition: 'opacity 300ms' }}
                          />
                        </>
                      ) : (
                        <Box
                          position="relative"
                          w="100%"
                          h="100%"
                          bg="var(--atelier-surface-lowest)"
                          className="fallback-grid-lines"
                        >
                          <Box
                            position="absolute"
                            bottom="0"
                            left="0"
                            right="0"
                            h="2px"
                            bg="var(--atelier-accent)"
                            opacity="0.3"
                          />
                        </Box>
                      )}
                    </Box>
                    <Box p="6" display="flex" flexDirection="column" flex="1">
                      <Flex justify="space-between" align="start" mb="2">
                        <Heading as="h3" fontSize={{ base: 'xl', md: '2xl' }} lineHeight="1.15">
                          {project.title}
                        </Heading>
                      </Flex>
                      <Text color="var(--atelier-fg-muted)" fontSize="sm" lineHeight="1.7" mb="6">
                        {project.description}
                      </Text>
                      <Flex
                        mt="auto"
                        pt="4"
                        borderTop="1px solid"
                        borderColor="var(--atelier-line)"
                        justify="space-between"
                        align="center"
                        opacity="0.5"
                        className="project-card-footer"
                        style={{
                          marginTop: 'auto',
                          paddingTop: '1rem',
                          transition: 'opacity 300ms'
                        }}
                      >
                        <Text fontFamily="var(--font-code)" fontSize="10px">
                          {yearLabel(project.date?.slice(0, 4)) ?? t('common.projects')}
                        </Text>
                      </Flex>
                    </Box>
                  </a>
                );
              })}
            </Grid>
          ) : (
            <Box
              border="1px solid"
              borderColor="var(--atelier-line)"
              bg="var(--atelier-surface-low)"
              p={{ base: '8', md: '12' }}
              mb="20"
              textAlign="center"
            >
              <Text
                fontFamily="var(--font-code)"
                fontSize="10px"
                textTransform="uppercase"
                letterSpacing="0.15em"
                color="var(--atelier-outline)"
                mb="4"
              >
                {t('project.status-unavailable')}
              </Text>
              <Heading as="h3" fontSize={{ base: 'xl', md: '2xl' }} mb="3">
                {t('home.projects-empty-title')}
              </Heading>
              <Text color="var(--atelier-outline)" fontSize="sm">
                {t('home.projects-empty-description')}
              </Text>
            </Box>
          )
        }
        {
          recentPhotos.length > 0 && (
            <Stack gap="8">
              <Flex align="center" gap="6">
                <Box flex="1" minW="0">
                  <SectionHeading label={t('home.photos-heading')} />
                </Box>
                <a href={`/${locale}/photos`} class="home-photos-all">
                  {t('home.photos-all')}
                </a>
              </Flex>
              <ul class="home-photos">
                {recentPhotos.map((entry) => (
                  <li>
                    <a
                      href={entry.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-kameko-card
                      style={`--ar: ${entry.media[0].width} / ${entry.media[0].height}`}
                    >
                      <img
                        src={`${entry.media[0].url}?format=jpg&name=small`}
                        alt={entry.subjects.map((subject) => subject.name).join(', ')}
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                        referrerpolicy="no-referrer"
                        data-kameko-image
                      />
                      <span>{entry.subjects.map((subject) => subject.name).join('、')}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </Stack>
          )
        }
      </Box>
    </Stack>
  </Container>
</MainLayout>

<script>
  document.querySelectorAll<HTMLImageElement>('[data-kameko-image]').forEach((image) => {
    const hide = () => image.closest<HTMLElement>('li, figure')?.setAttribute('hidden', '');
    if (image.complete && image.naturalWidth === 0) hide();
    image.addEventListener('error', hide, { once: true });
    image.addEventListener('contextmenu', (event) => event.preventDefault());
    image.addEventListener('dragstart', (event) => event.preventDefault());
  });
</script>
