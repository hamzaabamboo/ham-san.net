---
import { Heading } from '~/components/ui/heading';
import Eyebrow from '~/components/common/Eyebrow.astro';
import { useTranslations, validateLocale } from '~/i18n/utils';
import MainLayout from '~/layouts/MainLayout.astro';
import HomeBody from '~/components/home/HomeBody.astro';
import RoomHome from '~/components/home/RoomHome.astro';
import StatusRow from '~/components/home/StatusRow.astro';
import { getHomepageStatus } from '~/utils/homepage-status';
import '~/styles/home.css';

export const prerender = false;

const { locale } = Astro.params;

if (!validateLocale(locale)) {
  return Astro.redirect('/404');
}

const t = useTranslations(locale);
const pageTitle = `${t('common.home')} | ${t('common.name')}`;
const status = Promise.race([
  getHomepageStatus(locale),
  new Promise<null>((resolve) => setTimeout(() => resolve(null), 500))
]).catch(() => null);
Astro.response.headers.set('CDN-Cache-Control', 'public, max-age=60, must-revalidate');
---

<MainLayout title={pageTitle} description={t('home.hero-subtitle')}>
  <div class="home-experience">
    <RoomHome locale={locale} tour>
      <section class="home-chapter home-intro" data-tour-stop="entry" aria-labelledby="home-title">
        <div class="home-panel">
          <Eyebrow label={t('home.operational-status')} />
          <Heading
            as="h1"
            id="home-title"
            className="home-name"
            fontSize={{ base: '7xl', md: '8xl', lg: '9xl' }}
          >
            {t('common.name')}
          </Heading>
          <p class="home-role">{t('home.hero-text')}</p>
          <p class="hero-subtitle">{t('home.hero-subtitle')}</p>
          <a class="home-chapter-link" href={`/${locale}/contact`}>{t('home.availability')}</a>
          <div class="home-actions">
            <button type="button" class="home-hero-cta home-hero-cta-primary" data-room-enter>
              {t('home.enter-room')}
            </button>
            <a href={`/${locale}/projects`} class="home-hero-cta cta-secondary">
              {t('home.view-my-work')}
            </a>
          </div>
          <StatusRow locale={locale} status={await status} />
        </div>
      </section>
      <HomeBody locale={locale} />
    </RoomHome>
  </div>
</MainLayout>

<script>
  const mountHomePhotos = () => {
    document.querySelectorAll<HTMLImageElement>('[data-kameko-image]').forEach((image) => {
      if (image.dataset.homePhotoBound) return;
      image.dataset.homePhotoBound = 'true';
      const hide = () => image.closest<HTMLElement>('li, figure')?.setAttribute('hidden', '');
      image.addEventListener('error', hide, { once: true });
      if (image.complete && image.naturalWidth === 0) hide();
      image.addEventListener('contextmenu', (event) => event.preventDefault());
      image.addEventListener('dragstart', (event) => event.preventDefault());
    });
  };

  let refreshRun = 0;
  const swapDegraded = (html: string) => {
    const next = new DOMParser().parseFromString(html, 'text/html');
    document.querySelectorAll<HTMLElement>('[data-home-degraded]').forEach((section) => {
      if (section.contains(document.activeElement)) return;
      const key = section.getAttribute('aria-labelledby');
      const fresh = next.querySelector(`[aria-labelledby="${key}"]`);
      const panel = fresh?.querySelector('.home-panel');
      if (!fresh || fresh.hasAttribute('data-home-degraded') || !panel) return;
      section.querySelector('.home-panel')?.replaceWith(document.importNode(panel, true));
      section.removeAttribute('data-home-degraded');
    });
    mountHomePhotos();
  };

  const refreshDegraded = (run: number, path: string, attempt = 0): Promise<void> => {
    if (run !== refreshRun || !document.querySelector('[data-home-degraded]') || attempt > 2)
      return Promise.resolve();
    return new Promise((resolve) => setTimeout(resolve, 2500 * (attempt + 1)))
      .then(() =>
        run === refreshRun
          ? fetch(`${path}?refresh=${Date.now()}`, { headers: { accept: 'text/html' } })
          : undefined
      )
      .then((response) =>
        response?.ok && run === refreshRun ? response.text().then(swapDegraded) : undefined
      )
      .then(
        () => refreshDegraded(run, path, attempt + 1),
        () => refreshDegraded(run, path, attempt + 1)
      );
  };

  mountHomePhotos();
  document.addEventListener('astro:page-load', mountHomePhotos);
  document.addEventListener('astro:page-load', () => {
    refreshRun += 1;
    void refreshDegraded(refreshRun, location.pathname);
  });
  document.addEventListener('astro:before-swap', () => {
    refreshRun += 1;
  });
</script>
