---
import { FaArrowLeft } from 'react-icons/fa';
import { Box, Container, Divider, Grid, HStack, Stack, Wrap } from 'styled-system/jsx';
import { formatMonthYear, parseDate } from 'utils/date';
import { resolveMedia } from 'utils/media';
import { tagSlug } from '~/utils/tags';
import { Carousel } from '~/components/common/Carousel';
import { LinkItem } from '~/components/common/LinkItem';
import { Enum_Componentutilslink_Type } from '~/graphql/generated/client';
import { Markdown } from '~/components/lib/Markdown';
import { TagBadge } from '~/components/tags/TagBadge';
import { Heading } from '~/components/ui/heading';
import { Link } from '~/components/ui/link';
import { Text } from '~/components/ui/text';
import { graphQLSdk } from '~/graphql';
import { withLastGood } from '~/utils/cms-cache';
import type { ProjectFragment, TagFragment } from '~/graphql/generated/client';
import { useTranslations, validateLocale } from '~/i18n/utils';
import { knownLinkLabelsFrom } from '~/utils/link-label';
import MainLayout from '~/layouts/MainLayout.astro';
import Eyebrow from '~/components/common/Eyebrow.astro';
import SectionHeading from '~/components/common/SectionHeading.astro';
import { projectMonogram } from '~/utils/monogram';

export const prerender = false;

const { locale, slug } = Astro.params;

if (!validateLocale(locale)) {
  return Astro.redirect('/404');
}

let project: (ProjectFragment & { id: string }) | undefined;
let projectUnavailable = false;
try {
  const data = await withLastGood(
    `project:${slug}`,
    () => graphQLSdk.getProjectBySlug({ slug }),
    (result) => !!result?.projects?.[0]
  );
  const rawProject = data?.projects?.[0] as (ProjectFragment & { id: string }) | undefined;
  project = rawProject;
} catch {
  projectUnavailable = true;
}

if (!projectUnavailable && !project) {
  return Astro.redirect(`/${locale}/404`);
}
const {
  content: rawContent,
  title,
  banner,
  links,
  media,
  category,
  date,
  finishedDate,
  isActive,
  tags
} = project ?? {};
const normalizeHeading = (value: string) => value.trim().replace(/\s+/g, ' ').toLowerCase();
const content = rawContent?.replace(/^\s*#{1,6}[ \t]+(.+?)[ \t]*(?:\n+|$)/, (match, heading) =>
  normalizeHeading(heading) === normalizeHeading(title ?? '') ? '' : match
);
const bannerUrl = resolveMedia(banner, 1110, import.meta.env.PUBLIC_API_URL)?.src;
const galleryMedia = (media ?? [])
  .filter((d): d is NonNullable<typeof d> => !!d)
  .filter((d) => !banner?.url || d.url !== banner.url);
const galleryImages = galleryMedia.flatMap((item) => {
  const source = resolveMedia(item, 1110, import.meta.env.PUBLIC_API_URL)?.src;
  return source ? [{ source, alt: item.alternativeText }] : [];
});
const images = galleryImages.map((item) => item.source);
const galleryPortrait =
  galleryMedia.length > 0 && galleryMedia.every((d) => (d.height ?? 0) > (d.width ?? 0));
const nonNullTags = (items: Array<TagFragment | null>) =>
  items.filter((t): t is TagFragment => !!t);
const linkRank = (type?: Enum_Componentutilslink_Type | null) =>
  type === Enum_Componentutilslink_Type.Web
    ? 0
    : type === Enum_Componentutilslink_Type.Github
      ? 1
      : 2;
const nonNullLinks = (links ?? [])
  .filter((l): l is NonNullable<typeof l> => !!l?.url)
  .sort((a, b) => linkRank(a.type) - linkRank(b.type));
const linkEyebrow = (link: (typeof nonNullLinks)[number]) =>
  link.type === Enum_Componentutilslink_Type.Web
    ? t('project.visit-site')
    : link.type === Enum_Componentutilslink_Type.Github
      ? t('project.source-code')
      : link.title;
const t = useTranslations(locale);
const hasRail = !!content && nonNullLinks.length > 0;
const hasBody = !!content || nonNullLinks.length > 0;
const bannerPortrait = (banner?.height ?? 0) > (banner?.width ?? 0);
const contentLang = project?.locale && project.locale !== locale ? project.locale : undefined;
const startMonth = date ? formatMonthYear(parseDate(date as string), locale) : undefined;
const endMonth = finishedDate
  ? formatMonthYear(parseDate(finishedDate as string), locale)
  : undefined;
const dateRange =
  startMonth &&
  (endMonth === startMonth || (!endMonth && !isActive)
    ? startMonth
    : `${startMonth} – ${endMonth ?? t('common.present')}`);
const chipTags = nonNullTags(tags ?? []).filter((tag) => tagSlug(tag));
const pageTitle = `${title ?? t('common.projects')} | ${t('common.name')}`;

if (projectUnavailable) {
  Astro.response.status = 503;
  Astro.response.headers.set('CDN-Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('CDN-Cache-Control', 'public, max-age=86400, must-revalidate');
}
---

<MainLayout
  title={pageTitle}
  description={project?.description || project?.title || t('project.page-heading')}
>
  <Container maxW="breakpoint-xl" py="8" w="full">
    <Box
      bg="var(--atelier-surface-low)"
      p={{ base: '6', md: '10' }}
      border="1px solid"
      borderColor="var(--atelier-line)"
    >
      <Stack gap="8">
        <Link
          href={`/${locale}/projects`}
          display="inline-flex"
          alignItems="center"
          alignSelf="start"
          minH="44px"
        >
          <Wrap
            fontFamily="var(--font-code)"
            fontSize="xs"
            alignItems="center"
            color="var(--atelier-fg-muted)"
            _hover={{ color: 'var(--atelier-accent-soft)' }}
            transition="colors"
          >
            <FaArrowLeft />
            <Text>{t('project.back-to-projects')}</Text>
          </Wrap>
        </Link>
        {
          project ? (
            <>
              <Stack gap="4">
                <Stack gap="2">
                  <Eyebrow label={t('common.projects')} />
                  <Heading
                    as="h1"
                    fontSize={{ base: '5xl', md: '7xl' }}
                    lineHeight="0.95"
                    lang={contentLang}
                  >
                    {title}
                  </Heading>
                  <Wrap
                    fontSize="sm"
                    color="var(--atelier-outline)"
                    fontFamily="var(--font-code)"
                    flexDirection={{ base: 'column', sm: 'row' }}
                    gap={{ base: '1', sm: '2' }}
                  >
                    {category?.name && (
                      <Text color="var(--atelier-fg-muted)" lang={contentLang}>
                        {category.name}
                      </Text>
                    )}
                    {category?.name && dateRange && (
                      <Text aria-hidden="true" display={{ base: 'none', sm: 'inline' }}>
                        |
                      </Text>
                    )}
                    {dateRange && <Text>{dateRange}</Text>}
                  </Wrap>
                </Stack>
                {chipTags.length > 0 && (
                  <HStack alignItems="start">
                    <Text
                      fontWeight="bold"
                      fontSize="sm"
                      color="var(--atelier-fg-muted)"
                      display="flex"
                      alignItems="center"
                      minH="44px"
                    >
                      {t('common.tags')}
                    </Text>
                    <Wrap columnGap="2" rowGap="2" pt="2.5">
                      {chipTags.map((tag) => (
                        <Link
                          href={`/${locale}/tags/${tagSlug(tag)}`}
                          display="inline-flex"
                          alignItems="center"
                          justifyContent="center"
                          minW="44px"
                          position="relative"
                          _before={{
                            content: '""',
                            position: 'absolute',
                            insetBlock: '-10px',
                            insetInline: '0'
                          }}
                        >
                          <TagBadge tag={tag} size="sm" interactive />
                        </Link>
                      ))}
                    </Wrap>
                  </HStack>
                )}
              </Stack>
              {bannerUrl && (
                <Box
                  position="relative"
                  overflow="hidden"
                  border="1px solid"
                  borderColor="var(--atelier-line)"
                >
                  <img
                    src={bannerUrl}
                    alt={
                      banner?.alternativeText?.trim() ||
                      t('project.image-alt').replace('{title}', title ?? '')
                    }
                    onerror="this.style.visibility='hidden';this.nextElementSibling.style.display='grid'"
                    style={{
                      objectFit: bannerPortrait ? 'contain' : 'cover',
                      objectPosition: bannerPortrait ? 'center' : 'top',
                      width: '100%',
                      aspectRatio: '16 / 9',
                      backgroundColor: 'var(--atelier-surface-highest)',
                      filter: 'var(--atelier-image-plate)'
                    }}
                  />
                  <Box
                    position="absolute"
                    inset="0"
                    className="fallback-grid-lines"
                    display="none"
                    placeItems="center"
                    aria-hidden="true"
                  >
                    <Box
                      fontFamily="var(--font-display)"
                      fontStyle="italic"
                      fontSize="96px"
                      lineHeight="1"
                      color="var(--atelier-outline)"
                      opacity="0.3"
                      userSelect="none"
                    >
                      {projectMonogram(title)}
                    </Box>
                  </Box>
                </Box>
              )}

              {hasBody && <Divider borderColor="var(--atelier-line)" />}
              {/* The prose is capped at 70ch for reading, but the links sat above it at full
                  container width, so the article looked left-shoved inside a wider frame with
                  a dead right third. In a rail the measure is deliberate and the column is
                  occupied — the note detail page already reads this way. */}
              {hasBody && (
                <Grid
                  gridTemplateColumns={
                    hasRail
                      ? { base: 'minmax(0, 70ch)', xl: 'minmax(0, 70ch) 280px' }
                      : { base: 'minmax(0, 70ch)' }
                  }
                  gap={{ base: '8', xl: '12' }}
                  justifyContent={{ xl: 'space-between' }}
                  alignItems="start"
                >
                  {links && nonNullLinks.length > 0 && (
                    <Stack
                      gap="2"
                      gridColumn={hasRail ? { xl: '2' } : undefined}
                      gridRow={hasRail ? { xl: '1' } : undefined}
                      position={hasRail ? { xl: 'sticky' } : undefined}
                      top={{ xl: '24' }}
                      minW="0"
                    >
                      <Text
                        className="mono-label"
                        fontFamily="var(--font-code)"
                        fontSize="10px"
                        textTransform="uppercase"
                        letterSpacing="0.12em"
                        color="var(--atelier-outline)"
                        pb="2"
                        borderBottom="1px solid var(--atelier-line)"
                      >
                        {t('project.links')}
                      </Text>
                      {nonNullLinks.map((l) => {
                        return (
                          <LinkItem
                            data={l}
                            eyebrow={linkEyebrow(l)}
                            formatOpen={(host: string) =>
                              t('project.open-host').replace('{host}', host)
                            }
                            newTabLabel={t('note.opens-new-tab')}
                          />
                        );
                      })}
                    </Stack>
                  )}
                  {content && (
                    <Box gridColumn={{ xl: '1' }} gridRow={{ xl: '1' }} minW="0" lang={contentLang}>
                      <Markdown
                        content={content}
                        assetsPrefix={import.meta.env.PUBLIC_API_URL}
                        headingLevelOffset={1}
                        newTabLabel={t('note.opens-new-tab')}
                        linkLabels={knownLinkLabelsFrom(t)}
                        codeLabel={t('common.code-block')}
                        locale={locale}
                      />
                    </Box>
                  )}
                </Grid>
              )}
              {images.length > 0 && (
                <Stack gap="6" pt={{ base: '8', md: '12' }}>
                  <SectionHeading label={t('project.images')} />
                  <Carousel
                    client:visible
                    images={images}
                    imageAlts={galleryImages.map((item) => item.alt)}
                    portrait={galleryPortrait}
                    previousSlideLabel={t('common.carousel-previous')}
                    nextSlideLabel={t('common.carousel-next')}
                    gotoSlideLabel={t('common.carousel-goto')}
                    slideLabel={t('project.image-alt').replace('{title}', title ?? '')}
                    startRotationLabel={t('common.carousel-start')}
                    stopRotationLabel={t('common.carousel-stop')}
                  />
                </Stack>
              )}
            </>
          ) : (
            <Box
              border="1px solid"
              borderColor="var(--atelier-line)"
              p={{ base: '8', md: '12' }}
              textAlign="center"
            >
              <Text
                fontFamily="var(--font-code)"
                fontSize="10px"
                textTransform="uppercase"
                letterSpacing="0.2em"
                color="var(--atelier-outline)"
                mb="4"
              >
                {t('project.status-unavailable')}
              </Text>
              <Heading
                as="h1"
                fontFamily="var(--font-display)"
                fontSize={{ base: '4xl', md: '5xl' }}
                mb="4"
              >
                {t('project.detail-empty-title')}
              </Heading>
              <Text color="var(--atelier-fg-muted)" maxW="md" mx="auto">
                {t('project.detail-empty-description')}
              </Text>
              <Wrap gap="6" justifyContent="center" mt="6">
                <Link
                  href={Astro.url.pathname}
                  display="inline-flex"
                  alignItems="center"
                  minH="44px"
                  className="amber-link"
                >
                  {t('project.reload')}
                </Link>
                <Link
                  href={`/${locale}/about`}
                  display="inline-flex"
                  alignItems="center"
                  minH="44px"
                  className="amber-link"
                >
                  {t('common.about-me')}
                </Link>
              </Wrap>
            </Box>
          )
        }
      </Stack>
    </Box>
  </Container>
</MainLayout>
