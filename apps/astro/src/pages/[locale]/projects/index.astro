---
import { Box, Container, Flex, Grid, Stack, Wrap } from 'styled-system/jsx';
import { resolveMedia } from 'utils/media';
import { Heading } from '~/components/ui/heading';
import { Link } from '~/components/ui/link';
import { Text } from '~/components/ui/text';
import { graphQLSdk } from '~/graphql';
import { useTranslations, validateLocale } from '~/i18n/utils';
import { withLastGood } from '~/utils/cms-cache';
import { pickLocale } from '~/utils/fallbackLocale';
import { projectMonogram } from '~/utils/monogram';
import { groupProjectsByActivity, requireProjects } from '~/utils/project-groups';
import MainLayout from '~/layouts/MainLayout.astro';
import PageMasthead from '~/components/common/PageMasthead.astro';
import SectionHeading from '~/components/common/SectionHeading.astro';

export const prerender = false;

const { locale } = Astro.params;

if (!validateLocale(locale)) {
  return Astro.redirect('/404');
}

let projects: any[] = [];
let projectsUnavailable = false;

try {
  const data = await withLastGood('projects', async () =>
    requireProjects(await graphQLSdk.fetchProjects({ limit: 75 }))
  );
  projects = (data?.projects ?? []).map((p) => pickLocale(p, locale)).filter((p: any) => !!p);
} catch {
  projectsUnavailable = true;
}

const t = useTranslations(locale);
const pageTitle = `${t('common.projects')} | ${t('common.name')}`;

const { active: activeProjects, inactive: inactiveProjects } = groupProjectsByActivity(projects);
const inactiveGridProjects = inactiveProjects.slice(0, 9);
const langOf = (project: { locale?: string | null }) =>
  project.locale && project.locale !== locale ? project.locale : undefined;
type LinkLike = { url?: string | null; type?: string | null } | null;
const linkKinds = (project: { links?: LinkLike[] | null }): string[] =>
  Array.from(
    new Set(
      (project.links ?? [])
        .filter((link: LinkLike) => link?.url)
        .map((link: LinkLike) =>
          link?.type === 'github'
            ? t('project.source-code')
            : link?.type === 'web'
              ? t('project.visit-site')
              : null
        )
        .filter((label: string | null): label is string => !!label)
    )
  );
const latestProjectYear = projects.reduce((latest, project) => {
  const year = project.date?.slice(0, 4);
  return year && year > latest ? year : latest;
}, '----');
const yearPartFormatter = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  timeZone: 'Asia/Tokyo',
  calendar: 'gregory'
});
const yearLabel = (year?: string) =>
  year && /^\d{4}$/.test(year)
    ? (yearPartFormatter
        .formatToParts(new Date(`${year}-01-01T00:00:00+09:00`))
        .find((part) => part.type === 'year')?.value ?? year)
    : year;

if (projectsUnavailable) {
  Astro.response.status = 503;
  Astro.response.headers.set('CDN-Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('CDN-Cache-Control', 'public, max-age=86400, must-revalidate');
}
---

<MainLayout title={pageTitle} description={t('project.intro')}>
  <Container maxW="breakpoint-xl" className="page-shell">
    <Stack py="10" gap="16">
      <PageMasthead
        eyebrow={t('common.projects')}
        heading={t('project.page-heading')}
        lede={t('project.intro')}
      />

      {
        projects.length > 0 && (
          <Grid
            gridTemplateColumns={{ base: 'repeat(3, minmax(0, 1fr))' }}
            gap="1px"
            bg="var(--atelier-line)"
            border="1px solid"
            borderColor="var(--atelier-line)"
          >
            <a
              href={activeProjects.length > 0 ? '#active-projects' : undefined}
              class="project-group-jump"
            >
              <Text
                className="mono-label"
                fontFamily="var(--font-code)"
                fontSize="10px"
                textTransform="uppercase"
                color="var(--atelier-outline)"
              >
                {t('project.active')}
              </Text>
              <Text fontFamily="var(--font-code)" fontSize="3xl" color="var(--atelier-accent)">
                {activeProjects.length}
              </Text>
            </a>
            <a
              href={inactiveProjects.length > 0 ? '#inactive-projects' : undefined}
              class="project-group-jump"
            >
              <Text
                className="mono-label"
                fontFamily="var(--font-code)"
                fontSize="10px"
                textTransform="uppercase"
                color="var(--atelier-outline)"
              >
                {t('project.inactive')}
              </Text>
              <Text fontFamily="var(--font-code)" fontSize="3xl" color="var(--atelier-accent)">
                {inactiveProjects.length}
              </Text>
            </a>
            <Stack bg="var(--atelier-bg)" p="5" gap="2">
              <Text
                className="mono-label"
                fontFamily="var(--font-code)"
                fontSize="10px"
                textTransform="uppercase"
                color="var(--atelier-outline)"
              >
                {t('project.latest')}
              </Text>
              <Text fontFamily="var(--font-code)" fontSize="3xl" color="var(--atelier-accent)">
                {yearLabel(latestProjectYear)}
              </Text>
            </Stack>
          </Grid>
        )
      }

      {
        projects.length === 0 ? (
          <Box
            border="1px solid"
            borderColor="var(--atelier-line)"
            bg="var(--atelier-surface-low)"
            p={{ base: '8', md: '12' }}
          >
            <Stack gap="4" alignItems="center" textAlign="center" py="12">
              <Text
                fontFamily="var(--font-code)"
                fontSize="10px"
                textTransform="uppercase"
                letterSpacing="0.12em"
                color="var(--atelier-outline)"
              >
                {t('project.status-unavailable')}
              </Text>
              <Heading as="h2" fontSize={{ base: '3xl', md: '4xl' }}>
                {t('project.empty-title')}
              </Heading>
              <Text color="var(--atelier-fg-muted)" maxW="md" lineHeight="1.7">
                {t('project.empty-description')}
              </Text>
              <Wrap gap="6" justifyContent="center">
                <Link
                  href={Astro.url.pathname}
                  display="inline-flex"
                  alignItems="center"
                  minH="44px"
                  className="amber-link"
                >
                  {t('project.reload')}
                </Link>
                <Link
                  href={`/${locale}/about`}
                  display="inline-flex"
                  alignItems="center"
                  minH="44px"
                  className="amber-link"
                >
                  {t('common.about-me')}
                </Link>
              </Wrap>
            </Stack>
          </Box>
        ) : (
          <>
            {activeProjects.length > 0 && (
              <Stack gap="10">
                <SectionHeading label={t('project.active')} id="active-projects" />
                <Grid
                  gridTemplateColumns={{ base: 'minmax(0, 1fr)', md: 'repeat(2, minmax(0, 1fr))' }}
                  gap="1px"
                  bg="var(--atelier-line)"
                  border="1px solid"
                  borderColor="var(--atelier-line)"
                >
                  {activeProjects.map((project, index) => {
                    const resolved = resolveMedia(
                      project.media?.[0],
                      500,
                      import.meta.env.PUBLIC_API_URL
                    );
                    const imageUrl = resolved?.src ?? '/images/placeholder-project.jpg';
                    const hasImage = !!project.media?.[0]?.url;
                    // The first card is the measured LCP element on this route (1836ms on
                    // /en, 2648ms on /th) and was deferred behind `loading="lazy"`.
                    const isLcp = index === 0;
                    return (
                      <Link
                        href={`/${locale}/projects/${project.slug}`}
                        aria-labelledby={`active-project-${index}`}
                        display="block"
                        w="full"
                        bg="var(--atelier-bg)"
                        textDecorationLine="none"
                        className="group"
                        _hover={{ bg: 'var(--atelier-surface-lowest)' }}
                        transition="background-color 0.2s ease"
                      >
                        <Stack p="6" h="full" position="relative" overflow="hidden">
                          {hasImage ? (
                            <Box
                              position="relative"
                              aspectRatio="16 / 9"
                              border="1px solid"
                              borderColor="var(--atelier-line)"
                              overflow="hidden"
                              className="image-archival"
                              mb="6"
                            >
                              <img
                                src={imageUrl}
                                alt=""
                                onerror="this.style.display='none';this.nextElementSibling.style.display='grid'"
                                width={resolved?.width ?? 960}
                                height={resolved?.height ?? 540}
                                loading={isLcp ? 'eager' : 'lazy'}
                                fetchpriority={isLcp ? 'high' : undefined}
                                style={{ width: '100%', height: '100%', objectFit: 'cover' }}
                              />
                              <Box
                                position="absolute"
                                inset="0"
                                className="fallback-grid-lines"
                                display="none"
                                placeItems="center"
                                aria-hidden="true"
                              >
                                <Box
                                  fontFamily="var(--font-display)"
                                  fontStyle="italic"
                                  fontSize="96px"
                                  lineHeight="1"
                                  color="var(--atelier-outline)"
                                  opacity="0.3"
                                  userSelect="none"
                                >
                                  {projectMonogram(project.title)}
                                </Box>
                              </Box>
                            </Box>
                          ) : (
                            <Box
                              position="relative"
                              aspectRatio="16 / 9"
                              border="1px solid"
                              borderColor="var(--atelier-line)"
                              overflow="hidden"
                              className="fallback-grid-lines"
                              display="grid"
                              placeItems="center"
                              mb="6"
                              aria-hidden="true"
                            >
                              <Box
                                fontFamily="var(--font-display)"
                                fontStyle="italic"
                                fontSize="96px"
                                lineHeight="1"
                                color="var(--atelier-outline)"
                                opacity="0.3"
                                userSelect="none"
                              >
                                {projectMonogram(project.title)}
                              </Box>
                            </Box>
                          )}
                          <Flex justifyContent="space-between" alignItems="start" mb="2" gap="3">
                            <Heading
                              as="h3"
                              id={`active-project-${index}`}
                              minW="0"
                              fontSize="xl"
                              fontWeight="extrabold"
                              fontStyle="normal"
                              fontFamily="var(--font-body)"
                              transition="color 0.2s ease"
                              className="group-hover-amber group-hover-underline"
                            >
                              {project.title}
                            </Heading>
                            <Text
                              fontFamily="var(--font-code)"
                              fontSize="sm"
                              flexShrink="0"
                              color="var(--atelier-outline)"
                            >
                              {yearLabel(project.date?.slice(0, 4))}
                            </Text>
                          </Flex>
                          {project.category?.name && (
                            <Flex gap="2" mb="4">
                              <Text
                                fontFamily="var(--font-code)"
                                fontSize="10px"
                                textTransform="uppercase"
                                color="var(--atelier-fg-muted)"
                              >
                                {project.category.name}
                              </Text>
                            </Flex>
                          )}
                          {project.tags?.length > 0 && (
                            <Wrap gap="2" columnGap="4" mb="4">
                              {project.tags
                                .filter(Boolean)
                                .slice(0, 3)
                                .map((tag: any) => (
                                  <Text
                                    fontFamily="var(--font-code)"
                                    fontSize="10px"
                                    textTransform="uppercase"
                                    color="var(--atelier-outline)"
                                  >
                                    {tag.title}
                                  </Text>
                                ))}
                            </Wrap>
                          )}
                          <Text
                            color="var(--atelier-fg-muted)"
                            fontSize="sm"
                            lineHeight="1.7"
                            mb="6"
                            lang={langOf(project)}
                          >
                            {project.description}
                          </Text>
                          <Flex
                            gap="2"
                            alignItems="center"
                            mt="auto"
                            className="view-execution-link"
                          >
                            <Text color="var(--atelier-accent)" fontSize="sm" fontWeight="bold">
                              {t('project.open-project')}
                            </Text>
                            <Text
                              color="var(--atelier-accent)"
                              fontSize="sm"
                              transition="margin-left 0.2s ease"
                              className="arrow-icon"
                              aria-hidden="true"
                            >
                              →
                            </Text>
                          </Flex>
                        </Stack>
                      </Link>
                    );
                  })}
                </Grid>
              </Stack>
            )}

            {inactiveProjects.length > 0 && (
              <Stack gap="10">
                <SectionHeading label={t('project.inactive')} id="inactive-projects" />
                <Grid
                  gridTemplateColumns={{ base: 'minmax(0, 1fr)', md: 'repeat(3, minmax(0, 1fr))' }}
                  gap="1px"
                  bg="var(--atelier-line)"
                  border="1px solid"
                  borderColor="var(--atelier-line)"
                >
                  {inactiveGridProjects.map((project, index) => {
                    // `alignItems="stretch"` is load-bearing: Park-UI's Link sets
                    // `align-items: center`, so making this card a flex column to pin its
                    // chip row centred every line inside it.
                    return (
                      <Link
                        href={`/${locale}/projects/${project.slug}`}
                        aria-labelledby={`inactive-project-${index}`}
                        display="flex"
                        flexDirection="column"
                        alignItems="stretch"
                        h="full"
                        w="full"
                        position="relative"
                        overflow="hidden"
                        bg="var(--atelier-bg)"
                        _hover={{ bg: 'var(--atelier-surface-lowest)' }}
                        p="6"
                        textDecorationLine="none"
                        className="group"
                      >
                        <Flex justifyContent="space-between" alignItems="center" mb="2" gap="3">
                          <Heading
                            as="h3"
                            id={`inactive-project-${index}`}
                            minW="0"
                            fontSize="lg"
                            fontWeight="bold"
                            fontStyle="normal"
                            fontFamily="var(--font-body)"
                            className="group-hover-amber group-hover-underline"
                          >
                            {project.title}
                          </Heading>
                          <Text
                            fontFamily="var(--font-code)"
                            fontSize="10px"
                            flexShrink="0"
                            color="var(--atelier-outline)"
                          >
                            {yearLabel(project.date?.slice(0, 4))}
                          </Text>
                        </Flex>
                        {project.category?.name && (
                          <Text
                            fontFamily="var(--font-code)"
                            fontSize="10px"
                            textTransform="uppercase"
                            color="var(--atelier-outline)"
                            mb="2"
                          >
                            {project.category.name}
                          </Text>
                        )}
                        {project.description && (
                          <Text
                            color="var(--atelier-fg-muted)"
                            fontSize="xs"
                            lineHeight="1.7"
                            mb="4"
                            lang={langOf(project)}
                          >
                            {project.description}
                          </Text>
                        )}
                        {linkKinds(project).length > 0 && (
                          <Wrap gap="2" mb="4" mt="auto">
                            <Text
                              fontFamily="var(--font-code)"
                              fontSize="10px"
                              textTransform="uppercase"
                              color="var(--atelier-outline)"
                            >
                              {linkKinds(project).join(' · ')}
                            </Text>
                          </Wrap>
                        )}
                        <Flex
                          gap="2"
                          alignItems="center"
                          mt={linkKinds(project).length > 0 ? undefined : 'auto'}
                        >
                          <Text color="var(--atelier-accent)" fontSize="sm" fontWeight="bold">
                            {t('project.open-project')}
                          </Text>
                          <Text
                            color="var(--atelier-accent)"
                            fontSize="sm"
                            transition="margin-left 0.2s ease"
                            className="arrow-icon"
                            aria-hidden="true"
                          >
                            →
                          </Text>
                        </Flex>
                      </Link>
                    );
                  })}
                </Grid>
              </Stack>
            )}
            {inactiveProjects.length > 9 && (
              <Stack gap="10">
                <SectionHeading label={t('project.earlier-work')} />
                <Stack
                  gap="1px"
                  bg="var(--atelier-line)"
                  border="1px solid"
                  borderColor="var(--atelier-line)"
                >
                  {inactiveProjects.slice(9).map((project, index) => (
                    <Link
                      href={`/${locale}/projects/${project.slug}`}
                      aria-labelledby={`earlier-project-${index}`}
                      display="block"
                      w="full"
                      bg="var(--atelier-surface-low)"
                      p="4"
                      textDecorationLine="none"
                      className="group"
                      _hover={{ bg: 'var(--atelier-bg)' }}
                      transition="background-color 0.2s ease"
                    >
                      <Flex justifyContent="space-between" alignItems="center" gap="4">
                        <Stack gap="1" minW="0" flex="1">
                          <Heading
                            as="h3"
                            id={`earlier-project-${index}`}
                            fontSize="md"
                            fontWeight="bold"
                            fontStyle="normal"
                            fontFamily="var(--font-body)"
                            className="group-hover-amber group-hover-underline"
                            transition="color 0.2s ease"
                          >
                            {project.title}
                          </Heading>
                          {project.category?.name && (
                            <Text
                              fontFamily="var(--font-code)"
                              fontSize="10px"
                              textTransform="uppercase"
                              color="var(--atelier-outline)"
                            >
                              {project.category.name}
                            </Text>
                          )}
                        </Stack>
                        <Flex gap="4" alignItems="center" flexShrink="0">
                          <Text
                            fontFamily="var(--font-code)"
                            fontSize="10px"
                            color="var(--atelier-outline)"
                          >
                            {yearLabel(project.date?.slice(0, 4))}
                          </Text>
                          <Text color="var(--atelier-accent)" fontSize="sm" aria-hidden="true">
                            →
                          </Text>
                        </Flex>
                      </Flex>
                    </Link>
                  ))}
                </Stack>
              </Stack>
            )}
          </>
        )
      }
    </Stack>
  </Container>
</MainLayout>
