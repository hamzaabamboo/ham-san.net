---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { validateLocale } from '~/i18n/utils';

export const prerender = false;

const { locale } = Astro.params;
if (!validateLocale(locale)) return Astro.redirect('/404');

const requestedVariant = Astro.url.searchParams.get('variant');
const initialVariant = ['layout', 'shelf', 'examine', 'atlas'].includes(requestedVariant ?? '')
  ? requestedVariant
  : 'layout';

const variants = {
  layout: {
    label: 'ROOM LAYOUT',
    title: 'One compact room, exact relationships.',
    description:
      'The visual target keeps the two upper-wall openings, centered darts axis, left PC zone, right collection wall, entrance, closet, and clear walking channel in one believable space.',
    image: '/room-concept/room-source-grounded-v4-source-first.png',
    alt: 'Source-grounded 3D room concept showing the owner room layout, two windows, dartboard and plush rack, PC desk, keyboard, collection shelf, penlight grid, towels, table, beanbag and closet.',
  },
  shelf: {
    label: 'SHELF CLOSE-UP',
    title: 'Dense collection, controlled support.',
    description:
      'Thin books, sleeves, framed interruptions, fitted clear acrylic plates, and three stepped riser heights translate the shelf references into bounded assets.',
    image: '/room-concept/shelf-source-grounded-v4-source-first.png',
    alt: 'Source-grounded shelf concept with teal bays, thin manga and magazine runs, folders, clear display boxes, acrylic goods and plushies.',
  },
  examine: {
    label: 'EXAMINE MODE',
    title: 'Subject-led close-up, readable overlay.',
    description:
      'The final runtime can lock movement and bring one shelf bay forward without changing the model. This crop demonstrates the intended focus hierarchy.',
    image: '/room-concept/shelf-source-grounded-v4-source-first.png',
    alt: 'Focused crop of the owner collection shelf with clear acrylic boxes, folders, books and supported display goods.',
  },
} as const;

const atlases = [
  { zone: 'Room shell and openings', file: 'shell-openings', items: 'GEO-SHELL · GEO-BALCONY · GEO-BALCONY-CURTAIN · GEO-REAR-WINDOW · LIT-CEILING' },
  { zone: 'PC wall and keyboard', file: 'pc-keyboard', items: 'PC-DESK · PC-MONITOR · PC-LAPTOP-TABLET · PC-INPUT · PC-SUPPORT · PC-CHAIR · PC-RUBIK · PC-NOTES · PC-NAMECARD · PC-CAMERA · PC-POSTER-NOTES · KEYBOARD-STAND' },
  { zone: 'Darts and plush rack', file: 'darts-plush', items: 'DART-STAND · DART-BOARD · DART-ACCESSORIES · DART-MAT · PLUSH-RACK · NESOBERI' },
  { zone: 'Shelf and collection wall', file: 'shelf-collection', items: 'SHELF-FRAME · SHELF-BOARD · SHELF-TEAL-BACK · BOOK-MANGA · BOOK-MAGAZINE · BOOK-FOLDER · BOOK-ALBUM · ACRYLIC-CASE · ACRYLIC-STAND · ACRYLIC-CONTENTS · SHELF-FRAME-ART · SHELF-TOP-PLUSH · SHELF-INTERACTION' },
  { zone: 'Penlight, towel, and event wall', file: 'display-wall', items: 'PENLIGHT-GRID · PENLIGHT · PENLIGHT-SPILL · LIVE-TOWEL · UCHIWA-FLAG' },
  { zone: 'Center furniture and lower wall', file: 'center-lower', items: 'LOW-TABLE · TABLE-CONTENTS · BEANBAG · CHAIR-MAT · CLOSET · ENTRY · LOWER-POSTER' },
  { zone: 'Hobby objects and content targets', file: 'hobby-objects', items: 'HOBBY-PIANO · HOBBY-YOYO · HOBBY-KENDAMA · HOBBY-CARDISTRY · HOBBY-PENSPIN · HOBBY-RUBIK · HOBBY-TYPING-STENO · HOBBY-MUSIC-TRANSCRIPTION · HOBBY-TROMBONE · HOBBY-POSTURE · HOBBY-DRAWING · HOBBY-GEOGUESSR · HOBBY-CAMERA · EVENT-TICKET' },
] as const;

type Variant = keyof typeof variants;
---

<BaseLayout title="Room render specification | Ham" description="Reference-grounded 3D room render concept gate">
  <main class="concept" data-concept data-variant={initialVariant}>
    <header class="concept-header">
      <div>
        <p class="eyebrow">DESIGN CONCEPT · 2026.09.09</p>
        <h1>Minimal 3D room render specification</h1>
        <p class="lede">Static raster target for owner approval. This is the art-direction gate before native Blender work.</p>
      </div>
      <div class="status-card">
        <span>source order</span>
        <strong>floorplan → owner corrections → room photos → shelf photos</strong>
        <span>status</span>
        <strong>Blender frozen until visual approval</strong>
      </div>
    </header>

    <nav class="variant-nav" aria-label="Concept views">
      {(Object.keys(variants) as Variant[]).map((key, index) => (
        <button type="button" data-variant-button={key} aria-pressed={initialVariant === key}>
          <span>0{index + 1}</span>
          <strong>{variants[key].label}</strong>
          <small>{key === 'layout' ? 'spatial contract' : key === 'shelf' ? 'collection density' : 'focus hierarchy'}</small>
        </button>
      ))}
      <button type="button" data-variant-button="atlas" aria-pressed={initialVariant === 'atlas'}>
        <span>04</span>
        <strong>ITEM ATLASES</strong>
        <small>one panel per model item</small>
      </button>
    </nav>

    <section class="concept-stage" aria-live="polite">
      <div class="stage-meta">
        <span data-current-label>{initialVariant === 'atlas' ? 'ITEM ATLASES' : variants[initialVariant as Variant].label}</span>
        <span>generated raster · not the Blender scene</span>
      </div>

      {(Object.keys(variants) as Variant[]).map((key) => (
        <section class:list={['view', `view--${key}`]} data-variant-view={key} aria-label={variants[key].label}>
          <figure class="render-card">
            <img src={variants[key].image} alt={variants[key].alt} loading={key === 'layout' ? 'eager' : 'lazy'} />
            {key === 'examine' && (
              <div class="examine-panel">
                <p class="panel-kicker">EXAMINE · SHELF BAY 01</p>
                <h2>Clear acrylic shrine</h2>
                <p>Silhouette insert, polished transparent plate, fitted base, rear/middle/front risers.</p>
                <dl>
                  <div><dt>target</dt><dd>acrylic cluster</dd></div>
                  <div><dt>action</dt><dd>click to inspect</dd></div>
                  <div><dt>return</dt><dd>escape / close</dd></div>
                </dl>
              </div>
            )}
            <figcaption>{key === 'layout' ? 'Full room relationship pass' : key === 'shelf' ? 'Shelf asset and density pass' : 'Resident Evil-style focus target'}</figcaption>
          </figure>
          <aside class="view-copy">
            <p class="view-kicker">{variants[key].label}</p>
            <h2>{variants[key].title}</h2>
            <p>{variants[key].description}</p>
            {key === 'layout' && (
              <ul>
                <li>Upper wall: balcony opening · darts stand · second window.</li>
                <li>Left wall: straight PC desk and entrance-side keyboard stand.</li>
                <li>Right wall: dense shelf, penlight grid, live towels.</li>
                <li>Lower wall: entry, poster, sliding closet.</li>
              </ul>
            )}
            {key === 'shelf' && (
              <ul>
                <li>Thin pale spine families, magazines, albums and sleeves.</li>
                <li>Clear acrylic stays transparent and physically supported.</li>
                <li>Three-tier 雛壇 clusters; no identical rows or floating props.</li>
              </ul>
            )}
            {key === 'examine' && (
              <ul>
                <li>Pointer lock and movement freeze happen only after selection.</li>
                <li>HTML overlay carries title, route hint and close action.</li>
                <li>Escape restores the exact previous camera and movement state.</li>
              </ul>
            )}
          </aside>
        </section>
      ))}

      <section class="view view--atlas" data-variant-view="atlas" aria-label="ITEM ATLASES">
        {atlases.map((atlas, index) => (
          <figure class="atlas-card">
            <img src={`/room-concept/room-item-atlas-${atlas.file}.png`} alt={`Item atlas ${index + 1}: ${atlas.zone}. Panels: ${atlas.items}`} loading="lazy" />
            <figcaption>
              <strong>{`0${index + 1} · ${atlas.zone}`}</strong>
              <span>{atlas.items}</span>
            </figcaption>
          </figure>
        ))}
      </section>
    </section>

    <footer class="concept-footer">
      <span>Acceptance: recognizable layout · realistic materials · grounded supports · no mock geometry</span>
      <span>next gate: owner approval → native Blender MCP scene</span>
    </footer>
  </main>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-concept]');
  const label = root?.querySelector<HTMLElement>('[data-current-label]');
  const labels = { layout: 'ROOM LAYOUT', shelf: 'SHELF CLOSE-UP', examine: 'EXAMINE MODE', atlas: 'ITEM ATLASES' } as const;
  type Variant = keyof typeof labels;

  const setVariant = (value: string | undefined) => {
    if (!root || !value || !(value in labels)) return;
    const variant = value as Variant;
    root.dataset.variant = variant;
    if (label) label.textContent = labels[variant];
    root.querySelectorAll<HTMLButtonElement>('[data-variant-button]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.variantButton === variant));
    });
    const url = new URL(window.location.href);
    url.searchParams.set('variant', variant);
    window.history.replaceState({}, '', url);
  };

  root?.querySelectorAll<HTMLButtonElement>('[data-variant-button]').forEach((button) => {
    button.addEventListener('click', () => setVariant(button.dataset.variantButton));
  });

  setVariant(root?.dataset.variant ?? 'layout');
</script>

<style>
  .concept {
    min-height: 100svh;
    padding: clamp(1.25rem, 3vw, 3rem);
    background: var(--atelier-bg);
    color: var(--atelier-fg);
  }

  .concept-header,
  .concept-footer,
  .stage-meta,
  .concept-stage,
  .variant-nav {
    width: min(1180px, 100%);
    margin-inline: auto;
  }

  .concept-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 330px);
    gap: 2rem;
    align-items: end;
    padding-block: 2rem;
    border-bottom: 1px solid var(--atelier-line);
  }

  .eyebrow,
  .view-kicker,
  .panel-kicker,
  .stage-meta,
  .status-card span,
  .concept-footer {
    color: var(--atelier-fg-muted);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  h1 {
    max-width: 760px;
    margin-top: 0.65rem;
    font-size: clamp(2rem, 5vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .lede {
    max-width: 620px;
    margin-top: 1.1rem;
    color: var(--atelier-fg-muted);
    font-size: 1rem;
  }

  .status-card {
    display: grid;
    gap: 0.45rem;
    padding: 1rem;
    border: 1px solid var(--atelier-line);
    background: var(--atelier-surface);
  }

  .status-card strong {
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .variant-nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    padding-block: 1rem;
  }

  .variant-nav button {
    display: grid;
    gap: 0.22rem;
    min-height: 5rem;
    padding: 0.8rem;
    border: 1px solid var(--atelier-line);
    background: var(--atelier-surface);
    color: var(--atelier-fg);
    text-align: left;
    cursor: pointer;
  }

  .variant-nav button[aria-pressed='true'] {
    border-color: var(--atelier-accent);
    box-shadow: inset 0 -3px 0 var(--atelier-accent);
  }

  .variant-nav span,
  .variant-nav small {
    color: var(--atelier-fg-muted);
    font-size: 0.68rem;
  }

  .variant-nav strong {
    font-size: 0.9rem;
  }

  .concept-stage {
    border-top: 1px solid var(--atelier-line);
  }

  .stage-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
  }

  .stage-meta span:first-child {
    color: var(--atelier-accent);
  }

  .view {
    display: none;
    grid-template-columns: minmax(0, 1.65fr) minmax(240px, 0.65fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
  }

  [data-variant='layout'] .view--layout,
  [data-variant='shelf'] .view--shelf,
  [data-variant='examine'] .view--examine {
    display: grid;
  }

  [data-variant='atlas'] .view--atlas {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
  }

  .atlas-card {
    margin: 0;
    border: 1px solid var(--atelier-line);
    background: var(--atelier-surface);
    overflow: hidden;
  }

  .atlas-card img {
    display: block;
    width: 100%;
    height: auto;
  }

  .atlas-card figcaption {
    display: grid;
    gap: 0.35rem;
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 0.8rem;
  }

  .atlas-card figcaption strong {
    color: var(--atelier-fg);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }

  .render-card {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--atelier-line);
    background: var(--atelier-surface);
  }

  .render-card img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .view--shelf .render-card img {
    aspect-ratio: 16 / 10;
  }

  .view--examine .render-card img {
    aspect-ratio: 16 / 10;
    object-position: 50% 14%;
    transform: scale(1.35);
    transform-origin: center;
    filter: saturate(0.82) brightness(0.7);
  }

  figcaption {
    padding: 0.75rem 0.9rem;
    border-top: 1px solid var(--atelier-line);
    color: var(--atelier-fg-muted);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .view-copy {
    display: grid;
    gap: 0.9rem;
    padding-top: 0.25rem;
  }

  .view-copy h2 {
    font-size: clamp(1.35rem, 2.5vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .view-copy > p:not(.view-kicker),
  .view-copy li,
  .examine-panel p {
    color: var(--atelier-fg-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .view-copy ul {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 1rem 0 0 1rem;
    border-top: 1px solid var(--atelier-line);
  }

  .examine-panel {
    position: absolute;
    right: 1rem;
    bottom: 3.5rem;
    width: min(270px, calc(100% - 2rem));
    display: grid;
    gap: 0.55rem;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--atelier-line) 72%, transparent);
    background: color-mix(in srgb, var(--atelier-bg) 88%, transparent);
    backdrop-filter: blur(12px);
  }

  .examine-panel h2 {
    font-size: 1.35rem;
  }

  .examine-panel dl {
    display: grid;
    gap: 0.35rem;
    margin: 0.3rem 0 0;
  }

  .examine-panel dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--atelier-line);
    padding-top: 0.35rem;
  }

  .examine-panel dt,
  .examine-panel dd {
    margin: 0;
    font-size: 0.7rem;
  }

  .examine-panel dt {
    color: var(--atelier-fg-muted);
    text-transform: uppercase;
  }

  .concept-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--atelier-line);
  }

  @media (max-width: 760px) {
    .concept-header,
    .view {
      grid-template-columns: 1fr;
    }

    .variant-nav {
      grid-template-columns: 1fr;
    }

    .concept-footer,
    .stage-meta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
