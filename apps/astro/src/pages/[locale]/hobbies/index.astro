---
import MainLayout from '~/layouts/MainLayout.astro';
import PageMasthead from '~/components/common/PageMasthead.astro';
import { Box, Container, Stack } from 'styled-system/jsx';
import { css, cx } from 'styled-system/css';
import { Heading } from '~/components/ui/heading';
import { Link } from '~/components/ui/link';
import { Text } from '~/components/ui/text';
import { useTranslations, validateLocale } from '~/i18n/utils';
import { withLastGood } from '~/utils/cms-cache';
import { outlineClient, outlineServerUrl } from '~/utils/outline-api';
import { orderHobbyCards } from '~/utils/hobby-cards';
import { getOutlineSettings } from '~/utils/outline-settings';
import { hasExplicitHobbyStatus, parseHobbyContent } from '~/utils/hobby-content';
import { getHobbyRenderedLinks } from '~/utils/hobby-links';
import {
  formatHobbyUpdated,
  getHobbyContentLabel,
  getHobbyCountLabel,
  getHobbyOverviewDescription,
  getHobbyOverviewSummary
} from '~/utils/hobby-labels';
import { getOutlineAssetProxyPath, resolveOutlineAssetUrl } from '~/utils/outline-assets';

export const prerender = false;

const { locale } = Astro.params;

if (!validateLocale(locale)) {
  return Astro.redirect('/404');
}

const t = useTranslations(locale);
const pageTitle = `${t('common.hobbies')} | ${t('common.name')}`;
const monoMetaText = css({
  fontFamily: 'var(--font-code)',
  fontSize: { base: '11px', md: '10px' },
  letterSpacing: '0.08em',
  textTransform: 'uppercase'
});
const thaiMetaText = css({
  fontFamily: 'var(--font-body)',
  fontSize: 'xs',
  letterSpacing: '0',
  textTransform: 'none'
});
const metaTextClass = locale === 'th' ? thaiMetaText : monoMetaText;
const unavailableMetaTextClass =
  locale === 'th'
    ? thaiMetaText
    : cx(
        monoMetaText,
        css({
          letterSpacing: '0.12em'
        })
      );
const hobbyThumbnail = css({
  display: 'block',
  w: 'full',
  h: 'full',
  objectFit: 'cover',
  filter: 'var(--atelier-image-rest)'
});
const hobbyRow = css({
  pos: 'relative',
  textDecorationLine: 'none',
  transition: 'background-color 160ms ease',
  _hover: {
    bg: 'color-mix(in srgb, var(--atelier-accent) 4%, transparent)'
  }
});
const hobbyRowStatic = css({
  '& h2': {
    color: 'var(--atelier-fg-muted)'
  },
  '& [data-embed]': {
    opacity: '0.6'
  }
});
const hobbyCardTitle = css({
  _groupHover: {
    textDecorationLine: 'underline',
    textDecorationColor: 'var(--atelier-accent)',
    textDecorationThickness: '1px',
    textUnderlineOffset: '0.18em'
  }
});
const hobbyVisual = css({
  pos: 'relative',
  display: 'grid',
  placeItems: 'center',
  w: { base: '7.5rem', md: '9rem' },
  maxW: 'full',
  aspectRatio: '4 / 3',
  border: '1px solid var(--atelier-line)',
  bg: 'var(--atelier-bg)',
  overflow: 'hidden',
  '&::before': {
    pos: 'absolute',
    inset: '0',
    content: '""',
    opacity: '0.85'
  },
  '&[data-embed="photo-gallery"]::before': {
    bg: 'radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--atelier-fg) 24%, transparent), transparent 34%), linear-gradient(135deg, color-mix(in srgb, var(--atelier-fg) 13%, transparent), transparent 58%)'
  },
  '&[data-embed="typing-stats"]::before': {
    bg: 'linear-gradient(135deg, color-mix(in srgb, var(--atelier-fg) 20%, transparent), transparent 46%), linear-gradient(315deg, color-mix(in srgb, var(--atelier-fg) 14%, transparent), transparent 52%)'
  },
  '&[data-embed="piano-chords"]::before': {
    bg: 'linear-gradient(135deg, color-mix(in srgb, var(--atelier-fg) 14%, transparent), transparent 42%), linear-gradient(315deg, color-mix(in srgb, var(--atelier-fg) 18%, transparent), transparent 58%)'
  },
  '&[data-embed="darts-board"]::before': {
    bg: 'radial-gradient(circle at 72% 18%, color-mix(in srgb, var(--atelier-fg) 18%, transparent), transparent 34%), linear-gradient(135deg, color-mix(in srgb, var(--atelier-fg) 14%, transparent), transparent 52%)'
  },
  '&[data-embed="rubik-algorithms"]::before': {
    bg: 'linear-gradient(135deg, color-mix(in srgb, var(--atelier-fg) 18%, transparent), transparent 38%), linear-gradient(225deg, color-mix(in srgb, var(--atelier-fg) 14%, transparent), transparent 46%), linear-gradient(315deg, color-mix(in srgb, var(--atelier-fg) 14%, transparent), transparent 54%)'
  },
  '&[data-embed="link-library"]::before': {
    bg: 'linear-gradient(135deg, color-mix(in srgb, var(--atelier-fg) 16%, transparent), transparent 44%), linear-gradient(315deg, color-mix(in srgb, var(--atelier-fg) 12%, transparent), transparent 54%)'
  },
  '&[data-embed="field-notes"]::before': {
    bg: 'linear-gradient(135deg, color-mix(in srgb, var(--atelier-fg) 16%, transparent), transparent 44%), linear-gradient(315deg, color-mix(in srgb, var(--atelier-fg) 9%, transparent), transparent 54%)'
  },
  '&[data-embed="twitter-feed"]::before': {
    bg: 'linear-gradient(135deg, color-mix(in srgb, var(--atelier-fg) 18%, transparent), transparent 46%), linear-gradient(315deg, color-mix(in srgb, var(--atelier-fg) 12%, transparent), transparent 54%)'
  },
  '&[data-visual="image"][data-embed]::before': {
    bg: 'linear-gradient(160deg, color-mix(in srgb, var(--atelier-fg) 14%, transparent), transparent 55%), linear-gradient(180deg, color-mix(in srgb, var(--atelier-bg) 58%, transparent), color-mix(in srgb, var(--atelier-bg) 78%, transparent))',
    opacity: '1',
    zIndex: '1'
  },
  '&[data-visual="glyph"]': {
    boxShadow: 'inset 0 0 0 1px color-mix(in srgb, var(--atelier-fg) 8%, transparent)'
  },
  '&[data-visual="glyph"]::after': {
    pos: 'absolute',
    inset: '0',
    content: '""',
    opacity: '0.9',
    mixBlendMode: 'screen'
  },
  '&[data-embed="photo-gallery"][data-visual="glyph"]::after': {
    bg: 'linear-gradient(90deg, transparent 0 16%, color-mix(in srgb, var(--atelier-fg) 28%, transparent) 16% 18%, transparent 18% 48%, color-mix(in srgb, var(--atelier-fg) 20%, transparent) 48% 50%, transparent 50% 80%, color-mix(in srgb, var(--atelier-fg) 20%, transparent) 80% 82%, transparent 82%), radial-gradient(circle at 48% 50%, transparent 0 13%, color-mix(in srgb, var(--atelier-fg) 34%, transparent) 14% 15%, transparent 16% 24%, color-mix(in srgb, var(--atelier-fg) 18%, transparent) 25% 26%, transparent 27%)'
  },
  '&[data-embed="typing-stats"][data-visual="glyph"]::after': {
    bg: 'linear-gradient(90deg, transparent 0 58%, color-mix(in srgb, var(--atelier-fg) 34%, transparent) 58% 63%, transparent 63% 70%, color-mix(in srgb, var(--atelier-fg) 28%, transparent) 70% 75%, transparent 75% 82%, color-mix(in srgb, var(--atelier-fg) 24%, transparent) 82% 87%, transparent 87%), linear-gradient(0deg, color-mix(in srgb, var(--atelier-fg) 20%, transparent) 0 1px, transparent 1px 25%)'
  },
  '&[data-embed="piano-chords"][data-visual="glyph"]::after': {
    bg: 'linear-gradient(90deg, color-mix(in srgb, var(--atelier-fg) 16%, transparent) 0 9%, transparent 9% 11%, color-mix(in srgb, var(--atelier-fg) 16%, transparent) 11% 20%, transparent 20% 22%, color-mix(in srgb, var(--atelier-fg) 16%, transparent) 22% 31%, transparent 31% 33%, color-mix(in srgb, var(--atelier-fg) 16%, transparent) 33% 42%, transparent 42% 44%, color-mix(in srgb, var(--atelier-fg) 16%, transparent) 44% 53%, transparent 53% 55%, color-mix(in srgb, var(--atelier-fg) 16%, transparent) 55% 64%, transparent 64% 100%), linear-gradient(90deg, transparent 0 17%, color-mix(in srgb, var(--atelier-fg) 42%, transparent) 17% 23%, transparent 23% 31%, color-mix(in srgb, var(--atelier-fg) 42%, transparent) 31% 37%, transparent 37% 49%, color-mix(in srgb, var(--atelier-fg) 42%, transparent) 49% 55%, transparent 55%)',
    backgroundSize: '100% 58%, 100% 34%',
    backgroundPosition: '0 100%, 0 0',
    backgroundRepeat: 'no-repeat'
  },
  '&[data-embed="darts-board"][data-visual="glyph"]::after': {
    bg: 'radial-gradient(circle at 62% 44%, color-mix(in srgb, var(--atelier-fg) 36%, transparent) 0 4%, transparent 5% 16%, color-mix(in srgb, var(--atelier-fg) 24%, transparent) 17% 19%, transparent 20% 31%, color-mix(in srgb, var(--atelier-fg) 24%, transparent) 32% 34%, transparent 35%), linear-gradient(35deg, transparent 0 48%, color-mix(in srgb, var(--atelier-fg) 20%, transparent) 48% 50%, transparent 50%)'
  },
  '&[data-embed="rubik-algorithms"][data-visual="glyph"]::after': {
    bg: 'linear-gradient(90deg, color-mix(in srgb, var(--atelier-fg) 32%, transparent) 0 32%, color-mix(in srgb, var(--atelier-fg) 28%, transparent) 32% 34%, color-mix(in srgb, var(--atelier-fg) 30%, transparent) 34% 66%, color-mix(in srgb, var(--atelier-fg) 24%, transparent) 66% 68%, color-mix(in srgb, var(--atelier-fg) 30%, transparent) 68%), linear-gradient(0deg, transparent 0 31%, color-mix(in srgb, var(--atelier-bg) 78%, transparent) 31% 34%, transparent 34% 64%, color-mix(in srgb, var(--atelier-bg) 78%, transparent) 64% 67%, transparent 67%), linear-gradient(90deg, transparent 0 31%, color-mix(in srgb, var(--atelier-bg) 78%, transparent) 31% 34%, transparent 34% 64%, color-mix(in srgb, var(--atelier-bg) 78%, transparent) 64% 67%, transparent 67%)',
    transform: 'scale(0.58) rotate(-8deg)'
  },
  '&[data-embed="link-library"][data-visual="glyph"]::after': {
    bg: 'radial-gradient(circle at 22% 32%, color-mix(in srgb, var(--atelier-fg) 42%, transparent) 0 5%, transparent 6%), radial-gradient(circle at 70% 24%, color-mix(in srgb, var(--atelier-fg) 34%, transparent) 0 5%, transparent 6%), radial-gradient(circle at 78% 70%, color-mix(in srgb, var(--atelier-fg) 34%, transparent) 0 5%, transparent 6%), radial-gradient(circle at 28% 72%, color-mix(in srgb, var(--atelier-fg) 32%, transparent) 0 5%, transparent 6%), linear-gradient(28deg, transparent 0 48%, color-mix(in srgb, var(--atelier-fg) 24%, transparent) 48% 50%, transparent 50%), linear-gradient(118deg, transparent 0 48%, color-mix(in srgb, var(--atelier-fg) 20%, transparent) 48% 50%, transparent 50%)'
  },
  '&[data-embed="field-notes"][data-visual="glyph"]::after': {
    bg: 'linear-gradient(135deg, transparent 0 24%, color-mix(in srgb, var(--atelier-fg) 18%, transparent) 24% 26%, transparent 26%), linear-gradient(90deg, transparent 0 20%, color-mix(in srgb, var(--atelier-fg) 18%, transparent) 20% 68%, transparent 68%), linear-gradient(0deg, transparent 0 22%, color-mix(in srgb, var(--atelier-fg) 18%, transparent) 22% 24%, transparent 24% 36%, color-mix(in srgb, var(--atelier-fg) 14%, transparent) 36% 38%, transparent 38%)'
  },
  '&[data-embed="twitter-feed"][data-visual="glyph"]::after': {
    bg: 'linear-gradient(90deg, transparent 0 22%, color-mix(in srgb, var(--atelier-fg) 30%, transparent) 22% 26%, transparent 26% 48%, color-mix(in srgb, var(--atelier-fg) 24%, transparent) 48% 52%, transparent 52% 74%, color-mix(in srgb, var(--atelier-fg) 20%, transparent) 74% 78%, transparent 78%), radial-gradient(circle at 50% 44%, color-mix(in srgb, var(--atelier-fg) 26%, transparent) 0 6%, transparent 7%)'
  }
});
const hobbyCardBody = css({
  display: 'grid',
  gap: '4',
  alignContent: 'center',
  minW: '0'
});
// Three columns at md: with everything left-packed the rows used the left 42% of a
// full-width band, leaving twelve identical voids under a divider that runs edge to edge.
const hobbyCardMeta = css({
  display: { base: 'flex', md: 'grid' },
  flexWrap: 'wrap',
  gap: '2',
  color: 'var(--atelier-outline)',
  // Sits in the row's third column at md so the band is spanned edge to edge; below that it
  // wraps under the title with the tile. Fixed tracks, so status / updated / counts land on
  // the same three axes on every row instead of wrapping at a different point per row.
  gridColumn: { base: '1 / -1', md: 'auto' },
  gridTemplateColumns: { md: '7rem 11rem 9rem' },
  // The third axis right-aligns so the widest count chip grows leftward instead of
  // overhanging the rule that every row sits on.
  justifyItems: 'start',
  md: { '& > *:last-child': { justifySelf: 'end' } },
  justifySelf: { md: 'end' },
  alignItems: 'start'
});
const hobbyCardMetaGap = css({
  display: { base: 'none', md: 'block' }
});
const hobbyCardPill = css({
  display: 'inline-flex',
  alignItems: 'center',
  border: '1px solid var(--atelier-line)',
  minH: '2rem',
  px: '3',
  bg: 'color-mix(in srgb, var(--atelier-bg) 72%, transparent)',
  color: 'var(--atelier-fg-muted)',
  whiteSpace: { base: 'normal', md: 'nowrap' },
  overflowWrap: 'anywhere',
  '&[data-status="active"]': {
    borderColor: 'color-mix(in srgb, var(--atelier-accent) 38%, transparent)',
    color: 'var(--atelier-accent-soft)'
  },
  '&[data-status="inactive"]': {
    color: 'var(--atelier-outline)'
  }
});

let hobbiesList: any[] | undefined = undefined;
let hobbiesUnavailable = false;

try {
  hobbiesList = await withLastGood(`hobbies:list:${locale}`, async () => {
    const settings = await getOutlineSettings();
    if (!settings?.['hobbies-collection']) {
      throw new Error('hobbies collection not configured');
    }

    const allDocuments: any[] = [];
    const pageLimit = 100;
    let offset = 0;

    while (true) {
      const res = await outlineClient.POST('/documents.list', {
        body: { collectionId: settings['hobbies-collection'], offset, limit: pageLimit }
      });
      if (!res.response.ok) throw new Error(`documents.list ${res.response.status}`);
      const rows = res.data?.data ?? [];
      allDocuments.push(...rows);
      if (rows.length < (res.data?.pagination?.limit ?? pageLimit)) break;
      offset += rows.length;
    }

    const childrenByParent = new Map<string, { id: string; title: string }[]>();

    allDocuments.forEach((document: any) => {
      if (!document.parentDocumentId) return;
      const children = childrenByParent.get(document.parentDocumentId) ?? [];
      children.push({
        id: document.id,
        title: document.title ?? t('hobbies.untitled')
      });
      childrenByParent.set(document.parentDocumentId, children);
    });

    const rootDocuments = allDocuments.filter((d: any) => !d.parentDocumentId);
    return rootDocuments.map((document: any) => ({
      ...document,
      childPages: childrenByParent.get(document.id) ?? []
    }));
  });
} catch {
  hobbiesUnavailable = true;
}

if (hobbiesUnavailable) {
  Astro.response.status = 503;
  Astro.response.headers.set('CDN-Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('CDN-Cache-Control', 'public, max-age=86400, must-revalidate');
}

const outlineAssetPrefix = outlineServerUrl.replace('/api', '');
const outlineAssetProxyPath = getOutlineAssetProxyPath(locale);
const resolveHobbyAssetUrl = (rawUrl?: string) =>
  resolveOutlineAssetUrl(rawUrl, {
    assetsPrefix: outlineAssetPrefix,
    assetProxyBasePath: outlineAssetProxyPath
  });

const getEmbedType = (hobby: { embeds: { type: string }[] }) =>
  hobby.embeds[0]?.type ?? 'field-notes';
const getHobbyLabel = (hobby: {
  embeds: { type: string }[];
  body?: string;
  images?: string[];
  links?: { href: string; label: string }[];
  childPages?: { id: string; title: string }[];
}) =>
  getHobbyContentLabel({
    hasSource: hasSourceContent(hobby),
    type: getEmbedType(hobby),
    t
  });
const getStatusLabel = (status: 'active' | 'inactive') =>
  status === 'inactive' ? t('hobbies.status-inactive') : t('hobbies.status-active');
const hasSourceContent = (hobby: {
  body?: string;
  images?: string[];
  links?: { href: string; label: string }[];
  childPages?: { id: string; title: string }[];
}) =>
  !!hobby.body?.trim() ||
  !!hobby.images?.length ||
  !!hobby.links?.length ||
  !!hobby.childPages?.length;
const formatUpdated = (date?: string | null) =>
  formatHobbyUpdated({ date, locale, noDateLabel: String(t('hobbies.no-date')) });
const formatNestedDescription = (childPages?: { title: string }[]) => {
  const titles = (childPages ?? []).map((child) => child.title).filter(Boolean);
  const joined = titles.slice(0, 3).join(' / ');
  const hiddenCount = titles.length - 3;
  if (hiddenCount <= 0) return joined;
  return `${joined} ${String(t('hobbies.more-count')).replace('{count}', String(hiddenCount))}`;
};

const hobbies = hobbiesList
  ? orderHobbyCards(
      hobbiesList.map((h) => {
        const content = parseHobbyContent({
          title: h.title,
          text: h.text,
          fallbackUpdatedAt: h.updatedAt ?? h.createdAt
        });
        const childPages = h.childPages ?? [];
        const nestedSummary = formatNestedDescription(childPages);
        const resolvedImages = content.images
          .map(resolveHobbyAssetUrl)
          .filter((image): image is string => !!image);
        const sourced = hasSourceContent({ ...content, images: resolvedImages, childPages });
        return {
          ...h,
          ...content,
          banner: resolveHobbyAssetUrl(content.banner),
          images: resolvedImages,
          description:
            getHobbyOverviewSummary({
              hasSource: sourced,
              value: content.authoredDescription,
              t
            }) ||
            nestedSummary ||
            (sourced ? getHobbyOverviewDescription(t, getEmbedType(content)) : ''),
          sourced,
          updatedLabel: formatUpdated(content.updatedAt),
          childPages
        };
      })
    )
  : [];
---

<MainLayout title={pageTitle} description={t('hobbies.description')}>
  <Container maxW="breakpoint-xl" w="full" py={{ base: '6', md: '10' }} className="page-shell">
    <Stack gap={{ base: '8', md: '10' }}>
      <PageMasthead
        eyebrow={t('common.hobbies')}
        heading={t('hobbies.page-heading')}
        lede={t('hobbies.description')}
      />

      {
        hobbies.length === 0 ? (
          <Box
            border="1px solid"
            borderColor="var(--atelier-line)"
            bg="var(--atelier-bg)"
            p={{ base: '6', md: '8' }}
          >
            <Stack gap="4" py="8">
              <Text className={unavailableMetaTextClass} color="var(--atelier-outline)">
                {hobbiesUnavailable ? t('hobbies.status-unavailable') : t('hobbies.status-empty')}
              </Text>
              <Heading as="h2" fontSize={{ base: '3xl', md: '4xl' }}>
                {hobbiesUnavailable ? t('hobbies.empty-title') : t('hobbies.empty-none-title')}
              </Heading>
              <Text color="var(--atelier-fg-muted)" maxW="md" lineHeight="1.7">
                {hobbiesUnavailable
                  ? t('hobbies.empty-description')
                  : t('hobbies.empty-none-description')}
              </Text>
            </Stack>
          </Box>
        ) : (
          <>
            <Stack gap="0" borderTop="1px solid var(--atelier-line)">
              {hobbies.map((hobby) => {
                const embedType = getEmbedType(hobby);
                const hasModule = hobby.embeds.length > 0;
                const hobbySourced = hasSourceContent(hobby);
                const readableEmbedType =
                  hasModule && hobbySourced ? getHobbyLabel(hobby) : undefined;
                const linkCount = getHobbyRenderedLinks({
                  type: embedType,
                  links: hobby.links ?? [],
                  body: hobby.body,
                  images: hobby.images
                }).length;
                const countLabels = [
                  linkCount
                    ? getHobbyCountLabel({ count: linkCount, locale, type: 'link', t })
                    : null,
                  hobby.childPages?.length
                    ? getHobbyCountLabel({
                        count: hobby.childPages.length,
                        locale,
                        type: 'page',
                        t
                      })
                    : null
                ].filter(Boolean);
                const metaItems = [
                  {
                    label: hasExplicitHobbyStatus(hobby.meta) ? getStatusLabel(hobby.status) : null,
                    status: hobby.status
                  },
                  { label: `${t('hobbies.metric-updated')} ${hobby.updatedLabel}` },
                  { label: countLabels.join(' \u00B7 ') || null }
                ];

                const Row = hobbySourced ? Link : Box;
                const rowProps = hobbySourced ? { href: `/${locale}/hobbies/${hobby.id}` } : {};

                return (
                  <Row
                    {...rowProps}
                    display="grid"
                    gridTemplateColumns={{
                      base: 'auto minmax(0, 1fr)',
                      md: 'minmax(9rem, 10rem) minmax(0, 1fr) auto'
                    }}
                    gap={{ base: '4', md: '7' }}
                    alignItems={{ md: 'center' }}
                    py={{ base: '5', md: '6' }}
                    borderBottom="1px solid var(--atelier-line)"
                    className={hobbySourced ? cx('group', hobbyRow) : hobbyRowStatic}
                  >
                    <Box
                      className={hobbyVisual}
                      data-embed={embedType}
                      data-visual={hobby.banner ? 'image' : 'glyph'}
                    >
                      <Box
                        fontFamily="var(--font-display)"
                        fontStyle="italic"
                        fontSize="76px"
                        lineHeight="1"
                        color="var(--atelier-fg-muted)"
                        opacity="0.92"
                        userSelect="none"
                        aria-hidden="true"
                        gridArea="1 / 1"
                      >
                        {(hobby.title ?? '?').charAt(0).toUpperCase()}
                      </Box>
                      {hobby.banner && (
                        <img
                          src={hobby.banner}
                          alt=""
                          width="640"
                          height="480"
                          class={hobbyThumbnail}
                          loading="lazy"
                          style="grid-area: 1 / 1; position: relative; z-index: 1"
                          onerror="this.closest('[data-visual]')?.setAttribute('data-visual', 'glyph'); this.remove()"
                        />
                      )}
                    </Box>
                    <div class={hobbyCardBody}>
                      {readableEmbedType && (
                        <Text className={metaTextClass} color="var(--atelier-outline)">
                          {readableEmbedType}
                        </Text>
                      )}
                      <Heading
                        as="h2"
                        className={hobbyCardTitle}
                        fontSize={{ base: '2xl', md: '3xl' }}
                        lineHeight="1.15"
                      >
                        {hobby.title}
                      </Heading>
                      {hobby.description && (
                        <Text
                          color="var(--atelier-fg-muted)"
                          lineHeight="1.7"
                          overflowWrap="anywhere"
                        >
                          {hobby.description}
                        </Text>
                      )}
                    </div>
                    <div class={cx(hobbyCardMeta, metaTextClass)}>
                      {metaItems.map((item) =>
                        item.label ? (
                          <span class={hobbyCardPill} data-status={item.status}>
                            {item.label}
                          </span>
                        ) : (
                          <span class={hobbyCardMetaGap} aria-hidden="true" />
                        )
                      )}
                    </div>
                  </Row>
                );
              })}
            </Stack>
          </>
        )
      }
    </Stack>
  </Container>
</MainLayout>
