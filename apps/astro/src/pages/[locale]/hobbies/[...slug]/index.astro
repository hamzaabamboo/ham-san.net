---
import { HobbyInteractiveEmbed } from '~/components/hobbies/HobbyInteractiveEmbed';
import { hobbyStyles } from '~/components/hobbies/hobbyStyles';
import { Markdown } from '~/components/lib/Markdown';
import { useTranslations, validateLocale } from '~/i18n/utils';
import { knownLinkLabelsFrom } from '~/utils/link-label';
import MainLayout from '~/layouts/MainLayout.astro';
import Eyebrow from '~/components/common/Eyebrow.astro';
import {
  getHobbyBodyIntro,
  hasExplicitHobbyStatus,
  parseHobbyContent,
  splitHobbyBodyParts
} from '~/utils/hobby-content';
import { getHobbyDetailResponse } from '~/utils/hobby-detail-response';
import {
  formatHobbyUpdated,
  getHobbyContentLabel,
  getHobbyOverviewDescription,
  getHobbyOverviewSummary
} from '~/utils/hobby-labels';
import { withLastGood } from '~/utils/cms-cache';
import { outlineClient, outlineServerUrl } from '~/utils/outline-api';
import { getOutlineAssetProxyPath, resolveOutlineAssetUrl } from '~/utils/outline-assets';
import { getOutlineSettings } from '~/utils/outline-settings';
import { requireOutlineOk } from '~/utils/outline-response';
import { cx } from 'styled-system/css';

export const prerender = false;

const { locale, slug } = Astro.params;
const slugParts = slug?.replace(/\/$/, '').split('/') ?? [];
const [rootId, maybeDocSegment, childId] = slugParts;

if (!validateLocale(locale)) {
  return Astro.redirect('/404');
}

if (
  !rootId ||
  (slugParts.length !== 1 && !(slugParts.length === 3 && maybeDocSegment === 'doc' && childId))
) {
  return Astro.redirect(`/${locale}/404`);
}

const t = useTranslations(locale);

let cmsUnavailable = false;
let settings: Awaited<ReturnType<typeof getOutlineSettings>>;
try {
  settings = await getOutlineSettings();
} catch {
  cmsUnavailable = true;
}

const documentId = childId ?? rootId;
const fetchHobbyDocument = (collectionId: string, id: string) =>
  outlineClient.POST('/documents.info', { body: { collectionId, id } });
const loadHobbyDocument = (id: string) =>
  withLastGood(
    `hobby:${id}`,
    async () => {
      const request = await fetchHobbyDocument(settings!['hobbies-collection'], id);
      if (request.response.status === 404 || request.response.status === 400) return request;
      return requireOutlineOk(request, 'documents.info');
    },
    (request) => request.response.ok
  );
let data: NonNullable<Awaited<ReturnType<typeof fetchHobbyDocument>>['data']>['data'] | undefined;
let documentStatus: number | undefined;

if (!cmsUnavailable) {
  if (!settings?.['hobbies-collection']) {
    cmsUnavailable = true;
  }
  try {
    if (!settings?.['hobbies-collection']) throw new Error('hobbies collection not configured');
    const documentRequest = await loadHobbyDocument(documentId);
    documentStatus = documentRequest.response.status;
    data = documentRequest.data?.data;
  } catch {
    cmsUnavailable = true;
  }
}

const initialResponse = getHobbyDetailResponse({
  settingsAvailable: !!settings?.['hobbies-collection'],
  documentStatus,
  hasDocument: !!data
});

if (initialResponse.redirectTo404) {
  return Astro.redirect(`/${locale}/404`);
}

cmsUnavailable = initialResponse.status === 503;

if (data && childId && data.parentDocumentId !== rootId && data.parentDocumentId) {
  return Astro.redirect(`/${locale}/hobbies/${data.parentDocumentId}/doc/${childId}`, 301);
}
if (data && !childId && data.parentDocumentId) {
  return Astro.redirect(`/${locale}/hobbies/${data.parentDocumentId}/doc/${rootId}`, 301);
}

let rootTitle: string | undefined;
if (data && childId) {
  try {
    rootTitle = (await loadHobbyDocument(rootId)).data?.data?.title;
  } catch {}
}

const childDocumentsParentId = childId && data?.parentDocumentId ? data.parentDocumentId : data?.id;
let childDocumentsUnavailable = false;
const childDocumentsRequest = data
  ? await withLastGood(`hobby-children:${childDocumentsParentId}`, async () => {
      const request = await outlineClient.POST('/documents.list', {
        body: { parentDocumentId: childDocumentsParentId }
      });
      return requireOutlineOk(request, 'documents.list');
    }).catch(() => {
      childDocumentsUnavailable = true;
      return null;
    })
  : null;
const childDocuments = (childDocumentsRequest?.data?.data ?? []).filter(Boolean);
const backHref = childId ? `/${locale}/hobbies/${rootId}` : `/${locale}/hobbies`;
const backLabel = childId ? t('hobbies.back-to-parent') : t('hobbies.back-to-hobbies');
const content = parseHobbyContent({
  title: data?.title ?? '',
  text: data?.text ?? '',
  fallbackUpdatedAt: data?.updatedAt ?? data?.createdAt
});
const nestedPages = childDocuments.map((child) => ({
  title: child.title ?? t('hobbies.untitled'),
  href: `/${locale}/hobbies/${rootId}/doc/${child.id}`
}));
const hasExplicitStatus = hasExplicitHobbyStatus(content.meta);
const hasSourceContent =
  !!content.body.trim() ||
  content.images.length > 0 ||
  content.links.length > 0 ||
  nestedPages.length > 0;
const effectiveStatus = hasExplicitStatus || hasSourceContent ? content.status : 'inactive';
const nestedTitles = nestedPages.map((child) => child.title).filter(Boolean);
const hiddenNestedCount = nestedTitles.length - 3;
const nestedDescription = [
  nestedTitles.slice(0, 3).join(' / '),
  hiddenNestedCount > 0
    ? String(t('hobbies.more-count')).replace('{count}', String(hiddenNestedCount))
    : ''
]
  .filter(Boolean)
  .join(' ');
const pageTitle = `${[data?.title ?? t('common.hobbies'), childId ? rootTitle : undefined]
  .filter(Boolean)
  .join(' · ')} | ${t('common.name')}`;
const outlineAssetPrefix = outlineServerUrl.replace('/api', '');
const outlineAssetProxyPath = getOutlineAssetProxyPath(locale);
const resolveHobbyAssetUrl = (rawUrl?: string) =>
  resolveOutlineAssetUrl(rawUrl, {
    assetsPrefix: outlineAssetPrefix,
    assetProxyBasePath: outlineAssetProxyPath
  });
const embedType = content.embeds[0]?.type ?? 'field-notes';
const hasModule = content.embeds.length > 0;
const authoredDescription = getHobbyOverviewSummary({
  hasSource: hasSourceContent,
  value: content.description,
  t
});
const detailDescription = authoredDescription || nestedDescription;
const metaDescription =
  authoredDescription ||
  (hasSourceContent ? getHobbyOverviewDescription(t, embedType) : '') ||
  data?.title;
const heroDescription =
  !hasSourceContent ||
  detailDescription === getHobbyBodyIntro(content.body) ||
  (!authoredDescription && childDocuments.length > 0)
    ? ''
    : detailDescription;
const embedLabel = getHobbyContentLabel({ hasSource: hasSourceContent, type: embedType, t });
const statusLabel = hasExplicitStatus
  ? effectiveStatus === 'inactive'
    ? t('hobbies.status-inactive')
    : t('hobbies.status-active')
  : undefined;
const eyebrowLabel =
  [statusLabel, hasModule ? embedLabel : undefined].filter(Boolean).join(' / ') ||
  t('common.hobbies');
const banner = resolveHobbyAssetUrl(content.banner);
const resolvedImages = content.images
  .map((src, index) => ({ src: resolveHobbyAssetUrl(src), alt: content.imageAlts[index] ?? '' }))
  .filter((image): image is { src: string; alt: string } => !!image.src);
const images = resolvedImages.map((image) => image.src);
const imageAlts = resolvedImages.map((image) => image.alt);
const updatedLabel = formatHobbyUpdated({
  date: content.updatedAt,
  locale,
  noDateLabel: String(t('hobbies.no-date'))
});
const bodyParts = splitHobbyBodyParts(content.body, content.embeds.length);
const embedProps = {
  title: data?.title,
  description: detailDescription,
  body: content.sourceBody,
  images,
  imageAlts,
  links: content.links,
  nestedPages,
  emptySourceLabel: t('hobbies.empty-source-description'),
  emptySourceStateLabel: t('hobbies.empty-source-state'),
  nestedSourcePagesLabel: t('hobbies.nested-source-pages'),
  sourceNoteAttachedLabel: t('hobbies.source-note-attached'),
  linkedPhotoSourcesLabel: t('hobbies.linked-photo-sources'),
  noImagesLabel: t('hobbies.no-images'),
  imageLabel: t('hobbies.image-label'),
  noLinksLabel: t('hobbies.no-links'),
  noFeedLabel: t('hobbies.no-feed'),
  noTypingProfilesLabel: t('hobbies.no-typing-profiles'),
  openSourcePageLabel: t('hobbies.open-source-page'),
  noAlgorithmSetsLabel: t('hobbies.no-algorithm-sets'),
  audioUnavailableLabel: t('hobbies.audio-unavailable'),
  playedLabel: t('hobbies.played'),
  audioStartsAfterTapLabel: t('hobbies.audio-starts-after-tap'),
  noChordsLabel: t('hobbies.no-chords'),
  noDartsDataLabel: t('hobbies.no-darts-data'),
  moreLabel: t('hobbies.more-items'),
  status: effectiveStatus
};

const responseState = getHobbyDetailResponse({
  settingsAvailable: !!settings?.['hobbies-collection'],
  documentStatus,
  hasDocument: !!data,
  childDocumentsUnavailable
});
Astro.response.status = responseState.status;
Astro.response.headers.set('CDN-Cache-Control', responseState.cacheControl);
---

<MainLayout title={pageTitle} description={metaDescription}>
  <div class={cx(hobbyStyles.detail, 'page-shell', 'hobby-detail')}>
    <a class={cx(hobbyStyles.detailBack, 'hobby-meta')} href={backHref}>
      <span aria-hidden="true">←</span>
      <span>{backLabel}</span>
    </a>

    {
      cmsUnavailable && (
        <section class={hobbyStyles.detailBody}>
          <div class={hobbyStyles.detailMain}>
            <div class={hobbyStyles.detailPanel}>
              <p class={cx(hobbyStyles.detailPanelTitle, 'hobby-meta')}>
                {t('hobbies.status-unavailable')}
              </p>
              <h1 class={hobbyStyles.detailTitle}>{t('hobbies.empty-title')}</h1>
              <p class={hobbyStyles.detailDescription}>{t('hobbies.empty-description')}</p>
            </div>
          </div>
        </section>
      )
    }

    {
      !cmsUnavailable && (
        <section class={hobbyStyles.detailHero}>
          <div class={hobbyStyles.detailHeadline}>
            <Eyebrow label={eyebrowLabel} />
            <h1 class={hobbyStyles.detailTitle}>{data?.title}</h1>
            {heroDescription && <p class={hobbyStyles.detailDescription}>{heroDescription}</p>}
            <p class={cx(hobbyStyles.detailUpdated, 'hobby-meta')}>
              <span>{t('hobbies.last-updated')}</span>
              <span aria-hidden="true">/</span>
              {content.updatedAt ? (
                <time datetime={content.updatedAt}>{updatedLabel}</time>
              ) : (
                <span>{updatedLabel}</span>
              )}
            </p>
          </div>

          {banner && (
            <div class={hobbyStyles.detailVisual} data-visual="image">
              <img
                src={banner}
                alt=""
                width="1200"
                height="900"
                class={hobbyStyles.detailBanner}
                onerror="this.closest('[data-visual]')?.remove()"
              />
            </div>
          )}
        </section>
      )
    }

    {
      !cmsUnavailable && (
        <section
          class={hobbyStyles.detailBody}
          data-has-aside={childDocuments.length > 0 && bodyParts.length > 0}
        >
          <div class={hobbyStyles.detailMain}>
            {childDocumentsUnavailable && (
              <div class={hobbyStyles.detailPanel}>
                <p class={cx(hobbyStyles.detailPanelTitle, 'hobby-meta')}>
                  {t('hobbies.learning-resources')}
                </p>
                <p class={hobbyStyles.detailDescription}>{t('hobbies.children-unavailable')}</p>
              </div>
            )}
            {bodyParts.length === 0 &&
              childDocuments.length === 0 &&
              !childDocumentsUnavailable && (
                <div class={hobbyStyles.detailPanel}>
                  {/* The hero already carries this sentence as its subtitle; repeating it
                      190px lower in the same face read as an unfiltered dump. The panel
                      title states the condition, so the panel only needs the way out. */}
                  <p class={cx(hobbyStyles.detailPanelTitle, 'hobby-meta')}>
                    {t('hobbies.empty-source-state')}
                  </p>
                  <div class={hobbyStyles.detailNested}>
                    <a href={`/${locale}/hobbies`}>
                      <span>{t('hobbies.back-to-hobbies')}</span>
                      <span class="hobby-meta">{t('common.open')}</span>
                    </a>
                  </div>
                </div>
              )}
            {bodyParts.length === 0 && childDocuments.length > 0 && (
              <nav class={hobbyStyles.detailPanel} aria-labelledby="hobby-related-pages">
                {childId && (
                  <p class={cx(hobbyStyles.detailPanelTitle, 'hobby-meta')}>
                    {t('hobbies.empty-source-state')}
                  </p>
                )}
                <h2 id="hobby-related-pages" class={cx(hobbyStyles.detailPanelTitle, 'hobby-meta')}>
                  {t('hobbies.learning-resources')}
                </h2>
                <ul class={hobbyStyles.detailNested} role="list">
                  {childDocuments.map((child) => (
                    <li>
                      <a
                        href={`/${locale}/hobbies/${rootId}/doc/${child.id}`}
                        aria-current={child.id === data?.id ? 'page' : undefined}
                      >
                        <span>{child.title ?? t('hobbies.untitled')}</span>
                        {child.id !== data?.id && (
                          <span class="hobby-meta">{t('common.open')}</span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}
            {bodyParts.map((part) => {
              if (part.type === 'markdown') {
                return (
                  <div class={hobbyStyles.detailSurface}>
                    <Markdown
                      content={part.content}
                      assetsPrefix={outlineAssetPrefix}
                      assetProxyBasePath={outlineAssetProxyPath}
                      headingLevelOffset={1}
                      newTabLabel={t('note.opens-new-tab')}
                      linkLabels={knownLinkLabelsFrom(t)}
                      codeLabel={t('common.code-block')}
                      locale={locale}
                      tableLabel={t('common.table-region')}
                    />
                  </div>
                );
              }

              const embed = content.embeds[part.index];
              if (!embed) return null;

              return (
                <HobbyInteractiveEmbed
                  client:visible
                  {...embedProps}
                  type={embed.type}
                  moduleTitle={
                    embed.label === embed.type
                      ? getHobbyContentLabel({ hasSource: hasSourceContent, type: embed.type, t })
                      : embed.label
                  }
                  moduleDescription={
                    hasSourceContent
                      ? getHobbyOverviewDescription(t, embed.type)
                      : detailDescription
                  }
                />
              );
            })}
          </div>

          {childDocuments.length > 0 && bodyParts.length > 0 && (
            <aside class={hobbyStyles.detailAside} aria-labelledby="hobby-related-pages-aside">
              <div class={hobbyStyles.detailPanel}>
                <h2
                  id="hobby-related-pages-aside"
                  class={cx(hobbyStyles.detailPanelTitle, 'hobby-meta')}
                >
                  {t('hobbies.learning-resources')}
                </h2>
                <ul class={hobbyStyles.detailNested} role="list">
                  {childDocuments.map((child) => (
                    <li>
                      <a
                        href={`/${locale}/hobbies/${rootId}/doc/${child.id}`}
                        aria-current={child.id === data?.id ? 'page' : undefined}
                      >
                        <span>{child.title ?? t('hobbies.untitled')}</span>
                        {child.id !== data?.id && (
                          <span class="hobby-meta">{t('common.open')}</span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </aside>
          )}
        </section>
      )
    }
  </div>
</MainLayout>
