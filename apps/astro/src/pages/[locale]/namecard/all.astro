---
import { Center, Grid, HStack } from 'styled-system/jsx';
import { NAMECARDS } from '../../../constants/namecard';

import { Namecard } from '~/components/namecard/Namecard';
import { Heading } from '~/components/ui/heading';
import { Link } from '~/components/ui/link';
import { useTranslations, validateLocale } from '~/i18n/utils';
import NamecardLayout from '~/layouts/NamecardLayout.astro';
const { locale } = Astro.params;
if (!validateLocale(locale)) {
  return Astro.redirect('/404');
}
const t = useTranslations(locale);
const pageTitle = `${t('name-card.all-namecards')} | ${t('common.name')}`;
---

<NamecardLayout title={pageTitle}>
  <HStack
    justifyContent="space-between"
    alignItems="center"
    flexWrap="wrap"
    gap="2"
    px="4"
    py="2"
    _print={{ display: 'none' }}
  >
    <Heading as="h1" fontSize="2xl" fontWeight="bold">{t('name-card.all-namecards')}</Heading>
    <Link href={`/${locale}/namecard/default`} minH="44px">
      <span aria-hidden="true">←</span>
      {t('name-card.back-to-namecard')}
    </Link>
  </HStack>
  <p class="scroll-hint">{t('name-card.scroll-hint')}</p>
  <Center
    role="region"
    aria-label={t('name-card.all-namecards')}
    tabIndex={0}
    flex={1}
    h={{
      _print: 'full'
    }}
    w="full"
    overflowX="auto"
    fontFamily={`"M PLUS 1p", "Yu Gothic Medium", "游ゴシック Medium", YuGothic, "游ゴシック体", "ヒラギノ角ゴ Pro", "Hiragino Kaku Gothic Pro", "メイリオ", "Meiryo", sans-serif`}
    bgColor={{ base: 'gray.5', _print: 'none' }}
  >
    <Grid
      printColorAdjust="exact"
      gridTemplateColumns="repeat(auto-fit, minmax(91mm, 1fr))"
      justifyItems="center"
      _print={{
        gap: '0'
      }}
      w="full"
    >
      {
        NAMECARDS.map((namecard) => {
          return (
            <>
              <a
                href={`/${locale}/namecard/${namecard.variant}`}
                aria-label={`${namecard.label} ${t('name-card.front-namecard')}`}
              >
                <Namecard side="front" data={namecard} />
              </a>
              <a
                href={`/${locale}/namecard/${namecard.variant}`}
                aria-label={`${namecard.label} ${t('name-card.back-namecard')}`}
              >
                <Namecard side="back" data={namecard} />
              </a>
            </>
          );
        })
      }
    </Grid>
  </Center>
</NamecardLayout>

<style>
  .scroll-hint {
    display: none;
  }

  @media screen {
    a[aria-label] {
      position: relative;
    }

    a[aria-label]:focus-visible {
      outline-offset: -2px;
    }

    a[aria-label]:focus-visible::after {
      content: '';
      position: absolute;
      inset: 0;
      border: 2px solid currentColor;
      z-index: 3;
      pointer-events: none;
    }
  }

  @media screen and (max-width: 91mm) {
    .scroll-hint {
      display: block;
      margin: 0;
      padding: 0 1rem 0.5rem;
      font-size: 0.875rem;
    }
  }

  @page {
    margin: 0;
    size: 91mm 55mm;
  }
</style>
