---
import { Glyph } from '~/components/ui/glyph';
import { Box, Container, Grid, Stack, Wrap } from 'styled-system/jsx';
import { Heading } from '~/components/ui/heading';
import { Link } from '~/components/ui/link';
import { Text } from '~/components/ui/text';
import { InteractiveNamecard } from '~/components/namecard/InteractiveNamecard';
import { NAMECARDS } from '~/constants/namecard';
import { useTranslations, validateLocale } from '~/i18n/utils';
import MainLayout from '~/layouts/MainLayout.astro';
import Eyebrow from '~/components/common/Eyebrow.astro';
import SectionHeading from '~/components/common/SectionHeading.astro';

export const prerender = false;

const { locale } = Astro.params;

if (!validateLocale(locale)) {
  return Astro.redirect('/404');
}

const t = useTranslations(locale);
const pageTitle = `${t('common.contact')} | ${t('common.name')}`;

// No request-time data on this page; it was previously uncacheable.
Astro.response.headers.set('CDN-Cache-Control', 'public, max-age=86400, must-revalidate');

const EMAIL = 'hello@ham-san.net';

const items = [
  { label: 'GITHUB', value: 'hamzaabamboo', url: 'https://github.com/hamzaabamboo' },
  {
    label: 'LINKEDIN',
    value: 'tvittayapalotai',
    url: 'https://www.linkedin.com/in/tvittayapalotai/'
  },
  { label: 'TWITTER', value: '@HamP_punipuni', url: 'https://twitter.com/HamP_punipuni' },
  { label: 'FACEBOOK', value: 'hamPpunipuni', url: 'https://www.facebook.com/hamPpunipuni' },
  { label: 'DISCORD', value: 'hamp', url: 'https://discordapp.com/users/260776161032798208' },
  {
    label: 'EVENTERNOTE',
    value: 'HamP_punipuni',
    url: 'https://www.eventernote.com/users/HamP_punipuni'
  }
];
---

<MainLayout title={pageTitle} description={t('contact.intro')}>
  <Container w="full" maxW="breakpoint-xl" py="8" className="page-shell">
    <Stack gap="12">
      <Stack gap="4" className="page-header-rule" py="4">
        <Eyebrow label={t('common.contact')} />
        <Heading
          as="h1"
          fontSize={{ base: '5xl', md: '7xl' }}
          lineHeight="tight"
          letterSpacing="tighter"
        >
          {t('contact.hero-prefix') + t('contact.hero-separator')}<Box
            as="span"
            color="var(--atelier-accent)">{t('contact.hero-highlight')}</Box
          >{t('contact.hero-suffix')}
        </Heading>
        <Text color="var(--atelier-fg-muted)" fontSize="xl" maxW="2xl" lineHeight="relaxed" mt="2">
          {t('contact.intro')}
        </Text>
      </Stack>

      <Stack
        bg="var(--atelier-bg)"
        border="1px solid"
        borderColor="var(--atelier-line)"
        p={{ base: '6', md: '8' }}
        gap="2"
        role="region"
        aria-labelledby="contact-direct-heading"
      >
        <Text as="h2" id="contact-direct-heading" className="contact-label" fontWeight="normal">
          {t('contact.direct')}
        </Text>
        <Link
          href={`mailto:${EMAIL}`}
          display="inline-flex"
          alignItems="center"
          minH="44px"
          alignSelf="flex-start"
          fontFamily="var(--font-code)"
          fontSize="sm"
          color="var(--atelier-accent)"
        >
          {EMAIL}
        </Link>
      </Stack>

      <Stack gap="16">
        <Stack gap="12" minW="0">
          <Stack gap="4" role="region" aria-labelledby="contact-social-heading">
            <Text as="h2" id="contact-social-heading" className="contact-label" fontWeight="normal">
              {t('contact.social-connectors')}
            </Text>
            <Grid
              gridTemplateColumns={{
                base: 'repeat(2, minmax(0, 1fr))',
                sm: 'repeat(auto-fit, minmax(min(100%, 320px), 1fr))'
              }}
              gap="2"
            >
              {
                items.map((item) => (
                  <Link
                    href={item.url}
                    target={item.url.startsWith('mailto:') ? undefined : '_blank'}
                    rel={item.url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                    display="flex"
                    flexDirection="column"
                    alignItems="flex-start"
                    border="1px solid"
                    borderColor="var(--atelier-line)"
                    p="4"
                    className="group contact-social-card"
                  >
                    <Text fontWeight="bold" fontSize="sm">
                      {item.label}
                      <Glyph name="open_in_new" className="contact-social-glyph" />
                      <span class="contact-sr-only">{t('note.opens-new-tab')}</span>
                    </Text>
                    <Text
                      fontFamily="var(--font-code)"
                      fontSize="10px"
                      color="var(--atelier-outline)"
                      mt="1"
                      overflowWrap="anywhere"
                    >
                      {item.value}
                    </Text>
                  </Link>
                ))
              }
            </Grid>
          </Stack>
        </Stack>

        <Stack gap="16" minW="0">
          <Stack gap="6" role="region" aria-labelledby="contact-namecards-heading">
            <SectionHeading label={t('contact.namecards')} id="contact-namecards-heading" />
            {
              /* Full width with the variant list beside the card. Capping the stage to 40rem
                left an empty right half under a heading rule that runs edge to edge; leaving
                it uncapped floated a 344px card in a 1120px box. The list gives the space a
                job. */
            }
            <Grid
              className="contact-namecard-stage"
              gridTemplateColumns={{ base: 'minmax(0, 1fr)', md: 'auto minmax(0, 1fr)' }}
              gap={{ base: '6', md: '10' }}
              alignItems="start"
              border="1px solid"
              borderColor="var(--atelier-line)"
              p={{ base: '6', md: '8' }}
              overflow="hidden"
            >
              <Stack gap="3" minW="0">
                <Box maxW="full" className="contact-namecard-preview">
                  <Link
                    href={`/${locale}/namecard/default`}
                    aria-label={`${t('contact.default-card')}: ${NAMECARDS[0].label}`}
                    display="block"
                    w="91mm"
                    h="55mm"
                    className="contact-namecard-link"
                  >
                    <Box aria-hidden="true">
                      <InteractiveNamecard data={NAMECARDS[0]} />
                    </Box>
                  </Link>
                </Box>
                <Text className="contact-label">
                  {t('contact.default-card')}
                </Text>
              </Stack>
              <Stack gap="0" minW="0">
                <Text className="contact-label" pb="3" borderBottom="1px solid var(--atelier-line)">
                  {t('contact.all-cards')}
                </Text>
                {
                  NAMECARDS.map((card) => (
                    <Link
                      href={`/${locale}/namecard/${card.variant}`}
                      display="flex"
                      justifyContent="space-between"
                      alignItems="center"
                      gap="4"
                      minH="44px"
                      borderBottom="1px solid var(--atelier-line)"
                      fontFamily="var(--font-code)"
                      fontSize="xs"
                      color="var(--atelier-fg-muted)"
                      _hover={{ color: 'var(--atelier-accent)' }}
                    >
                      <Text>{card.variant}</Text>
                    </Link>
                  ))
                }
                <Link
                  href={`/${locale}/namecard/all`}
                  display="inline-flex"
                  alignItems="center"
                  minH="44px"
                  className="contact-label"
                  color="var(--atelier-accent)"
                  mt="2"
                >
                  {t('contact.namecard-sheet')}
                </Link>
              </Stack>
            </Grid>
          </Stack>

          <Stack
            border="1px solid"
            borderColor="var(--atelier-line)"
            bg="var(--atelier-surface-lowest)"
            overflow="hidden"
          >
            <Wrap
              justifyContent="space-between"
              alignItems="center"
              px={{ base: '6', md: '8' }}
              py="5"
              borderBottom="1px solid var(--atelier-line)"
            >
              <Heading as="h2" fontSize={{ base: '3xl', md: '4xl' }} fontStyle="normal">
                {t('contact.form-heading')}
              </Heading>
            </Wrap>
            <form
              aria-label={t('contact.form-heading')}
              class="contact-form"
              action={`mailto:${EMAIL}`}
              method="post"
              enctype="text/plain"
            >
              <Grid
                gridTemplateColumns={{ base: 'minmax(0, 1fr)', md: 'repeat(2, minmax(0, 1fr))' }}
                gap="8"
              >
                <Stack gap="2">
                  <label for="contact-name" class="contact-label">
                    {t('contact.field-name')}
                  </label>
                  <input
                    id="contact-name"
                    name="name"
                    type="text"
                    autocomplete="name"
                    class="contact-input"
                    placeholder={t('contact.placeholder-name')}
                    required
                  />
                </Stack>
                <Stack gap="2">
                  <label for="contact-email" class="contact-label">
                    {t('contact.field-email')}
                  </label>
                  <input
                    id="contact-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    spellcheck="false"
                    class="contact-input"
                    placeholder={t('contact.placeholder-email')}
                    required
                  />
                </Stack>
              </Grid>
              <Stack gap="2">
                <label for="contact-subject" class="contact-label">
                  {t('contact.field-subject')}
                </label>
                <select
                  id="contact-subject"
                  name="subject"
                  class="contact-select"
                  autocomplete="off"
                >
                  <option>{t('contact.subject-project')}</option>
                  <option>{t('contact.subject-collaboration')}</option>
                  <option>{t('contact.subject-technical')}</option>
                  <option>{t('contact.subject-other')}</option>
                </select>
              </Stack>
              <Stack gap="2">
                <label for="contact-message" class="contact-label">
                  {t('contact.field-message')}
                </label>
                <textarea
                  id="contact-message"
                  name="message"
                  class="contact-input"
                  autocomplete="off"
                  rows="5"
                  placeholder={t('contact.placeholder-message')}
                  style="min-height: 180px; resize: vertical;"
                  required></textarea>
              </Stack>
              <Stack gap="2">
                <Text className="contact-label">
                  {t('contact.security-brief')}
                </Text>
                <Text color="var(--atelier-fg-muted)" fontSize="sm" lineHeight="relaxed">
                  {t('contact.security-brief-body')}
                </Text>
              </Stack>
              <button class="contact-submit-btn">
                {t('contact.execute-transmission')}
                <Glyph name="send" style={{ fontSize: '16px' }} />
              </button>
              <p class="contact-form-status" role="status" hidden>
                {t('contact.mail-fallback-prefix')}<a href={`mailto:${EMAIL}`}>{EMAIL}</a>{
                  t('contact.mail-fallback-suffix')
                }
              </p>
            </form>
          </Stack>
        </Stack>
      </Stack>

      <Grid gridTemplateColumns="minmax(0, 1fr)" gap="8">
        <Stack
          border="1px solid"
          borderColor="var(--atelier-line)"
          p={{ base: '6', md: '8' }}
          role="region"
          aria-labelledby="contact-replies-heading"
        >
          <Text
            as="h2"
            id="contact-replies-heading"
            className="contact-label"
            fontWeight="normal"
            mb="4"
          >
            {t('contact.office-hours')}
          </Text>
          {
            /* Its sibling card sets the same kind of note in Manrope 14px; this one was
              JetBrains Mono 10px, so two identically framed cards side by side read as two
              different components. Mono stays on the clock, which needs tabular figures. */
          }
          <Text
            fontSize="sm"
            color="var(--atelier-fg-muted)"
            lineHeight="1.7"
            whiteSpace="pre-line"
          >
            {t('contact.office-hours-body')}
          </Text>
          <Text
            id="contact-tokyo-time"
            data-label={t('contact.tokyo-time-label')}
            fontFamily="var(--font-code)"
            fontSize="xs"
            color="var(--atelier-fg-muted)"
            lineHeight="2.2"
          />
        </Stack>
      </Grid>
    </Stack>
  </Container>
</MainLayout>

<script>
  const tokyoFormatter = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Asia/Tokyo',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false
  });

  const updateTokyoTime = () => {
    const el = document.getElementById('contact-tokyo-time');
    if (el) el.textContent = `${el.dataset.label}: ${tokyoFormatter.format(new Date())} JST`;
  };

  const bindContactForm = () => {
    const form = document.querySelector<HTMLFormElement>('.contact-form');
    if (!form || form.dataset.mailtoBound) return;
    form.dataset.mailtoBound = 'true';
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const label = (id: string) =>
        document.querySelector(`label[for="${id}"]`)?.textContent?.trim() ?? '';
      const body = `${label('contact-name')}: ${data.get('name')}\n${label('contact-email')}: ${data.get('email')}\n\n${data.get('message')}`;
      const subject = String(data.get('subject') ?? '');
      window.location.href = `${form.action}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      form.querySelector<HTMLElement>('.contact-form-status')?.removeAttribute('hidden');
    });
  };

  let tokyoTimer: ReturnType<typeof setInterval> | undefined;

  const startTokyoClock = () => {
    clearInterval(tokyoTimer);
    if (!document.getElementById('contact-tokyo-time')) return;
    updateTokyoTime();
    tokyoTimer = setInterval(updateTokyoTime, 60000);
  };

  startTokyoClock();
  bindContactForm();
  document.addEventListener('astro:before-swap', () => clearInterval(tokyoTimer));
  document.addEventListener('astro:page-load', () => {
    startTokyoClock();
    bindContactForm();
  });
</script>

<style>
  .contact-namecard-preview {
    --namecard-scale: min(1, calc((100vw - 82px) / 91mm));
    width: calc(91mm * var(--namecard-scale));
    height: calc(55mm * var(--namecard-scale));
  }

  .contact-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .contact-namecard-link {
    text-decoration: none;
    transform: scale(var(--namecard-scale));
    transform-origin: top left;
  }

  .contact-namecard-preview :global(.card) {
    animation: none;
  }
</style>
