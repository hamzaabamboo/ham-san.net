                  </div>

                  <div class="event-report__panel">
                    <div class="event-report__panel-head">
                      <h3>{t('events.busiest-months')}</h3>
                    </div>
                    <div class="event-report__month-list">
                      {busiestMonths.map((month, index) => (
                        <div class="event-report__month" data-leader={index === 0 || undefined}>
                          <div>
                            <span>{monthLabel(month.month)}</span>
                            <strong>{formatter.format(month.count)}</strong>
                          </div>
                          <i style={`--size: ${(month.count / maxMonthCount) * 100}%`} />
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </section>
            </div>
          </div>
        )
      }
    </section>
  </Container>
</MainLayout>

<script>
  const updateHeatmapMonthLabels = (shell: Element) => {
    const days = shell.querySelector('.event-report__heatmap-days');
    if (!days) return;
    // Read every rect first, then write. Interleaving them forced one synchronous layout
    // per label per scroll event.
    const boundary = days.getBoundingClientRect().right;
    const labels = [...shell.querySelectorAll<HTMLElement>('.event-report__heatmap-months span')];
    const hidden = labels.map((label) => label.getBoundingClientRect().left < boundary);
    labels.forEach((label, index) => {
      label.style.visibility = hidden[index] ? 'hidden' : '';
    });
  };

  const coalesce = (fn: () => void) => {
    let ticking = false;
    return () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        fn();
      });
    };
  };

  const scrollHeatmaps = () => {
    document.querySelectorAll('.event-report__heatmap-shell').forEach((shell) => {
      shell.scrollLeft = shell.scrollWidth;
      updateHeatmapMonthLabels(shell);
      if (!(shell as HTMLElement).dataset.monthLabelsBound) {
        (shell as HTMLElement).dataset.monthLabelsBound = 'true';
        shell.addEventListener(
          'scroll',
          coalesce(() => updateHeatmapMonthLabels(shell)),
          {
            passive: true
          }
        );
      }
    });
  };

  const narrowRail = window.matchMedia('(max-width: 1080px)');
  const foldRailOnNarrow = () => {
    document.querySelectorAll<HTMLDetailsElement>('[data-rail-fold]').forEach((fold) => {
      fold.open = !narrowRail.matches;
    });
  };
  narrowRail.addEventListener('change', foldRailOnNarrow);

  scrollHeatmaps();
  foldRailOnNarrow();
  document.addEventListener('astro:page-load', () => {
    scrollHeatmaps();
    foldRailOnNarrow();
  });
</script>
