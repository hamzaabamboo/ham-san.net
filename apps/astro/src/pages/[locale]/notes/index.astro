---
import { Box, Container, Grid, Stack, Wrap, styled } from 'styled-system/jsx';
import { Heading } from '~/components/ui/heading';
import { Link } from '~/components/ui/link';
import { Text } from '~/components/ui/text';
import { useTranslations, validateLocale } from '~/i18n/utils';
import MainLayout from '~/layouts/MainLayout.astro';
import PageMasthead from '~/components/common/PageMasthead.astro';
import { withFreshLastGoodState } from '~/utils/cms-cache';
import { makeExcerpt } from '~/utils/excerpt';
import { outlineClient } from '~/utils/outline-api';
import { requireOutlineOk } from '~/utils/outline-response';
import { retryOnce } from '~/utils/retry';

export const prerender = false;

const PAGE_SIZE = 11;

const { locale } = Astro.params;

if (!validateLocale(locale)) {
  return Astro.redirect('/404');
}

const rawPage = Astro.url.searchParams.get('page');
const parsedPage = rawPage === null ? 1 : Number(rawPage);
if (rawPage !== null && (!Number.isInteger(parsedPage) || parsedPage < 1)) {
  return Astro.redirect(`/${locale}/notes`);
}
const page = parsedPage;

const headers = {
  Authorization: undefined as unknown as 'Bearer hoge'
};
const t = useTranslations(locale);

const fetchSharePage = async (offset: number, pageLimit: number) => {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 5000);
  try {
    return await outlineClient.POST('/shares.list', {
      body: {
        sort: 'createdAt',
        direction: 'DESC',
        limit: pageLimit,
        offset
      },
      headers,
      signal: controller.signal
    });
  } finally {
    clearTimeout(timeout);
  }
};

const fetchAllShares = async () => {
  const shares: any[] = [];
  const pageLimit = 100;
  let offset = 0;
  while (true) {
    const shareRequest = await retryOnce(async () =>
      requireOutlineOk(await fetchSharePage(offset, pageLimit), 'shares.list')
    );
    const rows = shareRequest.data?.data ?? [];
    shares.push(...rows);
    if (rows.length < (shareRequest.data?.pagination?.limit ?? pageLimit)) break;
    offset += rows.length;
  }
  return shares;
};

let sharedArticlesList: any[] | undefined = undefined;
let notesFromLastGood = false;
try {
  const result = await withFreshLastGoodState('notes:list', fetchAllShares);
  sharedArticlesList = result.value;
  notesFromLastGood = result.fromCache;
} catch {
  sharedArticlesList = undefined;
}

const noteDateOf = (article: { documentCreatedAt?: string; createdAt?: string }) =>
  article.documentCreatedAt ?? article.createdAt;
const noteTimeOf = (article: { documentCreatedAt?: string; createdAt?: string }) =>
  Date.parse(noteDateOf(article) ?? '') || 0;
const allArticles = (sharedArticlesList ?? [])
  .filter(Boolean)
  .sort((a, b) => noteTimeOf(b) - noteTimeOf(a));
if (sharedArticlesList && allArticles.length > 0) {
  const lastPage = Math.ceil(allArticles.length / PAGE_SIZE);
  if (page > lastPage) {
    return Astro.redirect(
      lastPage === 1 ? `/${locale}/notes` : `/${locale}/notes?page=${lastPage}`
    );
  }
}
const visibleArticles = allArticles.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const hasNextPage = allArticles.length > page * PAGE_SIZE;
const hasPrevPage = page > 1;
const showHero = page === 1;
const collectionCount = new Set(
  allArticles.map((article) => article.collectionName).filter(Boolean)
).size;
const lastPageNumber = Math.max(1, Math.ceil(allArticles.length / PAGE_SIZE));
const noteDateFormatter = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'long',
  timeZone: 'Asia/Tokyo',
  calendar: 'gregory'
});
const formatNoteDate = (value?: string) =>
  value ? noteDateFormatter.format(new Date(value)) : null;
const latestMonthParts = allArticles[0]?.documentCreatedAt ?? allArticles[0]?.createdAt;
const latestNoteDate = latestMonthParts
  ? new Intl.DateTimeFormat(locale, {
      year: 'numeric',
      month: '2-digit',
      timeZone: 'Asia/Tokyo',
      calendar: 'gregory'
    })
      .formatToParts(new Date(latestMonthParts))
      .reduce<Record<string, string>>((acc, part) => ({ ...acc, [part.type]: part.value }), {})
  : null;
const latestNoteLabel = latestNoteDate ? `${latestNoteDate.year}/${latestNoteDate.month}` : '----';
const pageOfLabel = t('note.page-of')
  .replace('{n}', String(page))
  .replace('{m}', String(lastPageNumber));
const pageTitle =
  page > 1
    ? `${t('common.note')} · ${pageOfLabel} | ${t('common.name')}`
    : `${t('common.note')} | ${t('common.name')}`;
const pageOfAlign = hasPrevPage && hasNextPage ? 'center' : hasNextPage ? 'end' : 'start';

Astro.response.headers.set(
  'CDN-Cache-Control',
  sharedArticlesList && !notesFromLastGood
    ? 'public, max-age=86400, must-revalidate'
    : 'public, max-age=60, must-revalidate'
);
---

<MainLayout title={pageTitle} description={t('note.description')}>
  <Container maxW="breakpoint-xl" w="full" className="page-shell">
    <Stack py="8" gap="10">
      <PageMasthead
        eyebrow={t('common.note')}
        heading={t('note.notes')}
        lede={t('note.description')}
      />
      {
        !sharedArticlesList || visibleArticles.length === 0 ? (
          <Box
            border="1px solid"
            borderColor="var(--atelier-line)"
            bg="var(--atelier-surface-low)"
            p={{ base: '8', md: '12' }}
          >
            <Stack gap="4" alignItems="center" textAlign="center" py="12">
              <Text
                className="mono-label"
                fontFamily="var(--font-code)"
                fontSize="10px"
                textTransform="uppercase"
                letterSpacing="0.12em"
                color="var(--atelier-outline)"
              >
                {sharedArticlesList ? t('note.status-empty') : t('note.status-unavailable')}
              </Text>
              <Heading as="h2" fontSize={{ base: '3xl', md: '4xl' }}>
                {sharedArticlesList ? t('note.empty-none-title') : t('note.empty-title')}
              </Heading>
              <Text color="var(--atelier-fg-muted)" maxW="md" lineHeight="1.7">
                {sharedArticlesList
                  ? t('note.empty-none-description')
                  : t('note.empty-description')}
              </Text>
              <Wrap gap="3" justify="center">
                {!sharedArticlesList && (
                  <a
                    href={`${Astro.url.pathname}${Astro.url.search}`}
                    class="notes-pagination-link card-hover-amber"
                  >
                    {t('note.reload')}
                  </a>
                )}
                <a href={`/${locale}/projects`} class="notes-pagination-link card-hover-amber">
                  {t('common.projects')}
                </a>
              </Wrap>
            </Stack>
          </Box>
        ) : (
          <>
            <Grid
              gridTemplateColumns={{ base: 'repeat(3, minmax(0, 1fr))' }}
              gap="1px"
              bg="var(--atelier-line)"
              border="1px solid"
              borderColor="var(--atelier-line)"
            >
              <Stack bg="var(--atelier-bg)" p="5" gap="2">
                <Text
                  className="mono-label"
                  fontFamily="var(--font-code)"
                  fontSize="10px"
                  textTransform="uppercase"
                  color="var(--atelier-outline)"
                >
                  {t('note.total-notes')}
                </Text>
                <Text fontFamily="var(--font-code)" fontSize="3xl" color="var(--atelier-accent)">
                  {allArticles.length}
                </Text>
              </Stack>
              <Stack className="note-signal-card" p="5" gap="2">
                <Text
                  className="mono-label"
                  fontFamily="var(--font-code)"
                  fontSize="10px"
                  textTransform="uppercase"
                  color="var(--atelier-outline)"
                >
                  {t('note.collections')}
                </Text>
                <Text fontFamily="var(--font-code)" fontSize="3xl" color="var(--atelier-accent)">
                  {collectionCount}
                </Text>
              </Stack>
              <Stack bg="var(--atelier-bg)" p="5" gap="2">
                <Text
                  className="mono-label"
                  fontFamily="var(--font-code)"
                  fontSize="10px"
                  textTransform="uppercase"
                  color="var(--atelier-outline)"
                >
                  {t('note.latest')}
                </Text>
                <Text
                  fontFamily="var(--font-code)"
                  fontSize={{ base: 'lg', md: '3xl' }}
                  color="var(--atelier-accent)"
                  whiteSpace="nowrap"
                >
                  {latestNoteLabel}
                </Text>
              </Stack>
            </Grid>
            <Stack gap="4">
              {page > 1 && (
                <Text
                  className="mono-label"
                  fontFamily="var(--font-code)"
                  fontSize="xs"
                  color="var(--atelier-outline)"
                >
                  {pageOfLabel}
                </Text>
              )}
              {showHero &&
                visibleArticles.slice(0, 1).map((data) => {
                  const { id, documentTitle, collectionName, documentSummary } =
                    data as typeof data & {
                      collectionName: string;
                      documentSummary: string;
                    };
                  const noteDate = formatNoteDate(noteDateOf(data));
                  const excerpt = makeExcerpt(documentSummary, 220);

                  return (
                    <Link
                      href={`/${locale}/notes/${id}`}
                      aria-labelledby={`note-title-${id}`}
                      display="block"
                      w="full"
                      minW="0"
                      textDecorationLine="none"
                      className="group"
                    >
                      <Box
                        border="1px solid"
                        borderColor="var(--atelier-line)"
                        p={{ base: '6', md: '10' }}
                        w="full"
                        _hover={{ transform: 'translate(-2px, -2px)' }}
                        transition="transform 0.2s ease"
                        className="card-hover-amber note-feature-card"
                      >
                        <Stack gap={4}>
                          <Text
                            className="mono-label"
                            fontFamily="var(--font-code)"
                            fontSize="10px"
                            textTransform="uppercase"
                            letterSpacing="0.12em"
                            color="var(--atelier-accent)"
                          >
                            {t('note.latest-note')}
                          </Text>
                          <Heading
                            as="h2"
                            id={`note-title-${id}`}
                            fontSize={{ base: '4xl', md: '5xl' }}
                            lineHeight="0.95"
                            overflowWrap="anywhere"
                            className="group-hover-underline"
                          >
                            {documentTitle ?? t('note.untitled')}
                          </Heading>
                          <Wrap
                            fontSize="sm"
                            color="var(--atelier-outline)"
                            fontFamily="var(--font-code)"
                          >
                            <Text>{collectionName}</Text>
                            <span aria-hidden="true"> | </span>
                            <Text>{noteDate}</Text>
                          </Wrap>
                          {excerpt && (
                            <Text
                              color="var(--atelier-fg-muted)"
                              maxW="3xl"
                              fontSize="md"
                              lineHeight="1.7"
                            >
                              {excerpt}
                            </Text>
                          )}
                        </Stack>
                      </Box>
                    </Link>
                  );
                })}
              <Grid
                gap="4"
                gridTemplateColumns={{ base: 'minmax(0, 1fr)', md: 'repeat(2, minmax(0, 1fr))' }}
              >
                {(showHero ? visibleArticles.slice(1) : visibleArticles).map(
                  (data, index, cards) => {
                    const { id, documentTitle, collectionName, documentSummary } =
                      data as typeof data & {
                        collectionName: string;
                        documentSummary: string;
                      };
                    const noteDate = formatNoteDate(noteDateOf(data));
                    const excerpt = makeExcerpt(documentSummary, 100);
                    const spansRow = cards.length % 2 === 1 && index === cards.length - 1;

                    return (
                      <Link
                        href={`/${locale}/notes/${id}`}
                        aria-labelledby={`note-title-${id}`}
                        display="block"
                        w="full"
                        h="full"
                        minW="0"
                        style={spansRow ? { gridColumn: '1 / -1' } : undefined}
                        textDecorationLine="none"
                        className="group"
                      >
                        <Box
                          border="1px solid"
                          borderColor="var(--atelier-line)"
                          p="6"
                          h="full"
                          _hover={{ transform: 'translate(-2px, -2px)' }}
                          transition="transform 0.2s ease"
                          className="card-hover-amber note-signal-card"
                        >
                          {/* Cards are height-matched per row but their content was not, so
                              a card without an excerpt left 90-130px dead at the bottom while
                              its row partner filled. The meta line anchors to the bottom, so
                              every card in a row shares one baseline. */}
                          <Stack gap={3} h="full">
                            <Heading
                              as="h2"
                              id={`note-title-${id}`}
                              fontSize={{ base: '2xl', md: '3xl' }}
                              overflowWrap="anywhere"
                              className="group-hover-underline"
                            >
                              {documentTitle ?? t('note.untitled')}
                            </Heading>
                            {excerpt && (
                              <Text color="var(--atelier-fg-muted)" fontSize="sm">
                                {excerpt}
                              </Text>
                            )}
                            <Wrap
                              fontSize="sm"
                              color="var(--atelier-outline)"
                              fontFamily="var(--font-code)"
                              mt="auto"
                            >
                              <Text>{collectionName}</Text>
                              <span aria-hidden="true"> | </span>
                              <Text>{noteDate}</Text>
                            </Wrap>
                          </Stack>
                        </Box>
                      </Link>
                    );
                  }
                )}
              </Grid>
            </Stack>
            {(hasPrevPage || hasNextPage) && (
              <styled.nav aria-label={t('note.pagination')} display="flex" flexDir="column" gap="3">
                <Text
                  fontFamily="var(--font-code)"
                  fontSize="xs"
                  color="var(--atelier-outline)"
                  textAlign={pageOfAlign}
                >
                  {pageOfLabel}
                </Text>
                <Box
                  className={
                    hasPrevPage && hasNextPage
                      ? 'notes-pagination notes-pagination-between'
                      : hasNextPage
                        ? 'notes-pagination notes-pagination-end'
                        : 'notes-pagination notes-pagination-start'
                  }
                  display="flex"
                  alignItems="center"
                  pt="4"
                  borderTopWidth="1px"
                  borderTopStyle="solid"
                  borderTopColor="var(--atelier-line)"
                >
                  {hasPrevPage && (
                    <a
                      href={page === 2 ? `/${locale}/notes` : `/${locale}/notes?page=${page - 1}`}
                      rel="prev"
                      class="notes-pagination-link card-hover-amber"
                    >
                      <span aria-hidden="true">←</span> {t('note.newer-notes')}
                    </a>
                  )}
                  {hasNextPage && (
                    <a
                      href={`/${locale}/notes?page=${page + 1}`}
                      rel="next"
                      class="notes-pagination-link card-hover-amber"
                    >
                      {t('note.older-notes')} <span aria-hidden="true">→</span>
                    </a>
                  )}
                </Box>
              </styled.nav>
            )}
          </>
        )
      }
    </Stack>
  </Container>
</MainLayout>
