---
import { Glyph } from '~/components/ui/glyph';
import { Box, Container, Grid, Stack, styled } from 'styled-system/jsx';
import { cleanArticleContent, getArticleBanner, getArticleBannerAlt } from 'outline/article';
import { Heading } from '~/components/ui/heading';
import { Markdown, createHeadingSlugger, isStructuralLine } from '~/components/lib/Markdown';
import { Text } from '~/components/ui/text';
import { useTranslations, validateLocale } from '~/i18n/utils';
import { knownLinkLabelsFrom } from '~/utils/link-label';
import MainLayout from '~/layouts/MainLayout.astro';
import Eyebrow from '~/components/common/Eyebrow.astro';
import { withLastGood } from '~/utils/cms-cache';
import { outlineClient, outlineServerUrl } from '~/utils/outline-api';
import { requireOutlineOk } from '~/utils/outline-response';

export const prerender = false;

const { locale } = Astro.params;
const slugParts = Astro.params.slug?.replace(/\/$/, '').split('/') ?? [];

if (!validateLocale(locale)) {
  return Astro.redirect('/404');
}

const t = useTranslations(locale);
const [shareId, maybeDocSegment, maybeDocId] = slugParts;
const outlineAssetPrefix = outlineServerUrl.replace('/api', '');
const outlineAssetProxyPath = `/${locale}/api/outline-asset`;
const unitGap = locale === 'ja' ? '' : ' ';
const numberFormatter = new Intl.NumberFormat(locale);
const resolveOutlineAssetUrl = (rawUrl?: string) => {
  if (!rawUrl) return rawUrl;
  if (/^(?:[a-z]+:)?\/\//i.test(rawUrl) || rawUrl.startsWith('data:')) return rawUrl;
  if (rawUrl.includes('attachments.redirect')) {
    const query = rawUrl.split('?')[1];
    return query ? `${outlineAssetProxyPath}?${query}` : outlineAssetProxyPath;
  }
  const normalizedUrl = rawUrl.startsWith('/') ? rawUrl : `/${rawUrl.replace(/^\.?\/*/, '')}`;
  return `${outlineAssetPrefix}${normalizedUrl}`;
};

if (!shareId) {
  return Astro.redirect(`/${locale}/notes`);
}

let note: any = null;
let noteMissing = !(
  slugParts.length === 1 ||
  (slugParts.length === 3 && maybeDocSegment === 'doc' && !!maybeDocId)
);
let noteUnavailable = false;

try {
  const noteRequest = noteMissing
    ? null
    : await withLastGood(
        `note:${shareId}:${maybeDocId ?? ''}`,
        async () => {
          const request = await outlineClient.POST('/documents.info', {
            body:
              maybeDocSegment === 'doc' && maybeDocId ? { shareId, id: maybeDocId } : { shareId }
          });
          if (!request.response.ok && ![400, 403, 404].includes(request.response.status)) {
            throw new Error(`documents.info ${request.response.status}`);
          }
          return request;
        },
        (request) => request.response.ok
      );

  if (noteRequest?.response.ok && noteRequest.data?.data) {
    note = noteRequest.data.data;
  } else if (noteRequest && [400, 403, 404].includes(noteRequest.response.status)) {
    noteMissing = true;
  }
} catch {
  note = null;
  noteUnavailable = true;
}

if (noteMissing) {
  Astro.response.status = 404;
} else if (noteUnavailable) {
  Astro.response.status = 503;
}

const stateTitle = noteMissing ? t('note.not-found-title') : t('note.detail-unavailable-title');
const stateDescription = noteMissing
  ? t('note.not-found-description')
  : t('note.detail-unavailable-description');
const pageTitle = `${note ? (note.title ?? t('common.note')) : stateTitle} | ${t('common.name')}`;
const rawContent = note ? (cleanArticleContent(note.text) ?? '') : '';
const bannerRaw = getArticleBanner(rawContent);
const banner = resolveOutlineAssetUrl(bannerRaw ?? undefined);
const bannerAlt = getArticleBannerAlt(rawContent);
const content = bannerRaw
  ? rawContent.replace(/!\[.*?\]\((.+?)(?:".*?")?\)/, '').replace(/^\s*\n+/, '')
  : rawContent;

const isChildDocument = maybeDocSegment === 'doc' && !!maybeDocId;
const fetchShareDocument = (id?: string) =>
  withLastGood(
    `note:${shareId}:${id ?? ''}`,
    async () =>
      requireOutlineOk(
        await outlineClient.POST('/documents.info', { body: id ? { shareId, id } : { shareId } }),
        'documents.info'
      ),
    (request) => request.response.ok
  )
    .then((request) => request.data?.data ?? null)
    .catch(() => null);
const parentNote =
  isChildDocument && note?.parentDocumentId
    ? await Promise.all([fetchShareDocument(), fetchShareDocument(note.parentDocumentId)]).then(
        ([root, parent]) =>
          parent?.title
            ? {
                title: parent.title as string,
                href:
                  root?.id === parent.id
                    ? `/${locale}/notes/${shareId}`
                    : `/${locale}/notes/${shareId}/doc/${parent.id}`
              }
            : null
      )
    : null;
const siblingsParentId = isChildDocument ? note?.parentDocumentId : note?.id;
let siblingsUnavailable = false;
const siblingsRequest = note
  ? await withLastGood(`note-siblings:${siblingsParentId}`, async () => {
      const request = await outlineClient.POST('/documents.list', {
        body: { parentDocumentId: siblingsParentId }
      });
      return requireOutlineOk(request, 'documents.list');
    }).catch(() => {
      siblingsUnavailable = true;
      return null;
    })
  : null;

const collectionRequest = note?.collectionId
  ? await withLastGood(`note-collection:${note.collectionId}`, async () => {
      const request = await outlineClient.POST('/collections.info', {
        body: { id: note.collectionId }
      });
      return requireOutlineOk(request, 'collections.info');
    }).catch(() => null)
  : null;
const collectionName = collectionRequest?.data?.data?.name ?? null;

type TreeNode = { id: string; title?: string; children?: TreeNode[] };
const collectionTree: TreeNode[] | null = note?.collectionId
  ? await withLastGood(
      `collection-tree:${note.collectionId}`,
      async () =>
        requireOutlineOk(
          await outlineClient.POST('/collections.documents', { body: { id: note.collectionId } }),
          'collections.documents'
        ),
      (request) => request.response.ok
    )
      .then((request) => (request.data?.data as TreeNode[] | undefined) ?? null)
      .catch(() => null)
  : null;
const findTreeNode = (nodes: TreeNode[] | null | undefined, id?: string): TreeNode | undefined => {
  for (const node of nodes ?? []) {
    if (node.id === id) return node;
    const found = findTreeNode(node.children, id);
    if (found) return found;
  }
  return undefined;
};
const authoredOrder = (findTreeNode(collectionTree, siblingsParentId)?.children ?? []).map(
  (child) => child.id
);
const orderIndex = (id?: string) => {
  const index = id ? authoredOrder.indexOf(id) : -1;
  return index === -1 ? Number.MAX_SAFE_INTEGER : index;
};
const siblings = [...(siblingsRequest?.data?.data ?? [])].sort(
  (a, b) => orderIndex(a.id) - orderIndex(b.id)
);
if (siblingsUnavailable) {
  Astro.response.status = 503;
}
if (noteMissing || noteUnavailable || siblingsUnavailable) {
  Astro.response.headers.set('CDN-Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('CDN-Cache-Control', 'public, max-age=86400, must-revalidate');
}
const outlineUrl = `${outlineAssetPrefix}/s/${shareId}${maybeDocSegment === 'doc' && maybeDocId ? `/doc/${maybeDocId}` : ''}`;

const countableText = (content ?? '')
  .split('\n')
  .filter((line) => !isStructuralLine(line))
  .join('\n');
const cjkChars = countableText.match(/[\u3040-\u30ff\u4e00-\u9fff]/g)?.length ?? 0;
const countsCharacters = cjkChars > countableText.replace(/\s/g, '').length * 0.3;
const countWords = (text: string) => {
  if (!text.trim()) return 0;
  if (countsCharacters) return text.replace(/[\s#*_`>|\-\[\]()]/g, '').length;
  try {
    const segmenter = new Intl.Segmenter(locale, { granularity: 'word' });
    let count = 0;
    for (const segment of segmenter.segment(text)) if (segment.isWordLike) count++;
    return count;
  } catch {
    return text.split(/\s+/).filter(Boolean).length;
  }
};
const wordCount = countWords(countableText);
const readingMinutes = Math.max(1, Math.round(wordCount / (countsCharacters ? 500 : 200)));
const wordUnit = countsCharacters ? t('note.chars') : t('note.words');
const readingLabel =
  wordCount > 0
    ? `${numberFormatter.format(readingMinutes)}${unitGap}${t('note.min-read')} / ${numberFormatter.format(wordCount)}${unitGap}${wordUnit}`
    : null;
const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Tokyo',
  calendar: 'gregory'
});
const formattedDate = note?.createdAt ? dateFormatter.format(new Date(note.createdAt)) : null;

const currentIndex = note ? siblings.findIndex((s) => s.id === note.id) : -1;
const prevSibling = currentIndex > 0 ? siblings[currentIndex - 1] : null;
const nextSibling =
  currentIndex >= 0 && currentIndex < siblings.length - 1 ? siblings[currentIndex + 1] : null;
const childPages: { id?: string; title?: string }[] = isChildDocument
  ? (findTreeNode(collectionTree, note?.id)?.children ?? [])
  : siblings.filter((s) => s.id !== note?.id);

const unescapeMarkdown = (text: string) => text.replace(/\\([\\`*_{}[\]()#+\-.!~=|])/g, '$1');
const slugger = createHeadingSlugger();
let inFence = false;
// A contents rail holding one or two entries costs a 220px column for the whole scroll and
// tells the reader nothing they cannot see in the heading above. Below that, the article
// takes the width back.
const CONTENTS_MIN_ENTRIES = 3;

const headings = (content ?? '')
  .split('\n')
  .filter((line) => {
    if (/^\s*(```|~~~)/.test(line)) {
      inFence = !inFence;
      return false;
    }
    return !inFence && /^#{1,6}\s+/.test(line);
  })
  .map((line, idx) => {
    const match = line.match(/^(#{1,6})\s+(.+)/);
    if (!match) return null;
    const text = unescapeMarkdown(match[2].replace(/(?<!\\)[*_`\[\]]/g, '')).trim();
    const id = slugger(match[2]);
    return { level: match[1].length, text, id, idx };
  })
  .filter((h) => !!h && !!h.text && h.level <= 3) as {
  level: number;
  text: string;
  id: string;
  idx: number;
}[];

const showContents = headings.length >= CONTENTS_MIN_ENTRIES;
const minHeadingLevel = Math.min(...headings.map((h) => h.level));
const headingIndent = (level: number) => `${(level - minHeadingLevel) * 0.75}rem`;

const plainOf = (line: string) =>
  unescapeMarkdown(
    line
      .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
      .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
      .replace(/https?:\/\/\S+/g, '')
      .replace(/(?<!\\)[*_`]/g, '')
      .replace(/\s+/g, ' ')
      .trim()
  );
const contentLines = (content ?? '').split('\n');
const firstContentIndex = contentLines.findIndex((line) => line.trim().length > 0);
const firstContentLine = firstContentIndex >= 0 ? contentLines[firstContentIndex].trim() : '';
const ledeLineIndex =
  firstContentLine.length > 30 &&
  !/^[#!\[|>*-]/.test(firstContentLine) &&
  !/^`/.test(firstContentLine) &&
  !/https?:\/\/|www\.|\]\(/.test(firstContentLine) &&
  !/^\d+[.)]\s/.test(firstContentLine)
    ? firstContentIndex
    : -1;
const rawLede = ledeLineIndex >= 0 ? contentLines[ledeLineIndex] : undefined;
const lede = rawLede ? plainOf(rawLede) : null;
const descriptionLine = contentLines.find(
  (line) =>
    line.trim().length > 30 &&
    !/^\s*([#!|>`<]|[-*+]\s|\d+[.)]\s|\[|---)/.test(line) &&
    !isStructuralLine(line)
);
const descriptionText = descriptionLine ? plainOf(descriptionLine) : '';
const clippedDescription =
  descriptionText.length > 160
    ? `${descriptionText.slice(0, 160).replace(/\s+\S*$/, '')}…`
    : descriptionText;
const metaDescription =
  note && clippedDescription.length > 30
    ? clippedDescription
    : note
      ? t('note.description')
      : stateDescription;
const rawBodyContent =
  ledeLineIndex >= 0
    ? [...contentLines.slice(0, ledeLineIndex), ...contentLines.slice(ledeLineIndex + 1)].join('\n')
    : content;

const shareLinkPattern = /\[([^\]]*)\]\((?:[^)\s]*?)\/s\/([^/?#)\s]+)[^)\s]*\)/g;
let knownShareKeys: Set<string> | null = null;
if (rawBodyContent && /\/s\/[^/?#)\s]+/.test(rawBodyContent)) {
  try {
    const shares = await withLastGood('note-share-keys', async () => {
      const rows: any[] = [];
      const pageLimit = 100;
      let offset = 0;
      while (true) {
        const request = requireOutlineOk(
          await outlineClient.POST('/shares.list', {
            body: { sort: 'createdAt', direction: 'DESC', limit: pageLimit, offset }
          }),
          'shares.list'
        );
        const page = request.data?.data ?? [];
        rows.push(...page);
        if (page.length < (request.data?.pagination?.limit ?? pageLimit)) break;
        offset += page.length;
      }
      return rows;
    });
    knownShareKeys = new Set(shares.flatMap((share) => [share.id, share.urlId].filter(Boolean)));
  } catch {
    knownShareKeys = null;
  }
}
const bodyContent =
  rawBodyContent && knownShareKeys
    ? rawBodyContent.replace(shareLinkPattern, (link, label, shareKey) =>
        knownShareKeys.has(shareKey) ? link : label
      )
    : rawBodyContent;

const docIdByUrlId: Record<string, string> = {};
for (const doc of [note, ...siblings].filter(Boolean)) {
  if (doc.urlId && doc.id) docIdByUrlId[doc.urlId] = doc.id;
}
for (const node of [findTreeNode(collectionTree, note?.id), ...childPages]) {
  const urlId = (node as { url?: string } | undefined)?.url?.split('-').pop();
  if (urlId && node?.id) docIdByUrlId[urlId] = node.id;
}
const currentDocIds = [note?.id, note?.urlId].filter(Boolean) as string[];

const detectLang = (text: string) => {
  const sample = text.replace(/[\s\d\p{P}]/gu, '').slice(0, 2000);
  if (!sample) return undefined;
  const share = (pattern: RegExp) => (sample.match(pattern)?.length ?? 0) / sample.length;
  if (share(/[\u0e00-\u0e7f]/g) > 0.3) return 'th';
  if (share(/[\u3040-\u30ff\u4e00-\u9fff]/g) > 0.3) return 'ja';
  return share(/[A-Za-z]/g) > 0.5 ? 'en' : undefined;
};
const detectedLang = detectLang(`${note?.title ?? ''}\n${content ?? ''}`);
const contentLang = detectedLang && detectedLang !== locale ? detectedLang : undefined;
const titleParts = ((note?.title as string | undefined) ?? '').split(/(?<=[_/])/);

const tags = (note as any)?.tags ?? [];
---

<MainLayout title={pageTitle} description={metaDescription}>
  <Container maxW="breakpoint-xl" py="8" className="page-shell">
    {
      !note ? (
        <Stack gap="8">
          <Stack
            gap="4"
            borderLeftWidth="2px"
            borderLeftStyle="solid"
            borderLeftColor="var(--atelier-accent)"
            pl="6"
          >
            <Text
              className="note-meta"
              fontFamily="var(--font-code)"
              fontSize="10px"
              textTransform="uppercase"
              letterSpacing="0.12em"
              color="var(--atelier-accent-soft)"
            >
              {noteMissing ? t('note.status-not-found') : t('note.status-unavailable')}
            </Text>
            <Heading as="h1" fontSize={{ base: '5xl', md: '7xl' }}>
              {stateTitle}
            </Heading>
            <Text color="var(--atelier-fg-muted)" fontSize="lg" maxW="2xl" lineHeight="1.7">
              {stateDescription}
            </Text>
            <Stack gap="4" alignItems="flex-start">
              {noteUnavailable && (
                <a href={Astro.url.pathname} class="note-cta-button group">
                  <span>{t('note.reload')}</span>
                </a>
              )}
              <a href={`/${locale}/notes`} class="note-cta-button group">
                <span>{t('note.back-to-posts')}</span>
                <Glyph name="arrow_back" className="note-cta-icon" />
              </a>
            </Stack>
          </Stack>
        </Stack>
      ) : (
        <div class="note-layout" data-contents={showContents || undefined}>
          {/* Sticky on the grid child, mirroring the DETAILS rail below. Nested inside a
              static Stack of equal height it had zero travel, so the CONTENTS rail scrolled
              away while the right rail on the same page stayed pinned. */}
          <Stack
            gap="8"
            hideBelow="xl"
            hidden={!showContents}
            data-note-toc-rail
            position="sticky"
            top="24"
            maxH="calc(100dvh - 8rem)"
            overflowY="auto"
            overscrollBehavior="contain"
          >
            <Box>
              <Box borderLeft="1px solid var(--atelier-line)" pl="4" position="relative">
                <Box
                  position="absolute"
                  top="0"
                  left="-1px"
                  w="1px"
                  h="8"
                  bg="var(--atelier-accent)"
                />
                <Text
                  className="note-meta"
                  fontFamily="var(--font-code)"
                  fontSize="10px"
                  textTransform="uppercase"
                  color="var(--atelier-outline)"
                  mb="4"
                >
                  {t('note.contents')}
                </Text>
                <nav aria-label={t('note.contents')} lang={contentLang}>
                  <Stack gap="0">
                    {headings.map((h) => (
                      <styled.a
                        href={`#${h.id}`}
                        className="note-toc-link"
                        data-toc-for={h.id}
                        display="flex"
                        alignItems="center"
                        minH="32px"
                        css={{ '@media (pointer: coarse)': { minH: '44px' } }}
                        style={{ paddingLeft: headingIndent(h.level) }}
                      >
                        <Text
                          fontFamily="var(--font-code)"
                          fontSize="11px"
                          color={
                            h.level === minHeadingLevel
                              ? 'var(--atelier-fg)'
                              : 'var(--atelier-fg-muted)'
                          }
                          _hover={{ color: 'var(--atelier-accent)' }}
                          transition="colors"
                          transitionDuration="fast"
                          textTransform="uppercase"
                          letterSpacing={locale === 'en' ? '-0.02em' : '0'}
                        >
                          {h.text}
                        </Text>
                      </styled.a>
                    ))}
                  </Stack>
                </nav>
              </Box>
            </Box>
          </Stack>

          <Stack gap="10" minW="0">
            <Stack gap="6" mb="4">
              <Box hideFrom="xl">
                <styled.a
                  href={`/${locale}/notes`}
                  display="inline-flex"
                  alignItems="center"
                  minH="44px"
                  fontFamily="var(--font-code)"
                  fontSize="xs"
                  color="var(--atelier-fg-muted)"
                  _hover={{ color: 'var(--atelier-accent)' }}
                >
                  ← {t('note.back-to-posts')}
                </styled.a>
              </Box>
              {parentNote && (
                <styled.a
                  href={parentNote.href}
                  display="inline-flex"
                  alignItems="center"
                  minH="44px"
                  alignSelf="start"
                  color="var(--atelier-fg-muted)"
                  overflowWrap="anywhere"
                  _hover={{ color: 'var(--atelier-accent)' }}
                >
                  ← {parentNote.title}
                </styled.a>
              )}
              <Eyebrow label={t('note.note-label')} />
              <Heading
                as="h1"
                fontSize={{ base: '5xl', md: '7xl' }}
                lineHeight="tight"
                letterSpacing={locale === 'en' ? '-0.04em' : '0'}
                overflowWrap="anywhere"
                lang={contentLang}
              >
                {titleParts.map((part) => (
                  <Fragment>
                    {part}
                    <wbr />
                  </Fragment>
                ))}
              </Heading>
              {lede && (
                <Text
                  fontFamily="var(--font-display)"
                  fontSize="xl"
                  color="var(--atelier-fg-muted)"
                  fontStyle="italic"
                  lineHeight="relaxed"
                  maxW="xl"
                  lang={contentLang}
                >
                  {lede}
                </Text>
              )}
              {(formattedDate || collectionName || readingLabel) && (
                <Text
                  hideFrom="xl"
                  className="note-meta"
                  fontFamily="var(--font-code)"
                  fontSize="xs"
                  color="var(--atelier-outline)"
                  overflowWrap="anywhere"
                >
                  {[formattedDate, collectionName, readingLabel].filter(Boolean).join(' · ')}
                </Text>
              )}
            </Stack>

            {banner && (
              <Box
                position="relative"
                w="full"
                maxW="full"
                border="1px solid"
                borderColor="var(--atelier-line)"
                overflow="hidden"
                className="note-hero-frame"
                mb="4"
              >
                <img
                  src={banner}
                  alt={bannerAlt}
                  width="1600"
                  height="900"
                  class="note-hero-image"
                />
                <Box
                  position="absolute"
                  inset="0"
                  bgGradient="to-t"
                  gradientFrom="var(--atelier-bg)"
                  gradientTo="transparent"
                  opacity="0.6"
                />
              </Box>
            )}

            {showContents && (
              <Box hideFrom="xl">
                <styled.details
                  border="1px solid"
                  borderColor="var(--atelier-line)"
                  bg="var(--atelier-surface-low)"
                  lang={contentLang}
                  css={{
                    '& > summary::-webkit-details-marker': { display: 'none' },
                    '& > summary::after': { content: '"+"', color: 'var(--atelier-accent)' },
                    '&[open] > summary::after': { content: '"−"' }
                  }}
                >
                  <styled.summary
                    display="flex"
                    alignItems="center"
                    justifyContent="space-between"
                    listStyle="none"
                    minH="44px"
                    px="4"
                    fontFamily="var(--font-code)"
                    fontSize="xs"
                    textTransform="uppercase"
                    color="var(--atelier-fg-muted)"
                    cursor="pointer"
                  >
                    {t('note.contents')}
                  </styled.summary>
                  <Stack gap="1" px="4" pb="3">
                    {headings.map((h) => (
                      <styled.a
                        href={`#${h.id}`}
                        className="note-toc-link"
                        data-toc-for={h.id}
                        display="flex"
                        alignItems="center"
                        minH="44px"
                        style={{ paddingLeft: headingIndent(h.level) }}
                        fontFamily="var(--font-code)"
                        fontSize="xs"
                        color="var(--atelier-fg-muted)"
                        overflowWrap="anywhere"
                        _hover={{ color: 'var(--atelier-accent)' }}
                      >
                        {h.text}
                      </styled.a>
                    ))}
                  </Stack>
                </styled.details>
              </Box>
            )}

            {bodyContent && (
              <Box lang={contentLang} minW="0">
                <Markdown
                  content={bodyContent}
                  newTabLabel={t('note.opens-new-tab')}
                  linkLabels={knownLinkLabelsFrom(t)}
                  tableLabel={t('common.table-region')}
                  assetsPrefix={outlineAssetPrefix}
                  assetProxyBasePath={outlineAssetProxyPath}
                  linksPrefix={`/${locale}/notes/${shareId}`}
                  notesBasePath={`/${locale}/notes`}
                  currentDocIds={currentDocIds}
                  docIdByUrlId={docIdByUrlId}
                  codeLabel={t('common.code-block')}
                  locale={locale}
                  headingLevelOffset={1}
                />
              </Box>
            )}

            {!bodyContent?.trim() && !lede && childPages.length === 0 && (
              <Text color="var(--atelier-fg-muted)" maxW="42rem">
                {t('note.empty-page')}
              </Text>
            )}

            {childPages.length > 0 && (
              <styled.nav
                aria-labelledby="note-pages-title"
                maxW="42rem"
                border="1px solid"
                borderColor="var(--atelier-line)"
                bg="var(--atelier-surface-low)"
                p="6"
              >
                <Text
                  as="h2"
                  id="note-pages-title"
                  fontWeight="normal"
                  className="note-meta"
                  fontFamily="var(--font-code)"
                  fontSize="10px"
                  textTransform="uppercase"
                  color="var(--atelier-outline)"
                  letterSpacing="0.12em"
                  mb="2"
                >
                  {t('note.pages-in-note')}
                </Text>
                <styled.ul
                  listStyle="none"
                  m="0"
                  p="0"
                  css={{ '& > li:last-child > a': { borderBottom: 'none' } }}
                >
                  {childPages.map((child) => (
                    <li>
                      <styled.a
                        href={`/${locale}/notes/${shareId}/doc/${child.id}`}
                        display="flex"
                        alignItems="center"
                        minH="44px"
                        py="2"
                        borderBottom="1px solid var(--atelier-line)"
                        color="var(--atelier-fg-muted)"
                        overflowWrap="anywhere"
                        _hover={{ color: 'var(--atelier-accent)' }}
                      >
                        {child.title ?? t('note.untitled')}
                      </styled.a>
                    </li>
                  ))}
                </styled.ul>
              </styled.nav>
            )}

            {siblingsUnavailable && (
              <Box
                maxW="42rem"
                border="1px solid"
                borderColor="var(--atelier-line)"
                bg="var(--atelier-surface-low)"
                p="4"
              >
                <Text color="var(--atelier-fg-muted)">{t('note.siblings-unavailable')}</Text>
              </Box>
            )}

            {(prevSibling || nextSibling) && (
              <Grid
                gridTemplateColumns={{ base: 'minmax(0, 1fr)', md: 'repeat(2, minmax(0, 1fr))' }}
                gap="8"
                pt="12"
                maxW="42rem"
                borderTop="1px solid var(--atelier-line)"
              >
                {prevSibling ? (
                  <styled.a
                    href={`/${locale}/notes/${shareId}/doc/${prevSibling.id}`}
                    display="block"
                    h="full"
                    className="group"
                  >
                    <Box
                      h="full"
                      border="1px solid"
                      borderColor="var(--atelier-line)"
                      p="6"
                      className="blocky-shadow blocky-shadow-hover"
                    >
                      <Text
                        className="note-meta"
                        fontFamily="var(--font-code)"
                        fontSize="10px"
                        textTransform="uppercase"
                        color="var(--atelier-outline)"
                        mb="2"
                      >
                        {t('note.previous-entry')}
                      </Text>
                      <Text
                        fontSize="xl"
                        className="group-hover-amber"
                        transition="colors"
                        transitionDuration="fast"
                      >
                        {prevSibling.title}
                      </Text>
                    </Box>
                  </styled.a>
                ) : (
                  <Box hideBelow="md" />
                )}
                {nextSibling ? (
                  <styled.a
                    href={`/${locale}/notes/${shareId}/doc/${nextSibling.id}`}
                    display="block"
                    h="full"
                    className="group"
                  >
                    <Box
                      h="full"
                      border="1px solid"
                      borderColor="var(--atelier-line)"
                      p="6"
                      textAlign="right"
                      className="blocky-shadow blocky-shadow-hover"
                    >
                      <Text
                        className="note-meta"
                        fontFamily="var(--font-code)"
                        fontSize="10px"
                        textTransform="uppercase"
                        color="var(--atelier-outline)"
                        mb="2"
                      >
                        {t('note.next-entry')}
                      </Text>
                      <Text
                        fontSize="xl"
                        className="group-hover-amber"
                        transition="colors"
                        transitionDuration="fast"
                      >
                        {nextSibling.title}
                      </Text>
                    </Box>
                  </styled.a>
                ) : (
                  <Box hideBelow="md" />
                )}
              </Grid>
            )}
          </Stack>

          <Stack gap="6" position="sticky" top="24">
            <Box
              border="1px solid"
              borderColor="var(--atelier-line)"
              bg="var(--atelier-surface-low)"
              p="6"
              position="relative"
              hideBelow={tags.length === 0 ? 'xl' : undefined}
            >
              <Box
                position="absolute"
                top="-12px"
                left="-4px"
                bg="var(--atelier-surface-highest)"
                border="1px solid"
                borderColor="var(--atelier-line)"
                px="2"
                py="0.5"
              >
                <Text
                  className="note-meta"
                  fontFamily="var(--font-code)"
                  fontSize="11px"
                  textTransform="uppercase"
                  color="var(--atelier-accent)"
                >
                  {t('note.details')}
                </Text>
              </Box>
              <Stack gap="6" mt="2">
                {formattedDate && (
                  <Box hideBelow="xl">
                    <Text
                      className="note-meta"
                      fontFamily="var(--font-code)"
                      fontSize="10px"
                      textTransform="uppercase"
                      color="var(--atelier-outline)"
                      letterSpacing="0.12em"
                      mb="1"
                    >
                      {t('note.published')}
                    </Text>
                    <Text fontFamily="var(--font-code)" fontSize="xs">
                      {formattedDate}
                    </Text>
                  </Box>
                )}
                {collectionName && (
                  <Box hideBelow="xl">
                    <Text
                      className="note-meta"
                      fontFamily="var(--font-code)"
                      fontSize="10px"
                      textTransform="uppercase"
                      color="var(--atelier-outline)"
                      letterSpacing="0.12em"
                      mb="1"
                    >
                      {t('note.collection')}
                    </Text>
                    <Text fontSize="sm" overflowWrap="anywhere">
                      {collectionName}
                    </Text>
                  </Box>
                )}
                {readingLabel && (
                  <Box hideBelow="xl">
                    <Text
                      className="note-meta"
                      fontFamily="var(--font-code)"
                      fontSize="10px"
                      textTransform="uppercase"
                      color="var(--atelier-outline)"
                      letterSpacing="0.12em"
                      mb="1"
                    >
                      {t('note.reading-time')}
                    </Text>
                    <Text fontFamily="var(--font-code)" fontSize="xs" textTransform="uppercase">
                      {readingLabel}
                    </Text>
                  </Box>
                )}
                {tags.length > 0 && (
                  <Box>
                    <Text
                      className="note-meta"
                      fontFamily="var(--font-code)"
                      fontSize="10px"
                      textTransform="uppercase"
                      color="var(--atelier-outline)"
                      letterSpacing="0.12em"
                      mb="2"
                    >
                      {t('note.tags')}
                    </Text>
                    <Box display="flex" flexWrap="wrap" gap="2">
                      {tags.map((tag: string) => (
                        <Box
                          bg="var(--atelier-surface-highest)"
                          px="2"
                          py="1"
                          border="1px solid"
                          borderColor="var(--atelier-line)"
                        >
                          <Text
                            fontFamily="var(--font-code)"
                            fontSize="11px"
                            color="var(--atelier-fg-muted)"
                          >
                            #{tag}
                          </Text>
                        </Box>
                      ))}
                    </Box>
                  </Box>
                )}
              </Stack>
            </Box>

            <Stack gap="4">
              <a href={`/${locale}/notes`} class="note-cta-button group">
                <span>{t('note.back-to-posts')}</span>
                <Glyph name="arrow_back" className="note-cta-icon" />
              </a>
              <a
                href={outlineUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="note-cta-button group"
              >
                <span>{t('note.read-in-outline')}</span>
                <styled.span srOnly>{t('note.opens-new-tab')}</styled.span>
                <Glyph name="open_in_new" className="note-cta-icon" />
              </a>
            </Stack>
          </Stack>
        </div>
      )
    }
  </Container>
</MainLayout>

<script>
  let disposeNoteToc: (() => void) | undefined;

  const wireNoteToc = () => {
    disposeNoteToc?.();
    disposeNoteToc = undefined;
    const links = Array.from(document.querySelectorAll('.note-toc-link')) as HTMLAnchorElement[];
    const targets = Array.from(
      new Map(
        links.map((link) => {
          const id = link.dataset.tocFor ?? '';
          return [id, document.getElementById(id)] as const;
        })
      ).values()
    ).filter((target): target is HTMLElement => !!target);
    if (targets.length === 0) return;

    const controller = new AbortController();
    let frame = 0;
    const sync = () => {
      frame = 0;
      let active = targets[0];
      for (const target of targets) {
        const offset = Math.max(
          88,
          Number.parseFloat(getComputedStyle(target).scrollMarginTop) || 0
        );
        if (target.getBoundingClientRect().top <= offset + 1) active = target;
      }
      for (const link of links) {
        if (link.dataset.tocFor === active.id) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
      const railLink = links.find(
        (link) => link.dataset.tocFor === active.id && link.closest('[data-note-toc-rail]')
      );
      const rail = railLink?.closest<HTMLElement>('[data-note-toc-rail]');
      if (rail && railLink && rail.scrollHeight > rail.clientHeight) {
        const top = railLink.offsetTop;
        if (
          top < rail.scrollTop ||
          top + railLink.offsetHeight > rail.scrollTop + rail.clientHeight
        ) {
          rail.scrollTop = top - rail.clientHeight / 2;
        }
      }
    };
    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(sync);
    };

    disposeNoteToc = () => {
      controller.abort();
      cancelAnimationFrame(frame);
    };
    sync();
    window.addEventListener('scroll', onScroll, { passive: true, signal: controller.signal });
    window.addEventListener('resize', onScroll, { passive: true, signal: controller.signal });
  };

  wireNoteToc();
  document.addEventListener('astro:page-load', wireNoteToc);
  document.addEventListener('astro:before-swap', () => disposeNoteToc?.());
</script>
