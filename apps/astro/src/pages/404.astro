---
import { Container, Flex, Stack } from 'styled-system/jsx';
import { Text } from '~/components/ui/text';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import MainLayout from '~/layouts/MainLayout.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<MainLayout title={`404 | ${t('common.page-not-found')}`}>
  <Container maxW="breakpoint-xl" className="page-shell">
    {
      /* Every other page is built on a hard left-aligned spine; centring made this the one
        page from a different site, and the CTA lost the structural anchor the rest uses. */
    }
    <Flex minH="70vh" alignItems="center">
      <Stack gap="0" maxW="520px">
        <Text
          fontFamily="var(--font-display)"
          fontWeight="400"
          fontStyle="italic"
          lineHeight="1"
          fontSize={{ base: '7xl', md: '8xl' }}
          color="var(--atelier-fg)"
          mb="4"
        >
          404
        </Text>

        <Text
          as="h1"
          fontFamily="var(--font-display)"
          fontWeight="400"
          lineHeight="1.2"
          fontSize={{ base: '2xl', md: '3xl' }}
          color="var(--atelier-fg)"
          mb="6"
        >
          {t('common.not-found-heading')}
        </Text>

        <Text
          fontFamily="var(--font-body)"
          fontSize="14px"
          lineHeight="1.7"
          color="var(--atelier-fg-muted)"
          mb="10"
        >
          {t('common.not-found-description')}
        </Text>

        <Flex gap="3" flexWrap="wrap">
          <a href={`/${lang}/`} class="not-found-cta"> {t('common.return-home')} </a>
          <a href={`/${lang}/projects`} class="not-found-link"> {t('common.projects')} </a>
          <a href={`/${lang}/contact`} class="not-found-link"> {t('common.contact')} </a>
        </Flex>
      </Stack>
    </Flex>
  </Container>
</MainLayout>

<style>
  .not-found-cta {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--atelier-on-accent);
    background: var(--atelier-accent);
    padding: 10px 20px;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .not-found-cta:hover {
    opacity: 0.85;
  }
  .not-found-link {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--atelier-fg-muted);
    border: 1px solid var(--atelier-line);
    padding: 10px 20px;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .not-found-link:hover {
    border-color: var(--atelier-outline);
    color: var(--atelier-fg);
  }
</style>
