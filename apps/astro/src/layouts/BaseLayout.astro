---
import { languages } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';
import { fontHref } from '../utils/fonts';
import '../index.css';

const lang = getLangFromUrl(Astro.url);
const { title = 'Ham', description, image } = Astro.props;
const canonicalUrl = Astro.url.href;
const socialImage = new URL(image ?? '/og-default.png', Astro.url).href;
const siteName = 'Ham';
const localePath = Astro.url.pathname.replace(/^\/[^/]+/, '');
const alternateLocales = Object.keys(languages);
const alternateUrl = (code: string) =>
  new URL(`/${code}${localePath}${Astro.url.search}`, Astro.url).href;

const fontsHref = fontHref(lang);
---

<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#131313" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateLocales.map((code) => (
        <link rel="alternate" hreflang={code} href={alternateUrl(code)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={alternateUrl('en')} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontsHref} rel="stylesheet" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @media print {
    astro-dev-toolbar {
      display: none !important;
    }
  }
</style>
