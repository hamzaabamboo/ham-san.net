---
import { getLangFromUrl } from '../i18n/utils';
import { namecardFontHref } from '../utils/fonts';
import '../index.css';

const lang = getLangFromUrl(Astro.url);
const { title = 'Ham', description, image } = Astro.props;
const socialImage = new URL(image ?? '/og-default.png', Astro.url).href;
const canonicalUrl = Astro.url.href;
const siteName = 'Ham';
---

<html lang={lang} class="namecard-document">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#bf99b0" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={namecardFontHref()} rel="stylesheet" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html.namecard-document {
    color-scheme: light;
    scroll-behavior: auto;
    background: #fff;
  }

  html.namecard-document body {
    margin: 0;
    min-height: 100dvh;
    background: #fff;
    color: #111;
    font-family:
      'M PLUS 1p', 'Yu Gothic Medium', '游ゴシック Medium', YuGothic, '游ゴシック体',
      'ヒラギノ角ゴ Pro', 'Hiragino Kaku Gothic Pro', 'メイリオ', Meiryo, sans-serif;
    text-rendering: auto;
  }

  html.namecard-document body::before,
  html.namecard-document body::after {
    content: none;
    display: none;
  }

  html.namecard-document a {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-decoration: none;
    text-underline-offset: initial;
  }

  html.namecard-document h1,
  html.namecard-document h2,
  html.namecard-document h3,
  html.namecard-document h4,
  html.namecard-document h5,
  html.namecard-document h6 {
    font-family: inherit;
    letter-spacing: 0;
    text-wrap: initial;
  }

  @media print {
    html.namecard-document astro-dev-toolbar {
      display: none !important;
    }
  }
</style>
