---
import { Glyph } from '~/components/ui/glyph';
import SectionHeading from '~/components/common/SectionHeading.astro';
import { styled } from 'styled-system/jsx';
import { resolveMedia } from 'utils/media';
import { graphQLSdk } from '~/graphql';
import type { ProjectPreviewFragment } from '~/graphql/generated/client';
import type { Languages } from '~/i18n/ui';
import { useTranslations } from '~/i18n/utils';
import { roomCopy } from '~/components/home/room-copy';
import { withFreshLastGoodState, withLastGoodState, withinLastGood } from '~/utils/cms-cache';
import { mergeLocaleRecords, pickLocale } from '~/utils/fallbackLocale';
import { projectMonogram } from '~/utils/monogram';
import { getPhotoCatalog } from '~/utils/photo-catalog';
import { getEventernoteReport } from '~/utils/eventernote-report';
import { outlineClient } from '~/utils/outline-api';
import { requireOutlineOk } from '~/utils/outline-response';

interface Props {
  locale: Languages;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const room = roomCopy[locale];
const cmsLocale = locale === 'ja' ? 'ja' : 'en';

const within = <T,>(promise: Promise<T>, ms: number) =>
  Promise.race([
    promise,
    new Promise<never>((_, reject) => setTimeout(() => reject(new Error('timeout')), ms))
  ]);
const fresh = <T,>(key: string, fetcher: () => Promise<T>, ms: number) =>
  withinLastGood(
    key,
    withFreshLastGoodState(key, fetcher).then(({ value }) => value),
    ms
  );

const photoCatalog = within(getPhotoCatalog(), 700).catch(() => null);
const report = withinLastGood(
  'events:report',
  withLastGoodState(
    'events:report',
    () => getEventernoteReport(),
    (value) => !value.attendanceIncomplete
  ).then(({ value }) => value),
  700
).catch(() => null);
const career = fresh(
  `home:about:${cmsLocale}`,
  () => graphQLSdk.fetchAboutMe({ locale: cmsLocale, includeFallback: cmsLocale === 'ja' }),
  700
)
  .then((value) =>
    cmsLocale === 'ja'
      ? mergeLocaleRecords(value.experiences, value.fallbackExperiences)
      : (value.experiences ?? [])
  )
  .catch(() => null);
const notes = fresh(
  'home:notes',
  async () => {
    const response = requireOutlineOk(
      await outlineClient.POST('/shares.list', {
        body: { sort: 'createdAt', direction: 'DESC', limit: 100, offset: 0 },
        headers: { Authorization: undefined as unknown as 'Bearer hoge' }
      }),
      'shares.list'
    );
    return response.data?.data ?? [];
  },
  700
).catch(() => null);

let projects: ProjectPreviewFragment[] = [];
let projectsUnavailable = false;
try {
  const data = await fresh(
    `home:${cmsLocale}`,
    () => graphQLSdk.fetchHomePage({ locale: cmsLocale }),
    900
  );
  projects = (data?.projects ?? [])
    .map((p) => pickLocale(p, locale))
    .filter((p): p is ProjectPreviewFragment => !!p);
} catch {
  projectsUnavailable = true;
}

const yearFormatter = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  timeZone: 'Asia/Tokyo',
  calendar: 'gregory'
});
const yearOf = (value?: string | null) =>
  value
    ? yearFormatter
        .formatToParts(new Date(`${value.slice(0, 10)}T00:00:00+09:00`))
        .find((part) => part.type === 'year')?.value
    : undefined;
const numberFormatter = new Intl.NumberFormat(locale);
const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'short',
  timeZone: 'Asia/Tokyo',
  calendar: 'gregory'
});

const eventReport = await report;
const firstEventDate = (eventReport?.attendedEvents ?? [])
  .map((event) => event.dateKey)
  .filter(Boolean)
  .sort()[0];
const firstEventYear = yearOf(firstEventDate);
const mostSeenSuffix = eventReport?.topArtists[0]
  ? `${t('home.crowd-times').replace('{count}', numberFormatter.format(eventReport.topArtists[0].count))}${
      eventReport.maxEventsInDay
        ? ` ${t('home.crowd-busiest').replace('{count}', numberFormatter.format(eventReport.maxEventsInDay.count))}`
        : ''
    }`
  : '';
const careerRecords = await career;
const experiences = (careerRecords ?? [])
  .map((item: any) => pickLocale(item, locale) ?? item)
  .filter((item: any) => item?.title && item?.start)
  .sort((a: any, b: any) => String(b.start).localeCompare(String(a.start)))
  .slice(0, 4);
const noteDate = (note: any): string | undefined => note.documentCreatedAt ?? note.createdAt;
const noteRecords = await notes;
const latestNotes = (noteRecords ?? [])
  .filter((note: any) => note?.id && note?.documentTitle)
  .sort(
    (a: any, b: any) => (Date.parse(noteDate(b) ?? '') || 0) - (Date.parse(noteDate(a) ?? '') || 0)
  )
  .slice(0, 3);
const catalog = await photoCatalog;
const kamekoEntries = catalog?.entries ?? [];
const photoLang = locale === 'ja' ? undefined : 'ja';
const recentPhotos = kamekoEntries
  .filter(
    (entry, index, list) =>
      list.findIndex((other) => other.subjects[0]?.name === entry.subjects[0]?.name) === index
  )
  .slice(0, 4);
const photoRatio = (entry: (typeof kamekoEntries)[number]) => {
  const { width, height } = entry.media[0];
  return width && height ? `${width} / ${height}` : '4 / 5';
};
const practice = ['darts', 'rubik', 'typing', 'piano'] as const;
---

<section
  class="home-chapter home-work"
  data-tour-stop="projects"
  data-tour-pose={JSON.stringify({ position: [0.35, 1.6, -0.2], lookAt: [-1.55, 0.95, -0.9] })}
  data-home-degraded={careerRecords === null ? '' : undefined}
  aria-labelledby="home-work"
>
  <div class="home-panel">
    <SectionHeading id="home-work" label={t('home.work-heading')} />
    {
      experiences.length > 0 && (
        <ol class="home-timeline">
          {experiences.map((item: any) => (
            <li>
              <span class="home-timeline-role">{item.position}</span>
              <span class="home-timeline-place">{item.title}</span>
              <span class="home-timeline-years">
                {yearOf(item.start)}–{item.end ? yearOf(item.end) : t('home.work-present')}
              </span>
            </li>
          ))}
        </ol>
      )
    }
    {careerRecords === null && <p class="home-chapter-note">{t('home.section-unavailable')}</p>}
    <a class="home-chapter-link" href={`/${locale}/about`}>
      {t('home.work-about')}
      <Glyph name="north_east" />
    </a>
  </div>
</section>

<section
  class="home-chapter home-builds"
  data-tour-stop="projects"
  data-home-degraded={projectsUnavailable && projects.length === 0 ? '' : undefined}
  aria-labelledby="home-builds"
>
  <div class="home-panel home-panel-wide">
    <SectionHeading id="home-builds" label={t('home.builds-heading')} />
    {
      projects.length > 0 ? (
        <ul class="home-project-grid">
          {projects.map((project) => {
            const imgSrc =
              resolveMedia(
                project.banner ?? project.media?.[0],
                400,
                import.meta.env.PUBLIC_API_URL
              )?.src ?? null;
            return (
              <li>
                <a href={`/${locale}/projects/${project.slug}`} class="project-card">
                  <span class="project-card-frame">
                    {imgSrc ? (
                      <img
                        src={imgSrc}
                        alt=""
                        class="project-card-img"
                        width="600"
                        height="600"
                        loading="lazy"
                      />
                    ) : (
                      <span class="project-card-monogram" aria-hidden="true">
                        {projectMonogram(project.title)}
                      </span>
                    )}
                  </span>
                  <span class="project-card-title">{project.title}</span>
                  <span class="project-card-description">{project.description}</span>
                  <span class="project-card-year">{yearOf(project.date)}</span>
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        projectsUnavailable && (
          <p class="home-chapter-note">
            <strong>{t('home.projects-empty-title')}</strong> {t('home.projects-empty-description')}
          </p>
        )
      )
    }
    <a class="home-chapter-link" href={`/${locale}/projects`}>
      {t('home.view-my-work')}
      <Glyph name="north_east" />
    </a>
  </div>
</section>

<section
  class="home-chapter home-crowd"
  data-tour-stop="penlight"
  data-home-degraded={eventReport ? undefined : ''}
  aria-labelledby="home-crowd"
>
  <div class="home-panel">
    <SectionHeading id="home-crowd" label={t('home.crowd-heading')} />
    {
      eventReport && eventReport.totalEvents > 0 && (
        <dl class="home-figures">
          <div>
            <dt>{t('home.crowd-total').replace('{year}', firstEventYear ?? '')}</dt>
            <dd>{numberFormatter.format(eventReport.totalEvents)}</dd>
          </div>
          <div>
            <dt>{t('home.crowd-venues')}</dt>
            <dd>{numberFormatter.format(eventReport.uniqueVenues)}</dd>
          </div>
          <div>
            <dt>{t('home.crowd-upcoming')}</dt>
            <dd>{numberFormatter.format(eventReport.nextEvents.length)}</dd>
          </div>
        </dl>
      )
    }
    {
      eventReport?.topArtists[0] &&
        // prettier-ignore
        <p class="home-chapter-note">{t('home.crowd-most-seen')} <span lang="ja">{eventReport.topArtists[0].name}</span>{mostSeenSuffix}</p>
    }
    {
      eventReport?.nextEvents[0] && (
        <p class="home-chapter-note">
          {t('home.crowd-next')} <span lang="ja">{eventReport.nextEvents[0].title}</span>
        </p>
      )
    }
    {!eventReport && <p class="home-chapter-note">{t('home.section-unavailable')}</p>}
    <a class="home-chapter-link" href={`/${locale}/events`}>
      {t('home.crowd-link')}
      <Glyph name="north_east" />
    </a>
  </div>
</section>

<section class="home-chapter home-practice" data-tour-stop="darts" aria-labelledby="home-practice">
  <div class="home-panel">
    <SectionHeading id="home-practice" label={t('home.practice-heading')} />
    <ul class="home-word-list">
      {practice.map((id) => <li>{room[id]}</li>)}
    </ul>
    <a class="home-chapter-link" href={`/${locale}/hobbies`}>
      {t('home.explore-hobbies')}
      <Glyph name="north_east" />
    </a>
  </div>
</section>

<section
  class="home-chapter home-notes"
  data-tour-stop="notes"
  data-tour-pose={JSON.stringify({ position: [-0.15, 1.45, -1.45], lookAt: [-1.77, 1.25, -1.2] })}
  data-home-degraded={noteRecords === null ? '' : undefined}
  aria-labelledby="home-notes"
>
  <div class="home-panel">
    <SectionHeading id="home-notes" label={t('home.notes-heading')} />
    {
      latestNotes.length > 0 && (
        <ul class="home-note-list">
          {latestNotes.map((note: any) => (
            <li>
              <a href={`/${locale}/notes/${note.id}`}>
                <span class="home-note-title">{note.documentTitle}</span>
                {noteDate(note) && (
                  <span class="home-note-date">
                    {dateFormatter.format(new Date(noteDate(note)!))}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {noteRecords === null && <p class="home-chapter-note">{t('home.section-unavailable')}</p>}
    <a class="home-chapter-link" href={`/${locale}/notes`}>
      {t('home.notes-all')}
      <Glyph name="north_east" />
    </a>
  </div>
</section>

{
  (recentPhotos.length > 0 || catalog === null) && (
    <section
      class="home-chapter home-gallery"
      data-tour-stop="photos"
      data-home-degraded={catalog === null ? '' : undefined}
      aria-labelledby="home-photos"
    >
      <div class="home-panel home-panel-wide">
        <SectionHeading id="home-photos" label={t('home.photos-heading')} />
        {catalog === null && <p class="home-chapter-note">{t('home.section-unavailable')}</p>}
        <ul class="home-photos">
          {recentPhotos.map((entry) => (
            <li>
              <a href={entry.url} target="_blank" rel="noopener noreferrer">
                <span class="home-photos-frame" style={`aspect-ratio:${photoRatio(entry)}`}>
                  <img
                    src={`${entry.media[0].url}?format=jpg&name=small`}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                    referrerpolicy="no-referrer"
                    data-kameko-image
                  />
                </span>
                <span class="home-photos-name" lang={photoLang}>
                  {entry.subjects.map((subject) => subject.name).join('、')}
                </span>
                <span class="home-photos-event" lang={photoLang}>
                  {entry.event}
                </span>
                <styled.span srOnly>
                  {t('photos.open-on-x')} {t('note.opens-new-tab')}
                </styled.span>
              </a>
            </li>
          ))}
        </ul>
        <a href={`/${locale}/photos`} class="home-chapter-link">
          {t('home.photos-all')}
          <Glyph name="north_east" />
        </a>
      </div>
    </section>
  )
}

<section class="home-chapter home-outro" data-tour-stop="hobbies" aria-labelledby="home-outro">
  <div class="home-panel">
    <SectionHeading id="home-outro" label={t('home.outro-heading')} />
    <p class="home-chapter-note">{t('home.outro-body')}</p>
    <div class="home-actions">
      <button type="button" class="home-hero-cta home-hero-cta-primary" data-room-enter>
        {t('home.enter-room')}
      </button>
      <a href={`/${locale}/contact`} class="home-hero-cta cta-secondary">{t('common.contact')}</a>
    </div>
  </div>
</section>
