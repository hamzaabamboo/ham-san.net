---
import { Glyph } from '~/components/ui/glyph';
import { Box, Flex, Grid, Stack, styled } from 'styled-system/jsx';
import { resolveMedia } from 'utils/media';
import { Heading } from '~/components/ui/heading';
import { Text } from '~/components/ui/text';
import { graphQLSdk } from '~/graphql';
import type { ProjectPreviewFragment } from '~/graphql/generated/client';
import type { Languages } from '~/i18n/ui';
import { useTranslations } from '~/i18n/utils';
import StatusRow from '~/components/home/StatusRow.astro';
import SectionHeading from '~/components/common/SectionHeading.astro';
import { withFreshLastGoodState } from '~/utils/cms-cache';
import { pickLocale } from '~/utils/fallbackLocale';
import { projectMonogram } from '~/utils/monogram';
import { getPhotoCatalog } from '~/utils/photo-catalog';
import { getHomepageStatus } from '~/utils/homepage-status';

interface Props {
  locale: Languages;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const cmsLocale = locale === 'ja' ? 'ja' : 'en';

let projects: ProjectPreviewFragment[] = [];
let homeUnavailable = false;
const photoCatalog = getPhotoCatalog().catch(() => null);
const homepageStatus = getHomepageStatus(locale);

try {
  const { value: data, fromCache } = await withFreshLastGoodState(`home:${cmsLocale}`, () =>
    graphQLSdk.fetchHomePage({ locale: cmsLocale })
  );
  homeUnavailable = fromCache;
  const rawProjects = data?.projects ?? [];
  projects = rawProjects
    .map((p) => pickLocale(p, locale))
    .filter((p): p is ProjectPreviewFragment => !!p);
} catch {
  projects = [];
  homeUnavailable = true;
}

const heroProjects = [
  ...projects.filter((project) => project.banner ?? project.media?.[0]),
  ...projects.filter((project) => !(project.banner ?? project.media?.[0]))
].slice(0, 3);
const kamekoEntries = (await photoCatalog)?.entries ?? [];
const photoLang = locale === 'ja' ? undefined : 'ja';
const recentPhotos = kamekoEntries
  .filter(
    (entry, index, list) =>
      list.findIndex((other) => other.subjects[0]?.name === entry.subjects[0]?.name) === index
  )
  .slice(0, 4);
const subjectNames = (entry: (typeof kamekoEntries)[number]) =>
  entry.subjects.map((subject) => subject.name);
const photoRatio = (entry: (typeof kamekoEntries)[number]) => {
  const { width, height } = entry.media[0];
  return width && height ? `${width} / ${height}` : '4 / 5';
};
const yearPartFormatter = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  timeZone: 'Asia/Tokyo',
  calendar: 'gregory'
});
const yearLabel = (year?: string) =>
  year
    ? (yearPartFormatter
        .formatToParts(new Date(`${year}-01-01T00:00:00+09:00`))
        .find((part) => part.type === 'year')?.value ?? year)
    : undefined;
---

<Box className="home-chapter">
  <StatusRow locale={locale} status={await homepageStatus} />
</Box>

<Box
  py={{ base: '8', lg: '16' }}
  borderBottom="1px solid var(--atelier-line)"
  className="home-chapter"
>
  <Stack gap="2" mb="12">
    <SectionHeading label={t('home.bench-heading')} />
    <Text color="var(--atelier-outline)" fontSize="sm" maxW="lg">
      {t('home.bench-subtitle')}
    </Text>
  </Stack>
  <Grid gridTemplateColumns={{ base: 'minmax(0, 1fr)', md: 'repeat(12, minmax(0, 1fr))' }} gap="6">
    <Box
      gridColumn={{ base: 'span 1', md: 'span 7' }}
      position="relative"
      border="1px solid"
      borderColor="var(--atelier-line)"
      bg="var(--atelier-surface-low)"
      p="8"
      className="blocky-shadow-sm"
    >
      <Stack gap="6">
        <Heading as="h3" fontSize={{ base: 'lg', md: 'xl' }}>
          {t('home.bench-manifesto-heading')}{locale === 'ja' ? '' : ' '}
          <Box as="span" color="var(--atelier-accent)" fontStyle="italic"
            >{t('home.bench-manifesto-emphasis')}</Box
          >
        </Heading>
        <Text color="var(--atelier-fg-muted)" lineHeight="relaxed">
          {t('home.bench-manifesto-body')}
        </Text>
        <Flex gap="2" wrap="wrap">
          <Box
            px="3"
            py="1"
            bg="var(--atelier-surface-highest)"
            border="1px solid"
            borderColor="var(--atelier-line)"
            fontFamily="var(--font-code)"
            fontSize="10px"
            textTransform="uppercase">{t('home.bench-principle-clear')}</Box
          >
          <Box
            px="3"
            py="1"
            bg="var(--atelier-surface-highest)"
            border="1px solid"
            borderColor="var(--atelier-line)"
            fontFamily="var(--font-code)"
            fontSize="10px"
            textTransform="uppercase">{t('home.bench-principle-useful')}</Box
          >
          <Box
            px="3"
            py="1"
            bg="var(--atelier-surface-highest)"
            border="1px solid"
            borderColor="var(--atelier-line)"
            fontFamily="var(--font-code)"
            fontSize="10px"
            textTransform="uppercase">{t('home.bench-principle-maintainable')}</Box
          >
        </Flex>
      </Stack>
    </Box>

    <Box
      gridColumn={{ base: 'span 1', md: 'span 5' }}
      position="relative"
      border="1px solid"
      borderColor="var(--atelier-line)"
      bg="var(--atelier-surface-low)"
      p="8"
      className="blocky-shadow-sm"
    >
      <Grid gridTemplateColumns="minmax(0, 1fr) minmax(0, 1fr)" gap="4">
        <Stack borderLeft="2px solid" borderLeftColor="var(--atelier-line)" pl="4" gap="1">
          <Text fontFamily="var(--font-code)" fontSize="10px" color="var(--atelier-outline)"
            >{t('home.bench-tools-frontend')}</Text
          >
          <Text fontFamily="var(--font-body)" fontWeight="bold" fontSize="lg">React / Next.js</Text>
        </Stack>
        <Stack borderLeft="2px solid" borderLeftColor="var(--atelier-line)" pl="4" gap="1">
          <Text fontFamily="var(--font-code)" fontSize="10px" color="var(--atelier-outline)"
            >{t('home.bench-tools-styling')}</Text
          >
          <Text fontFamily="var(--font-body)" fontWeight="bold" fontSize="lg">Tailwind CSS</Text>
        </Stack>
        <Stack borderLeft="2px solid" borderLeftColor="var(--atelier-line)" pl="4" gap="1">
          <Text fontFamily="var(--font-code)" fontSize="10px" color="var(--atelier-outline)"
            >{t('home.bench-tools-design')}</Text
          >
          <Text fontFamily="var(--font-body)" fontWeight="bold" fontSize="lg">Figma / WebGL</Text>
        </Stack>
        <Stack borderLeft="2px solid" borderLeftColor="var(--atelier-line)" pl="4" gap="1">
          <Text fontFamily="var(--font-code)" fontSize="10px" color="var(--atelier-outline)"
            >{t('home.bench-tools-scripting')}</Text
          >
          <Text fontFamily="var(--font-body)" fontWeight="bold" fontSize="lg">Node.js / Python</Text
          >
        </Stack>
      </Grid>
    </Box>
  </Grid>
</Box>

<Box py={{ base: '16', lg: '20' }} className="home-chapter">
  {
    (heroProjects.length > 0 || homeUnavailable) && (
      <Box mb="12">
        <SectionHeading label={t('home.featured-projects')} />
      </Box>
    )
  }
  {
    heroProjects.length > 0 ? (
      <Grid
        gridTemplateColumns={{
          base: 'minmax(0, 1fr)',
          md: 'repeat(2, minmax(0, 1fr))',
          lg: 'repeat(3, minmax(0, 1fr))'
        }}
        gap="0"
        borderTop="1px solid var(--atelier-line)"
        borderLeft="1px solid var(--atelier-line)"
        mb="20"
        className="home-project-grid"
      >
        {heroProjects.map((project) => {
          const imgSrc =
            resolveMedia(project.banner ?? project.media?.[0], 400, import.meta.env.PUBLIC_API_URL)
              ?.src ?? null;
          return (
            <a
              href={`/${locale}/projects/${project.slug}`}
              class="project-card"
              style="display:flex;flex-direction:column;height:100%;border-right:1px solid var(--atelier-line);border-bottom:1px solid var(--atelier-line);overflow:hidden;background:var(--atelier-bg);cursor:pointer;text-decoration:none;color:inherit"
            >
              <Box position="relative" aspectRatio="1 / 1" overflow="hidden" className="group">
                {imgSrc ? (
                  <>
                    <img
                      src={imgSrc}
                      alt=""
                      style="width:100%;height:100%;object-fit:cover;filter:var(--atelier-image-rest);transition:filter 500ms, transform 500ms"
                      class="project-card-img"
                      width="600"
                      height="600"
                      loading="lazy"
                    />
                    <Box
                      position="absolute"
                      inset="0"
                      className="project-card-overlay"
                      style={{ transition: 'opacity 300ms' }}
                    />
                  </>
                ) : (
                  <Box
                    position="relative"
                    w="100%"
                    h="100%"
                    bg="var(--atelier-surface-lowest)"
                    className="fallback-grid-lines"
                  >
                    <Box
                      position="absolute"
                      bottom="-10px"
                      right="0"
                      fontFamily="var(--font-display)"
                      fontStyle="italic"
                      fontSize="140px"
                      lineHeight="1"
                      color="var(--atelier-fg)"
                      opacity="0.05"
                      userSelect="none"
                      pointerEvents="none"
                      aria-hidden="true"
                    >
                      {projectMonogram(project.title)}
                    </Box>
                    <Box
                      position="absolute"
                      bottom="0"
                      left="0"
                      right="0"
                      h="2px"
                      bg="var(--atelier-accent)"
                      opacity="0.3"
                    />
                  </Box>
                )}
              </Box>
              <Box p="6" display="flex" flexDirection="column" flex="1">
                <Flex justify="space-between" align="start" mb="2">
                  <Heading
                    as="h3"
                    fontFamily="var(--font-body)"
                    fontWeight="bold"
                    fontSize={{ base: 'md', md: 'xl' }}
                    fontStyle="normal"
                    textTransform="uppercase"
                    letterSpacing="0"
                  >
                    {project.title}
                  </Heading>
                </Flex>
                <Text color="var(--atelier-fg-muted)" fontSize="sm" lineHeight="1.7" mb="6">
                  {project.description}
                </Text>
                <Flex
                  mt="auto"
                  pt="4"
                  borderTop="1px solid var(--atelier-line)"
                  justify="space-between"
                  align="center"
                  color="var(--atelier-fg-muted)"
                  style={{ marginTop: 'auto', paddingTop: '1rem' }}
                >
                  <Text fontFamily="var(--font-code)" fontSize="10px">
                    {yearLabel(project.date?.slice(0, 4)) ?? t('common.projects')}
                  </Text>
                  <Glyph name="north_east" style={{ fontSize: '14px' }} />
                </Flex>
              </Box>
            </a>
          );
        })}
      </Grid>
    ) : (
      homeUnavailable && (
        <Box
          border="1px solid"
          borderColor="var(--atelier-line)"
          bg="var(--atelier-surface-low)"
          p={{ base: '8', md: '12' }}
          mb="20"
          textAlign="center"
        >
          <Text
            fontFamily="var(--font-code)"
            fontSize="10px"
            textTransform="uppercase"
            letterSpacing="0.15em"
            color="var(--atelier-outline)"
            mb="4"
          >
            {t('project.status-unavailable')}
          </Text>
          <Heading as="h3" fontSize={{ base: 'xl', md: '2xl' }} mb="3">
            {t('home.projects-empty-title')}
          </Heading>
          <Text color="var(--atelier-outline)" fontSize="sm">
            {t('home.projects-empty-description')}
          </Text>
          <a
            href={Astro.url.pathname}
            class="amber-link"
            style="display:inline-flex;align-items:center;min-height:44px;margin-top:0.5rem"
          >
            {t('project.reload')}
          </a>
        </Box>
      )
    )
  }
  <Stack gap="8" className="home-chapter">
    <SectionHeading label={t('home.life-heading')} />
    <Grid gridTemplateColumns={{ base: 'minmax(0, 1fr)', md: 'repeat(2, minmax(0, 1fr))' }} gap="6">
      {
        [
          {
            href: `/${locale}/hobbies/6c2d00b7-dc75-4f45-b286-bf1cbf9e5284`,
            icon: 'photo_camera' as const,
            label: t('home.life-darkroom')
          },
          {
            href: `/${locale}/hobbies`,
            icon: 'category' as const,
            label: t('home.life-skill-toys')
          }
        ].map((entry) => (
          <a
            href={entry.href}
            class="card-hover-amber group"
            style="display:block;border:1px solid var(--atelier-line);background-color:var(--atelier-bg);text-decoration:none;color:inherit"
          >
            <Box
              className="fallback-grid-lines"
              borderBottom="1px solid var(--atelier-line)"
              bg="var(--atelier-surface-lowest)"
              display="grid"
              placeItems="center"
              h="7rem"
            >
              <Glyph name={entry.icon} className="atelier-icon-lg" />
            </Box>
            <Stack gap="3" p="5">
              <Heading as="h3" fontSize="2xl" lineHeight="1.1">
                {entry.label}
              </Heading>
              <Flex
                gap="2"
                alignItems="center"
                color="var(--atelier-accent)"
                fontFamily="var(--font-code)"
                fontSize="10px"
                letterSpacing="0.12em"
                textTransform="uppercase"
              >
                <Text>{t('common.open')}</Text>
                <Glyph name="north_east" />
              </Flex>
            </Stack>
          </a>
        ))
      }
    </Grid>
  </Stack>
  {
    recentPhotos.length > 0 && (
      <Stack gap="8" mt="16" className="home-chapter">
        <SectionHeading label={t('home.photos-heading')} />
        <ul class="home-photos">
          {recentPhotos.map((entry) => (
            <li>
              <a href={entry.url} target="_blank" rel="noopener noreferrer">
                <span class="home-photos-frame" style={`aspect-ratio:${photoRatio(entry)}`}>
                  <img
                    src={`${entry.media[0].url}?format=jpg&name=small`}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                    referrerpolicy="no-referrer"
                    data-kameko-image
                  />
                </span>
                <span class="home-photos-name" lang={photoLang}>
                  {subjectNames(entry).join('、')}
                </span>
                <span class="home-photos-event" lang={photoLang}>
                  {entry.event}
                </span>
                <styled.span srOnly>
                  {t('photos.open-on-x')} {t('note.opens-new-tab')}
                </styled.span>
              </a>
            </li>
          ))}
        </ul>
        <a href={`/${locale}/photos`} class="home-photos-all">
          {t('home.photos-all')}
          <Glyph name="north_east" />
        </a>
      </Stack>
    )
  }
</Box>
