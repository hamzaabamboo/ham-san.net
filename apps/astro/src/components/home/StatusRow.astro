---
import { Stack } from 'styled-system/jsx';
import { Heading } from '~/components/ui/heading';
import { Text } from '~/components/ui/text';
import type { Languages } from '~/i18n/ui';
import { useTranslations } from '~/i18n/utils';

interface Props {
  locale: Languages;
  status: string | null | undefined;
}

const { locale, status } = Astro.props as Props;
const t = useTranslations(locale);
const currentFocus = status === undefined ? t('home.status-phase-title') : status;
---

{
  currentFocus && (
    <Stack
      py={{ base: '5', sm: '8' }}
      gap="3"
      minW="0"
      borderBottom="1px solid var(--atelier-line)"
    >
      <Text
        fontFamily="var(--font-code)"
        fontSize="xs"
        textTransform="uppercase"
        letterSpacing="widest"
        color="var(--atelier-outline)"
      >
        {t('home.status-current-phase')}
      </Text>
      <Heading fontSize={{ base: '2xl', md: '3xl' }}>{currentFocus}</Heading>
    </Stack>
  )
}
