---
import { BrandMark } from '~/components/brand/BrandMark';
import { useTranslations } from '~/i18n/utils';
import { roomCopy } from './room-copy';
import { roomPhaseForTokyoHour } from './room-logic';
import previews from './room-preview.json';

const { locale, tour = false } = Astro.props as { locale: 'en' | 'ja' | 'th'; tour?: boolean };
const Root = tour ? 'div' : 'main';
const t = useTranslations(locale);
const copy = roomCopy[locale];
const hour = Number(
  new Intl.DateTimeFormat('en-US', {
    hour: 'numeric',
    hourCycle: 'h23',
    timeZone: 'Asia/Tokyo'
  }).format(new Date())
);
const phase = roomPhaseForTokyoHour(hour);
const desktopPreview = previews[phase];
const mobilePreview = previews[`${phase}Mobile`];
const destinations = [
  { id: 'projects', label: t('common.projects'), path: 'projects' },
  { id: 'notes', label: t('common.note'), path: 'notes' },
  { id: 'hobbies', label: t('common.hobbies'), path: 'hobbies' },
  { id: 'namecard', label: copy.namecard, path: 'namecard/default' },
  { id: 'events', label: copy.events, path: 'events' },
  { id: 'photos', label: t('common.photos'), path: 'photos' }
];
---

<Root
  class:list={['room-home', tour && 'room-tour']}
  data-room-home
  data-room-tour={tour ? '' : undefined}
  data-locale={locale}
  data-room-error={copy.failed}
  data-room-loading={copy.loading}
  data-room-mobile-controls={copy.mobileControls}
  data-room-blocked={copy.blocked}
  data-room-motion-on={t('home.motion-on')}
  data-room-motion-off={t('home.motion-off')}
  data-room-phase={phase}
>
  <div class="room-static-preview" data-room-preview aria-hidden="true">
    <picture>
      {tour && <source media="(max-width: 1100px)" srcset={mobilePreview.poster} />}
      <img
        src={tour ? desktopPreview.poster : '/models/room-preview.webp'}
        alt=""
        width="1600"
        height="1000"
        fetchpriority="high"
      />
    </picture>
    {
      tour && (
        <video
          data-room-preview-video
          data-desktop-src={desktopPreview.video}
          data-mobile-src={mobilePreview.video}
          muted
          playsinline
          loop
          preload="auto"
          aria-hidden="true"
        />
      )
    }
  </div>
  <div class="room-stage" data-room-stage></div>
  <header class="room-header">
    <a class="room-brand" href={`/${locale}`} aria-label={t('common.name')}><BrandMark /></a>
    <button type="button" class="room-exit" data-room-exit hidden>{copy.exit}</button>
    <p class="room-time" data-city-first={copy.tokyoFirst ? 'true' : undefined}>
      <span data-room-time></span>
      <span class="room-city">{copy.tokyo}</span>
    </p>
    <nav class="room-languages" aria-label={t('common.language')}>
      {
        (['en', 'ja', 'th'] as const).map((lang) => (
          <a
            href={`/${lang}/room`}
            lang={lang}
            hreflang={lang}
            aria-current={lang === locale ? 'page' : undefined}
          >
            {lang.toUpperCase()}
          </a>
        ))
      }
    </nav>
  </header>
  {
    tour ? (
      <div class="room-tour-status" data-room-entry>
        <p class="room-status" data-room-status role="status" />
      </div>
    ) : (
      <section class="room-entry" data-room-entry>
        <h1>{copy.title}</h1>
        <p>{copy.intro}</p>
        <button class="room-enter" data-room-enter>
          {copy.enter}
        </button>
        <p class="room-status" data-room-status role="status" />
        <a class="room-text-link" href={`/${locale}`}>
          {copy.conventional} ↗
        </a>
      </section>
    )
  }
  {
    tour && (
      <>
        <div class="room-tour-viewport" data-room-tour-viewport aria-hidden="true" />
        <div class="room-tour-content">
          <slot />
        </div>
      </>
    )
  }
  {
    tour && (
      <div class="room-tour-position">
        <span data-tour-number aria-hidden="true">
          01
        </span>
        <span class="room-tour-track" aria-hidden="true">
          <span data-tour-track />
        </span>
        <span data-tour-caption aria-hidden="true" />
        <button type="button" data-room-motion aria-pressed="false">
          {t('home.motion-off')}
        </button>
      </div>
    )
  }
  <div class="room-reticle" data-room-reticle hidden aria-hidden="true"></div>
  <div class="room-target-labels" data-room-target-labels hidden></div>
  <div class="room-hint" data-room-hint hidden aria-live="polite"></div>
  <footer class="room-controls">
    <p class="room-help" id="room-help" data-room-help data-room-desktop-controls={copy.controls}>
      {copy.controls}
    </p>
    <div class="room-controls-row">
      <nav class="room-destinations" aria-label={copy.destinations}>
        {
          destinations.map((item) => (
            <a href={`/${locale}/${item.path}`} data-room-destination={item.id}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="room-toolbar" data-room-light-control hidden>
        <div class="room-toolbar-group" role="group" aria-label={copy.light}>
          <button type="button" data-room-light-toggle aria-pressed="false">{copy.light}</button>
          <button
            type="button"
            data-room-light-left
            aria-pressed="false"
            aria-label={copy.lightLeft}>{copy.left}</button
          >
          <button
            type="button"
            data-room-light-right
            aria-pressed="false"
            aria-label={copy.lightRight}>{copy.right}</button
          >
          <button type="button" class="room-toolbar-reset" data-room-light-auto hidden
            >{copy.lightAuto}</button
          >
        </div>
        <div class="room-toolbar-group">
          <button type="button" data-room-curtains aria-pressed="false">{copy.curtains}</button>
          <button type="button" class="room-toolbar-reset" data-room-curtains-auto hidden
            >{copy.curtainsAuto}</button
          >
          <button type="button" data-room-closet hidden aria-pressed="false">{copy.closet}</button>
          <button type="button" data-room-lie-down hidden aria-pressed="false"
            >{copy.lieDown}</button
          >
        </div>
      </div>
    </div>
  </footer>
  <section class="room-play" data-room-play hidden>
    <p class="room-play-title" data-room-play-title></p>
    <p class="room-play-intro" data-room-play-intro></p>
    <p class="room-play-stats" data-room-play-stats></p>
    <div class="room-play-controls" data-room-play-controls></div>
    <div class="room-play-actions">
      <button type="button" data-room-play-page>{copy.play.openPage}</button>
      <button type="button" data-room-play-exit>{copy.play.exit}</button>
    </div>
  </section>
  <dialog class="room-panel" data-room-panel aria-labelledby="room-panel-title">
    <header class="room-panel-header">
      <h2 id="room-panel-title"></h2>
      <a data-room-full-page href={`/${locale}`}>{copy.fullPage} ↗</a>
      <button data-room-close aria-label={copy.close}>×</button>
    </header>
    <nav class="room-panel-tabs" data-room-tabs aria-label={copy.related}></nav>
    <p class="room-panel-status" data-room-panel-status role="status">{copy.loadingDescription}</p>
    <iframe data-room-frame title={copy.content} referrerpolicy="same-origin"></iframe>
  </dialog>
</Root>

<script>
  type RoomHomeLifecycle = { root?: HTMLElement; dispose?: () => void };
  const windowWithRoom = window as Window & { __roomHomeLifecycle?: RoomHomeLifecycle };
  const lifecycle = windowWithRoom.__roomHomeLifecycle ?? {};
  windowWithRoom.__roomHomeLifecycle = lifecycle;
  const mount = () => {
    const root = document.querySelector<HTMLElement>('[data-room-home]');
    if (!root || lifecycle.root === root) return;
    lifecycle.dispose?.();
    const enterButton = root.querySelector<HTMLButtonElement>('[data-room-enter]');
    const status = root.querySelector<HTMLElement>('[data-room-status]');
    const timeElement = root.querySelector<HTMLElement>('[data-room-time]');
    if (!enterButton || !status) return;
    lifecycle.root = root;
    let disposed = false;
    let runtimeDispose: (() => void) | undefined;
    const updateClock = () => {
      if (!timeElement) return;
      const locale =
        root.dataset.locale === 'ja' ? 'ja-JP' : root.dataset.locale === 'th' ? 'th-TH' : 'en-GB';
      timeElement.textContent = new Intl.DateTimeFormat(locale, {
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
        timeZone: 'Asia/Tokyo'
      }).format(new Date());
    };
    updateClock();
    const clockTimer = window.setInterval(updateClock, 30_000);
    const onEnter = async () => {
      if (disposed || runtimeDispose || enterButton.disabled) return;
      enterButton.disabled = true;
      status.textContent = root.dataset.roomLoading ?? '';
      window.clearInterval(clockTimer);
      try {
        const { initRoom } = await import('./room-runtime');
        if (disposed || !root.isConnected) return;
        runtimeDispose = initRoom(root, true);
      } catch {
        status.textContent = root.dataset.roomError ?? '';
        status.dataset.roomStatusError = '';
        enterButton.hidden = true;
      }
    };
    if (root.hasAttribute('data-room-tour')) {
      const sections = Array.from(root.querySelectorAll<HTMLElement>('[data-tour-stop]'));
      const stops = sections.map((section) => {
        try {
          if (section.dataset.tourPose) return JSON.parse(section.dataset.tourPose);
        } catch {}
        return section.dataset.tourStop ?? 'entry';
      });
      const reducedMedia = window.matchMedia('(prefers-reduced-motion: reduce)');
      const previewVideo = root.querySelector<HTMLVideoElement>('[data-room-preview-video]');
      const previewMedia = window.matchMedia('(max-width: 1100px)');
      const connection = (
        navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }
      ).connection;
      const previewAllowed =
        !connection?.saveData && !/(^|-)2g$/.test(connection?.effectiveType ?? '');
      let motionPreference: string | null = null;
      try {
        motionPreference = localStorage.getItem('room-motion');
      } catch {}
      let motionEnabled = motionPreference ? motionPreference === 'on' : !reducedMedia.matches;
      const motionButton = root.querySelector<HTMLButtonElement>('[data-room-motion]');
      const updateMotion = () => {
        root.dataset.roomMotion = motionEnabled ? 'on' : 'off';
        if (previewVideo) {
          if (motionEnabled && previewAllowed && !root.hasAttribute('data-room-revealed'))
            void previewVideo.play().catch(() => undefined);
          else previewVideo.pause();
        }
        if (!motionButton) return;
        motionButton.setAttribute('aria-pressed', String(motionEnabled));
        motionButton.setAttribute(
          'aria-label',
          motionEnabled ? (root.dataset.roomMotionOn ?? '') : (root.dataset.roomMotionOff ?? '')
        );
        motionButton.textContent = motionEnabled
          ? (root.dataset.roomMotionOn ?? '')
          : (root.dataset.roomMotionOff ?? '');
      };
      const configurePreview = () => {
        if (!previewVideo || !previewAllowed || root.hasAttribute('data-room-revealed')) return;
        previewVideo.src =
          (previewMedia.matches
            ? previewVideo.dataset.mobileSrc
            : previewVideo.dataset.desktopSrc) ?? '';
        updateMotion();
      };
      const onPreviewData = () => root.setAttribute('data-room-preview-playing', '');
      previewVideo?.addEventListener('loadeddata', onPreviewData);
      previewMedia.addEventListener('change', configurePreview);
      configurePreview();
      const onMotion = () => {
        motionEnabled = !motionEnabled;
        motionPreference = motionEnabled ? 'on' : 'off';
        try {
          localStorage.setItem('room-motion', motionPreference);
        } catch {}
        updateMotion();
      };
      const onMotionPreference = () => {
        if (motionPreference) return;
        motionEnabled = !reducedMedia.matches;
        updateMotion();
      };
      motionButton?.addEventListener('click', onMotion);
      reducedMedia.addEventListener('change', onMotionPreference);
      updateMotion();
      let anchors: number[] = [];
      let exact = 0;
      let smooth = 0;
      let last = 0;
      let active = -1;
      const number = root.querySelector<HTMLElement>('[data-tour-number]');
      const caption = root.querySelector<HTMLElement>('[data-tour-caption]');
      const track = root.querySelector<HTMLElement>('[data-tour-track]');
      const measure = () => {
        const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const inset = previewMedia.matches
          ? (root.querySelector<HTMLElement>('[data-room-tour-viewport]')?.offsetHeight ?? 0)
          : 0;
        anchors = sections.map((section, index) => {
          if (index === 0) return 0;
          const top = section.getBoundingClientRect().top + window.scrollY;
          return Math.min(
            max,
            Math.max(
              0,
              inset ? top - inset : top + section.offsetHeight * 0.5 - window.innerHeight * 0.5
            )
          );
        });
        for (let index = 1; index < anchors.length; index += 1) {
          anchors[index] = Math.max(anchors[index], anchors[index - 1] + 1);
        }
        read();
      };
      const read = () => {
        const y = window.scrollY;
        let value = anchors.length - 1;
        for (let index = 0; index < anchors.length - 1; index += 1) {
          if (y <= anchors[index + 1]) {
            const span = Math.max(1, anchors[index + 1] - anchors[index]);
            const portion = Math.min(1, Math.max(0, (y - anchors[index]) / span));
            value = index + (previewMedia.matches ? Math.max(0, (portion - 0.55) / 0.45) : portion);
            break;
          }
        }
        exact = value;
        if (track) track.style.transform = `scaleX(${(exact + 1) / sections.length})`;
        const index = Math.round(exact);
        if (index !== active) {
          active = index;
          if (number) number.textContent = String(index + 1).padStart(2, '0');
          if (caption)
            caption.textContent =
              sections[index]?.querySelector('h1, h2')?.textContent?.trim() ?? '';
          sections.forEach((section, sectionIndex) =>
            section.toggleAttribute('data-tour-active', sectionIndex === index)
          );
        }
      };
      const progress = () => {
        const now = performance.now();
        const dt = last ? Math.min((now - last) / 1000, 1 / 30) : 1 / 60;
        last = now;
        smooth = !motionEnabled ? exact : smooth + (exact - smooth) * (1 - Math.exp(-9.2 * dt));
        if (Math.abs(smooth - exact) < 0.0005) smooth = exact;
        return smooth;
      };
      const observer = new ResizeObserver(measure);
      sections.forEach((section) => observer.observe(section));
      window.addEventListener('scroll', read, { passive: true });
      measure();
      smooth = exact;
      root.dataset.tourConductor = '';
      const enterButtons = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-room-enter]')
      );
      const environment = navigator as Navigator & {
        connection?: { saveData?: boolean; effectiveType?: string };
        deviceMemory?: number;
      };
      const coarse = window.matchMedia('(pointer: coarse)').matches;
      const constrained =
        environment.connection?.saveData === true ||
        /(^|-)2g$/.test(environment.connection?.effectiveType ?? '');
      const automatic =
        !constrained &&
        (!coarse ||
          ((environment.connection?.effectiveType ?? '4g') === '4g' &&
            (environment.deviceMemory ?? 4) >= 4));
      let starting = false;
      let entrySource: HTMLElement | null = null;
      const start = async (enterWhenReady: boolean) => {
        if (disposed) return;
        if (!root.hasAttribute('data-room-tour-ready')) {
          status.textContent = root.dataset.roomLoading ?? '';
          if (enterWhenReady) enterButtons.forEach((button) => (button.disabled = true));
        }
        if (runtimeDispose || starting) return;
        starting = true;
        try {
          const { initRoom } = await import('./room-runtime');
          if (disposed || !root.isConnected) return;
          runtimeDispose = initRoom(root, enterWhenReady, {
            stops: stops as never,
            progress,
            reducedMotion: () => !motionEnabled,
            entrySource: () => entrySource
          });
        } catch {
          status.textContent = root.dataset.roomError ?? '';
          enterButtons.forEach((button) => {
            button.hidden = true;
          });
        }
      };
      const onDemand = (event: Event) => {
        entrySource = event.currentTarget instanceof HTMLElement ? event.currentTarget : null;
        void start(true);
      };
      enterButtons.forEach((button) => {
        button.disabled = false;
        button.addEventListener('click', onDemand);
      });
      if (automatic) {
        void start(false);
      }
      lifecycle.dispose = () => {
        if (disposed) return;
        disposed = true;
        window.clearInterval(clockTimer);
        enterButtons.forEach((button) => button.removeEventListener('click', onDemand));
        observer.disconnect();
        motionButton?.removeEventListener('click', onMotion);
        reducedMedia.removeEventListener('change', onMotionPreference);
        previewVideo?.pause();
        previewVideo?.removeEventListener('loadeddata', onPreviewData);
        previewMedia.removeEventListener('change', configurePreview);
        window.removeEventListener('scroll', read);
        runtimeDispose?.();
      };
      return;
    }
    enterButton.addEventListener('click', onEnter);
    lifecycle.dispose = () => {
      if (disposed) return;
      disposed = true;
      window.clearInterval(clockTimer);
      enterButton.removeEventListener('click', onEnter);
      runtimeDispose?.();
    };
  };
  const unmount = () => {
    lifecycle.dispose?.();
    lifecycle.root = undefined;
    lifecycle.dispose = undefined;
  };
  document.addEventListener('astro:before-swap', unmount);
  document.addEventListener('astro:page-load', mount);
  mount();
</script>

<style>
  .room-home {
    --room-inset: 2rem;
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: var(--atelier-bg);
    color: var(--atelier-fg);
  }
  .room-static-preview {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--atelier-bg);
  }
  .room-static-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: var(--atelier-image-preview);
  }
  .room-static-preview picture {
    display: block;
    height: 100%;
  }
  .room-stage {
    position: absolute;
    inset: 0;
    z-index: 1;
    touch-action: none;
    transition: filter 260ms ease;
  }
  .room-stage :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .room-stage :global(canvas:focus-visible) {
    outline: 2px solid var(--atelier-accent);
    outline-offset: -2px;
  }
  .room-header {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem var(--room-inset);
    background: linear-gradient(
      color-mix(in srgb, var(--atelier-bg) 80%, transparent),
      transparent
    );
    pointer-events: none;
  }
  .room-header a,
  .room-header button {
    pointer-events: auto;
  }
  .room-exit {
    min-height: 44px;
    margin-left: auto;
    padding: 0 1rem;
    color: var(--atelier-fg);
    font-size: 0.85rem;
    background: color-mix(in srgb, var(--atelier-bg) 82%, transparent);
    border: 1px solid var(--atelier-line);
  }
  .room-exit:hover {
    border-color: var(--atelier-fg-muted);
  }
  .room-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--atelier-fg);
    text-decoration: none;
    text-shadow: 0 1px 8px var(--atelier-bg);
  }
  .room-time,
  .room-languages {
    font-size: 0.8rem;
  }
  .room-time {
    display: inline-flex;
    gap: 0.35em;
    margin: 0 0 0 auto;
    color: var(--atelier-fg);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    text-shadow: 0 1px 8px var(--atelier-bg);
  }
  .room-time[data-city-first] .room-city {
    order: -1;
  }
  .room-exit:not([hidden]) + .room-time {
    margin-left: 0;
  }
  .room-languages {
    display: flex;
    gap: 0.25rem;
  }
  .room-languages a {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--atelier-fg);
    text-decoration: none;
    text-shadow: 0 1px 8px var(--atelier-bg);
  }
  .room-languages a[aria-current] {
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }
  .room-entry {
    position: relative;
    z-index: 2;
    width: min(26rem, calc(100% - 3rem));
    margin: clamp(3rem, 15svh, 10rem) 0 12rem var(--room-inset);
    padding: 2rem;
    background: color-mix(in srgb, var(--atelier-bg) 88%, transparent);
    border: 1px solid var(--atelier-line);
    backdrop-filter: blur(12px);
  }
  .room-eyebrow {
    font-family: var(--font-code);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--atelier-accent-soft);
  }
  .room-entry h1 {
    margin: 0.8rem 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 4rem);
    line-height: 1.05;
  }
  .room-entry > p:not(.room-eyebrow) {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--atelier-fg-muted);
  }
  .room-entry > .room-status[data-room-status-error] {
    margin-top: 1.5rem;
    padding-top: 1rem;
    color: var(--atelier-fg);
    border-top: 1px solid var(--atelier-line);
  }
  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }
  button {
    cursor: pointer;
  }
  button:focus-visible,
  a:focus-visible {
    outline: 2px solid var(--atelier-accent);
    outline-offset: 4px;
  }
  .room-enter {
    margin: 1.5rem 0 0.8rem;
    padding: 0.8rem 1.3rem;
    background: var(--atelier-accent);
    color: var(--atelier-bg);
    font-weight: 700;
    min-height: 44px;
  }
  .room-enter:disabled {
    opacity: 0.5;
    cursor: progress;
  }
  .room-enter:hover:not(:disabled) {
    background: var(--atelier-accent-soft);
  }
  .room-text-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 0.4rem;
    font-size: 0.8rem;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .room-controls {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    padding: 3rem var(--room-inset) 1.25rem;
    background: linear-gradient(
      transparent,
      color-mix(in srgb, var(--atelier-bg) 85%, transparent)
    );
    pointer-events: none;
  }
  .room-controls a,
  .room-controls button {
    pointer-events: auto;
  }
  .room-help {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    color: var(--atelier-fg-muted);
    text-shadow: 0 1px 6px var(--atelier-bg);
  }
  .room-home:not([data-room-entered]) .room-help {
    display: none;
  }
  .room-controls-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }
  .room-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
