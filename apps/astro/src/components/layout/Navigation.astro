---
import { languages } from '~/i18n/ui';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import { localizePath } from '~/i18n/path';
import { BrandMark } from '~/components/brand/BrandMark';
import { Sidebar } from './Sidebar';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const embeddedRoomPage = Astro.url.searchParams.get('roomEmbed') === '1';

const getURLWithLanguage = (value: string) => {
  return `/${lang}${value}`;
};

const getCurrentURLWithLanguage = (language: string) => {
  return localizePath(Astro.url.pathname, language, Astro.url.search);
};

const NAVIGATION_LINKS = [
  { label: t('common.projects'), value: '/projects' },
  { label: t('common.note'), value: '/notes' },
  { label: t('common.hobbies'), value: '/hobbies' },
  { label: t('common.event'), value: '/events' },
  { label: t('common.photos'), value: '/photos' },
  { label: t('common.room'), value: '/room' },
  { label: t('common.about-me'), value: '/about' },
  { label: t('common.contact'), value: '/contact' }
];
---

<script>
  let ticking = false;
  const updateNav = () => {
    ticking = false;
    const nav = document.getElementById('main-nav');
    if (!nav) return;
    nav.classList.toggle('scrolled', window.scrollY > 50);
  };
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(updateNav);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('astro:page-load', updateNav);
  updateNav();
</script>

<nav id="main-nav" class="shell-nav" aria-label={t('common.primary-nav')}>
  <a href={getURLWithLanguage('/')} class="shell-nav-brand">
    <BrandMark />
  </a>

  <div class="shell-nav-links">
    {
      NAVIGATION_LINKS.map(({ label, value }) => {
        const fullPath = getURLWithLanguage(value);
        const isCurrent =
          value === '/' ? Astro.url.pathname === fullPath : Astro.url.pathname.startsWith(fullPath);

        return (
          <a href={fullPath} class="shell-nav-link" aria-current={isCurrent ? 'page' : undefined}>
            {label}
          </a>
        );
      })
    }
  </div>

  <div class="shell-nav-actions">
    <div class="shell-nav-lang-group">
      {
        Object.entries(languages)
          .filter((entry) => entry[0] !== lang)
          .map((entry) => (
            <a href={getCurrentURLWithLanguage(entry[0])} class="shell-nav-lang">
              {entry[0]}
            </a>
          ))
      }
    </div>
    {
      !embeddedRoomPage && (
        <Sidebar
          links={NAVIGATION_LINKS}
          locale={lang}
          locales={Object.keys(languages)}
          labels={{
            menu: t('common.menu'),
            menuOpen: t('common.menu-open'),
            menuClose: t('common.menu-close'),
            language: t('common.language')
          }}
          pathname={Astro.url.pathname}
          search={Astro.url.search}
          client:visible
        />
      )
    }
  </div>
</nav>
