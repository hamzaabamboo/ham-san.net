---
import { getLangFromUrl, useTranslations } from '~/i18n/utils';

const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);
---

<footer class="shell-footer">
  <div style="font-size:0.8125rem;color:var(--atelier-fg-muted)">
    {t('common.copyright')}
  </div>
  <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;justify-content:center">
    <a
      target="_blank"
      rel="noreferrer"
      href="https://github.com/hamzaabamboo/ham-san.net"
      style="font-size:0.8125rem;color:var(--atelier-fg-muted);text-decoration:none;transition:color 0.15s ease;padding:0.75rem"
      class="shell-footer-link"
    >
      GitHub
    </a>
    <a
      target="_blank"
      rel="noreferrer"
      href="https://www.linkedin.com/in/tvittayapalotai/"
      style="font-size:0.8125rem;color:var(--atelier-fg-muted);text-decoration:none;transition:color 0.15s ease;padding:0.75rem"
      class="shell-footer-link"
    >
      LinkedIn
    </a>
    <a
      href={`/${locale}/rss.xml`}
      style="font-size:0.8125rem;color:var(--atelier-fg-muted);text-decoration:none;transition:color 0.15s ease;padding:0.75rem"
      class="shell-footer-link"
    >
      RSS
    </a>
    <a
      href={`/${locale}/sitemap.xml`}
      style="font-size:0.8125rem;color:var(--atelier-fg-muted);text-decoration:none;transition:color 0.15s ease;padding:0.75rem"
      class="shell-footer-link"
    >
      Sitemap
    </a>
  </div>
</footer>
