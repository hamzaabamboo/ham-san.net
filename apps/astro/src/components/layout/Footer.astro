---
import { getLangFromUrl, useTranslations } from '~/i18n/utils';

const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);
---

<footer class="shell-footer">
  <div class="shell-footer-copy">{t('common.copyright')}</div>
  <div class="shell-footer-links">
    <a
      target="_blank"
      rel="noreferrer"
      href="https://github.com/hamzaabamboo/ham-san.net"
      class="shell-footer-link"
    >
      GitHub
      <span class="shell-footer-sr">{t('note.opens-new-tab')}</span>
    </a>
    <a
      target="_blank"
      rel="noreferrer"
      href="https://www.linkedin.com/in/tvittayapalotai/"
      class="shell-footer-link"
    >
      LinkedIn
      <span class="shell-footer-sr">{t('note.opens-new-tab')}</span>
    </a>
    <a href={`/${locale}/rss.xml`} class="shell-footer-link"> RSS </a>
    <a href={`/${locale}/sitemap.xml`} class="shell-footer-link"> {t('common.sitemap')} </a>
  </div>
</footer>
