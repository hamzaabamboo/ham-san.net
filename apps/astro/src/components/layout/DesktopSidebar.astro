---
import { Glyph, type GlyphName } from '~/components/ui/glyph';
import { getLangFromUrl, useTranslations } from '~/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const getURLWithLanguage = (value: string) => {
  return `/${lang}${value}`;
};

const SIDEBAR_LINKS = [
  { label: t('common.projects'), value: '/projects', icon: 'work' },
  { label: t('common.note'), value: '/notes', icon: 'description' },
  { label: t('common.hobbies'), value: '/hobbies', icon: 'photo_camera' },
  { label: t('common.event'), value: '/events', icon: 'event' },
  { label: t('common.photos'), value: '/photos', icon: 'photo_library' },
  { label: t('common.room'), value: '/room', icon: 'weekend' },
  { label: t('common.about-me'), value: '/about', icon: 'person' },
  { label: t('common.contact'), value: '/contact', icon: 'mail' }
] satisfies { label: string; value: string; icon: GlyphName }[];
---

<aside class="shell-sidebar">
  <nav class="shell-sidebar-nav" aria-label={t('common.menu')}>
    {
      SIDEBAR_LINKS.map(({ label, value, icon }) => {
        const fullPath = getURLWithLanguage(value);
        const isCurrent =
          value === '/' ? Astro.url.pathname === fullPath : Astro.url.pathname.startsWith(fullPath);

        return (
          <a
            href={fullPath}
            class="shell-sidebar-link"
            aria-current={isCurrent ? 'page' : undefined}
          >
            <Glyph name={icon} className="shell-sidebar-link-icon" />
            <span class="shell-sidebar-link-label">{label}</span>
          </a>
        );
      })
    }
  </nav>
</aside>
